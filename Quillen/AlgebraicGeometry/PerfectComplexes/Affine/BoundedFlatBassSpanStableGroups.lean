module

public import Quillen.AlgebraicGeometry.PerfectComplexes.Affine.SectionBassEvaluationTopology
public import Quillen.Topology.Prespectrum.PushoutStableGeneration
public import Quillen.Topology.Prespectrum.PushoutLinearExcision
public import Quillen.Topology.Prespectrum.PositiveLevelEquivalence
public import Quillen.Waldhausen.SConstruction.Iterated.ConeFiberExcision
public import Quillen.Waldhausen.SConstruction.Iterated.StableHomotopy

/-!
# Stable groups of the original bounded-flat polynomial span

The unchanged two-leg polynomial span has zero negative stable groups and its degree-zero group
is generated by the two literal inclusions. Original S-model growth and genuine chosen-point HEP
discharge all row excision and collapse assumptions. The same finite bound gives actual excision
for the unchanged raw Bass comparison to the Laurent model.
-/
@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
open CategoryTheory AlgebraicGeometry Quillen.LoopPrespectrum Quillen.Waldhausen.IteratedS
open Quillen.Scheme.PolynomialLaurent
universe u
namespace Quillen.PerfectComplexes
variable (R : CommRingCat.{u})

/-- Every actual point of the raw polynomial span retains the common original S-model bound. -/
theorem boundedFlatBassSpan_homotopyGroup_subsingleton_at (n k : ℕ) (hk : k < n + 2)
    (x : (HomotopyPushout.prespectrum
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))).space (n + 2)) :
    Subsingleton (HomotopyGroup.Pi k ((HomotopyPushout.prespectrum
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))).space (n + 2)) x) := by
  apply HomotopyPushout.homotopyGroup_subsingleton _ _ (n + 2) n
    (originalPrespectrum_point_homotopyExtensionProperty
      (boundedFlatPerfectWaldhausen (Spec R)) (n + 2))
    (originalPrespectrum_point_homotopyExtensionProperty
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 2))
    (originalPrespectrum_point_homotopyExtensionProperty
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 2))
    (fun a j hj => originalPrespectrum_positiveLevel_homotopyGroup_subsingleton_at
      (boundedFlatPerfectWaldhausen (Spec R)) (n + 1) j (by omega) a)
    (fun b j hj => originalPrespectrum_positiveLevel_homotopyGroup_subsingleton_at
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 1) j (by omega) b)
    (fun c j hj => originalPrespectrum_positiveLevel_homotopyGroup_subsingleton_at
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 1) j (by omega) c)
    x k hk

/-- The literal right-inclusion cone of the raw polynomial span satisfies genuine stable excision.
-/
theorem boundedFlatBassSpan_inr_coneFiber_isStableEquivalence :
    IsStableEquivalence (mappingConeFiberComparison (HomotopyPushout.inr
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R)))) :=
  HomotopyPushout.inr_coneFiber_isStableEquivalence_of_linearGrowth _ _ 0
    (fun n => originalPrespectrum_point_homotopyExtensionProperty
      (boundedFlatPerfectWaldhausen (Spec R)) (n + 2))
    (fun n => originalPrespectrum_point_homotopyExtensionProperty
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 2))
    (fun n => originalPrespectrum_point_homotopyExtensionProperty
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 2))
    (fun n a k hk => originalPrespectrum_positiveLevel_homotopyGroup_subsingleton_at
      (boundedFlatPerfectWaldhausen (Spec R)) (n + 1) k (by omega) a)
    (fun n b k hk => originalPrespectrum_positiveLevel_homotopyGroup_subsingleton_at
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 1) k (by omega) b)
    (fun n c k hk => originalPrespectrum_positiveLevel_homotopyGroup_subsingleton_at
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 1) k (by omega) c)

/-- The unchanged right-cone collapse is a stable equivalence at all signed degrees. -/
theorem boundedFlatBassSpan_rightConeCollapse_isStableEquivalence :
    IsStableEquivalence (HomotopyPushout.rightConeCollapse
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))) :=
  isStableEquivalence_of_positiveLevel _ (fun n =>
    HomotopyPushout.rightConeCollapse_level_isWeakHomotopyEquivalence _ _ (n + 1)
      (originalPrespectrum_point_homotopyExtensionProperty
        (boundedFlatPerfectWaldhausen (Spec R)) (n + 1))
      (originalPrespectrum_point_homotopyExtensionProperty
        (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 1))
      (originalPrespectrum_point_homotopyExtensionProperty
        (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) (n + 1)))

/-- Every degree-zero class is a sum along the two original, unchanged polynomial inclusions. -/
theorem boundedFlatBassSpan_stable_zero_generate
    (z : stableHomotopyGroup (HomotopyPushout.prespectrum
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))) 0) :
    ∃ x : stableHomotopyGroup (originalPrespectrum
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R))))) 0,
    ∃ y : stableHomotopyGroup (originalPrespectrum
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R))))) 0,
      (stableHomotopyFunctor 0).map (HomotopyPushout.inl
        (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
        (boundedFlatPerfectPrespectrumMap (polynomialProjection R))) x +
      (stableHomotopyFunctor 0).map (HomotopyPushout.inr
        (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
        (boundedFlatPerfectPrespectrumMap (polynomialProjection R))) y = z := by
  exact HomotopyPushout.stable_inclusions_generate
    (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
    (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
    (originalPrespectrum_mappingConeFiberComparison_isStableEquivalence
      (boundedFlatPerfectWaldhausen (Spec R))
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R))))
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R)))
    (boundedFlatBassSpan_inr_coneFiber_isStableEquivalence R)
    (boundedFlatBassSpan_rightConeCollapse_isStableEquivalence R) 0
    (originalStableHomotopyGroup_neg_subsingleton
      (boundedFlatPerfectWaldhausen (Spec R)) (0 - 1) (by omega)) z

/-- The actual raw polynomial span has zero stable groups in every negative degree. -/
theorem boundedFlatBassSpan_stable_neg_subsingleton (d : ℤ) (hd : d < 0) :
    Subsingleton (stableHomotopyGroup (HomotopyPushout.prespectrum
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R))) d) :=
  HomotopyPushout.stableHomotopyGroup_subsingleton_of_corner_groups
    (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
    (boundedFlatPerfectPrespectrumMap (polynomialProjection R))
    (originalPrespectrum_mappingConeFiberComparison_isStableEquivalence
      (boundedFlatPerfectWaldhausen (Spec R))
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R))))
      (boundedFlatPerfectPrespectrumMap (polynomialProjection R)))
    (boundedFlatBassSpan_inr_coneFiber_isStableEquivalence R)
    (boundedFlatBassSpan_rightConeCollapse_isStableEquivalence R) d
    (originalStableHomotopyGroup_neg_subsingleton
      (boundedFlatPerfectWaldhausen (Spec R)) (d - 1) (by omega))
    (originalStableHomotopyGroup_neg_subsingleton
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) d hd)
    (originalStableHomotopyGroup_neg_subsingleton
      (boundedFlatPerfectWaldhausen (Spec (.of (Polynomial R)))) d hd)

/-- Genuine stable excision holds for the unchanged raw polynomial-to-Laurent Bass comparison. -/
theorem boundedFlatBassSquareComparison_coneFiber_isStableEquivalence :
    IsStableEquivalence (mappingConeFiberComparison (boundedFlatBassSquareComparison R)) :=
  mappingConeFiberComparison_isStableEquivalence_of_linearGrowth _ 0
    (fun n => boundedFlatBassSpan_point_homotopyExtensionProperty R (n + 2))
    (fun n => originalPrespectrum_point_homotopyExtensionProperty
      (boundedFlatPerfectWaldhausen (Spec (.of (LaurentPolynomial R)))) (n + 2))
    (fun n x k hk => boundedFlatBassSpan_homotopyGroup_subsingleton_at R n k hk x)
    (fun n x k hk => originalPrespectrum_positiveLevel_homotopyGroup_subsingleton_at
      (boundedFlatPerfectWaldhausen (Spec (.of (LaurentPolynomial R)))) (n + 1) k (by omega) x)

end Quillen.PerfectComplexes
