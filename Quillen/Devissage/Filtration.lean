module

public import Quillen.KTheory.GrothendieckGroup.Map
public import Mathlib.Algebra.BigOperators.Group.List.Basic

/-!
# Finite admissible filtrations and algebraic Grothendieck classes

A `Filtration E P X` is a finite extension tower ending at `X`, starting at an
actual zero object, whose successive factors satisfy `P`. Each extension is
recorded by a conflation, including its actual maps and kernel–cokernel evidence.
Thus this is a recursive presentation of a finite admissible filtration with
chosen successive quotients, rather than a hypothesis about object classes.

The class of a filtered object is the sum of the classes of its factors. In
particular, it belongs to the subgroup generated by classes of objects satisfying
`P`. These are algebraic prerequisites for dévissage; no homotopical dévissage,
localization theorem, or comparison with Quillen `K₀` is asserted here.
-/
@[expose] public section


noncomputable section

universe v u w

open CategoryTheory CategoryTheory.Limits

namespace Quillen.ExactStructure

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasFiniteBiproducts C]
  (E : ExactStructure C)

/-- A finite admissible filtration with chosen successive factors satisfying `P`.
The base may be any zero object, so there is no dependence on a particular choice
of zero object. In a step the previous filtered object is the first object of a
conflation and the new final object is its middle object. -/
inductive Filtration (P : C → Prop) : C → Type (max u v)
  | zero {X : C} (hX : IsZero X) : Filtration P X
  | step (S : ShortComplex C) (hS : E.conflation S)
      (previous : Filtration P S.X₁) (factor_mem : P S.X₃) : Filtration P S.X₂

variable {E} {P : C → Prop}

namespace Filtration

/-- The successive factors, listed from the zero object towards the final object. -/
def factors {X : C} : E.Filtration P X → List C
  | .zero _ => []
  | .step S _ previous _ => previous.factors ++ [S.X₃]

/-- The number of conflations in this finite extension tower. -/
def length {X : C} (F : E.Filtration P X) : ℕ := F.factors.length

@[simp] lemma factors_zero {X : C} (hX : IsZero X) :
    (Filtration.zero (E := E) (P := P) hX).factors = [] := rfl

@[simp] lemma factors_step (S : ShortComplex C) (hS : E.conflation S)
    (previous : E.Filtration P S.X₁) (hP : P S.X₃) :
    (Filtration.step S hS previous hP).factors = previous.factors ++ [S.X₃] := rfl

@[simp] lemma length_zero {X : C} (hX : IsZero X) :
    (Filtration.zero (E := E) (P := P) hX).length = 0 := rfl

@[simp] lemma length_step (S : ShortComplex C) (hS : E.conflation S)
    (previous : E.Filtration P S.X₁) (hP : P S.X₃) :
    (Filtration.step S hS previous hP).length = previous.length + 1 := by
  simp [length]

/-- Every recorded factor satisfies the filtration predicate. -/
lemma mem_factors {X : C} (F : E.Filtration P X) {Y : C}
    (hY : Y ∈ F.factors) : P Y := by
  induction F with
  | zero hX => simp at hY
  | step S hS previous hP ih =>
    simp only [factors_step, List.mem_append, List.mem_singleton] at hY
    rcases hY with hY | rfl
    · exact ih hY
    · exact hP

/-- Telescoping of classes along an actual finite admissible filtration. -/
theorem class_eq_sum {X : C} (F : E.Filtration P X) :
    E.grothendieckClass X = (F.factors.map E.grothendieckClass).sum := by
  induction F with
  | zero hX => simpa using E.grothendieckClass_of_isZero hX
  | step S hS previous hP ih =>
    rw [E.grothendieckClass_additive hS, ih]
    simp

/-- The analogous telescoping formula for every conflation-additive invariant. -/
theorem additiveInvariant_eq_sum {A : Type w} [AddCommGroup A] (f : C → A)
    (hf : E.IsAdditiveInvariant f) {X : C} (F : E.Filtration P X) :
    f X = (F.factors.map f).sum := by
  have h := congrArg (E.grothendieckLift f hf) F.class_eq_sum
  simpa [map_list_sum, List.map_map, Function.comp_def] using h

/-- Filtration classes belong to any additive subgroup containing their factors. -/
theorem class_mem {X : C} (F : E.Filtration P X)
    (H : AddSubgroup E.GrothendieckGroup)
    (hH : ∀ Y, P Y → E.grothendieckClass Y ∈ H) : E.grothendieckClass X ∈ H := by
  induction F with
  | zero hX => rw [E.grothendieckClass_of_isZero hX]; exact H.zero_mem
  | step S hS previous hP ih =>
    rw [E.grothendieckClass_additive hS]
    exact H.add_mem ih (hH S.X₃ hP)

end Filtration

/-- The subgroup generated by classes of objects satisfying `P`. -/
def grothendieckClassesSubgroup (P : C → Prop) : AddSubgroup E.GrothendieckGroup :=
  AddSubgroup.closure {a | ∃ X, P X ∧ a = E.grothendieckClass X}

/-- Each filtration gives membership in the subgroup generated by its permitted
factor classes. -/
theorem Filtration.class_mem_generated {X : C} (F : E.Filtration P X) :
    E.grothendieckClass X ∈ E.grothendieckClassesSubgroup P :=
  F.class_mem _ fun Y hY => AddSubgroup.subset_closure ⟨Y, hY, rfl⟩

/-- Object classes generate the algebraic Grothendieck group. -/
lemma grothendieckSubgroup_eq_top_of_classes (H : AddSubgroup E.GrothendieckGroup)
    (hH : ∀ X, E.grothendieckClass X ∈ H) : H = ⊤ := by
  apply top_unique
  intro x hx
  clear hx
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective E.grothendieckRelations x
  induction a using FreeAbelianGroup.induction_on with
  | zero => simp
  | of X => exact hH X
  | neg X ih => simpa using H.neg_mem ih
  | add a b ha hb => simpa using H.add_mem ha hb

/-- If every object has a finite admissible filtration with factors satisfying
`P`, their classes generate the algebraic Grothendieck group. This is only a
statement about the group presented by conflations. -/
theorem grothendieckClassesSubgroup_eq_top_of_filtrations
    (h : ∀ X, Nonempty (E.Filtration P X)) : E.grothendieckClassesSubgroup P = ⊤ := by
  apply grothendieckSubgroup_eq_top_of_classes
  intro X
  obtain ⟨F⟩ := h X
  exact F.class_mem_generated

end Quillen.ExactStructure

namespace Quillen.ExactFunctor

universe v₂ u₂

variable {C : Type u} {D : Type u₂} [Category.{v} C] [Category.{v₂} D]
  [Preadditive C] [Preadditive D] [HasFiniteBiproducts C] [HasFiniteBiproducts D]
  {EC : ExactStructure C} {ED : ExactStructure D}

/-- If every target object has a finite admissible filtration with successive
factors in the essential image of an exact functor, the induced homomorphism on
algebraic Grothendieck groups is surjective. No injectivity, Quillen K-group
comparison, or homotopy equivalence is claimed by this result. -/
theorem grothendieckMap_surjective_of_filtrations (F : ExactFunctor EC ED)
    (h : ∀ Y, Nonempty (ED.Filtration
      (fun Z => ∃ X, Nonempty (F.toFunctor.obj X ≅ Z)) Y)) :
    Function.Surjective F.grothendieckMap := by
  apply AddMonoidHom.range_eq_top.mp
  apply ExactStructure.grothendieckSubgroup_eq_top_of_classes
  intro Y
  obtain ⟨G⟩ := h Y
  apply G.class_mem
  rintro Z ⟨X, ⟨e⟩⟩
  refine ⟨EC.grothendieckClass X, ?_⟩
  rw [F.grothendieckMap_class]
  exact ED.grothendieckClass_iso e

end Quillen.ExactFunctor
