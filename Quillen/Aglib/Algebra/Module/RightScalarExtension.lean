module

public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# Balanced tensor extension of right modules

For an arbitrary ring homomorphism `f : R →+* S`, `Tensor f M` is the quotient
of the integer tensor product `S ⊗[ℤ] M` by the right `S`-submodule generated by
`(f r * s) ⊗ m - s ⊗ (op r • m)`. The order of the integer tensor factors
provides the right action directly; `pure f m s` represents `m ⊗[R] s`.

The relation submodule has exactly the integer span of the balancing relations.
Consequently the quotient has the balanced biadditive universal property into
every abelian group. Its right-module universal property identifies linear maps
out of the quotient with semilinear maps out of `M`.

All modules are left modules over opposite rings. Ring, source-module, and
target-module universes are independent. No commutativity, flatness,
nontriviality, finiteness, or projectivity hypothesis is used.
-/

@[expose] public section

noncomputable section

universe u v w z

namespace Quillen.RightScalarExtension

open MulOpposite
open scoped TensorProduct

variable {R : Type u} {S : Type v} [Ring R] [Ring S]
variable (f : R →+* S) (M : Type w) [AddCommGroup M] [Module Rᵐᵒᵖ M]

/-- An additive balancing relation in the integer tensor product. -/
def relation (r : R) (s : S) (m : M) : S ⊗[ℤ] M :=
  (f r * s) ⊗ₜ[ℤ] m - s ⊗ₜ[ℤ] (op r • m)

/-- The set of additive balancing relations. -/
def generators : Set (S ⊗[ℤ] M) :=
  {x | ∃ r s m, x = relation f M r s m}

/-- The right `S`-submodule of balancing relations. -/
def relations : Submodule Sᵐᵒᵖ (S ⊗[ℤ] M) :=
  Submodule.span Sᵐᵒᵖ (generators f M)

/-- Right multiplication preserves the generating balancing relations. -/
lemma smul_relation (r : R) (s t : S) (m : M) :
    op t • relation f M r s m = relation f M r (s * t) m := by
  simp only [relation, smul_sub, TensorProduct.smul_tmul', smul_eq_mul_unop,
    unop_op, mul_assoc]

/-- The integer span of the balancing relations is already a right `S`-submodule. -/
lemma smul_mem_integerSpan (t : Sᵐᵒᵖ) {x : S ⊗[ℤ] M}
    (hx : x ∈ Submodule.span ℤ (generators f M)) :
    t • x ∈ Submodule.span ℤ (generators f M) := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨r, s, m, rfl⟩ := hx
    rw [← op_unop t, smul_relation]
    exact Submodule.subset_span ⟨r, s * unop t, m, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => simpa only [smul_add] using Submodule.add_mem _ hx hy
  | smul a x _ hx =>
    simpa only [smul_comm t a x] using Submodule.smul_mem _ a hx

/-- Scalar closure introduces no extra additive relations. -/
lemma relations_restrictScalars :
    (relations f M).restrictScalars ℤ = Submodule.span ℤ (generators f M) := by
  let p : Submodule Sᵐᵒᵖ (S ⊗[ℤ] M) :=
    { toAddSubmonoid := (Submodule.span ℤ (generators f M)).toAddSubmonoid
      smul_mem' := fun t _ hx => smul_mem_integerSpan f M t hx }
  apply le_antisymm
  · exact (Submodule.span_le.mpr fun _ hx => Submodule.subset_span hx : relations f M ≤ p)
  · exact Submodule.span_le.mpr fun _ hx => Submodule.subset_span hx

/-- The literal balanced tensor product extending a right module along `f`. -/
abbrev Tensor := (S ⊗[ℤ] M) ⧸ relations f M

variable {M}

/-- The pure tensor represented by `m ⊗[R] s`. -/
def pure (m : M) (s : S) : Tensor f M :=
  (relations f M).mkQ (s ⊗ₜ[ℤ] m)

@[simp] lemma pure_add_left (m n : M) (s : S) :
    pure f (m + n) s = pure f m s + pure f n s := by
  simp [pure, TensorProduct.tmul_add]

@[simp] lemma pure_add_right (m : M) (s t : S) :
    pure f m (s + t) = pure f m s + pure f m t := by
  simp [pure, TensorProduct.add_tmul]

@[simp] lemma pure_zero_left (s : S) : pure f (0 : M) s = 0 := by simp [pure]

@[simp] lemma pure_zero_right (m : M) : pure f m 0 = 0 := by simp [pure]

@[simp] lemma pure_neg_left (m : M) (s : S) : pure f (-m) s = -pure f m s := by
  simp [pure, TensorProduct.tmul_neg]

@[simp] lemma pure_neg_right (m : M) (s : S) : pure f m (-s) = -pure f m s := by
  simp [pure, TensorProduct.neg_tmul]

/-- Multiplication acts on the right of the scalar in a pure tensor. -/
lemma pure_smul (m : M) (s t : S) : op t • pure f m s = pure f m (s * t) := by
  simp only [pure, ← map_smul, TensorProduct.smul_tmul', smul_eq_mul_unop, unop_op]

/-- The defining balanced relation has the conventional right-module order. -/
lemma pure_balance (r : R) (m : M) (s : S) :
    pure f (op r • m) s = pure f m (f r * s) := by
  symm
  exact (Submodule.Quotient.eq (relations f M)).mpr
    (Submodule.subset_span ⟨r, s, m, rfl⟩)

/-- Pure tensors and addition generate the quotient. -/
@[elab_as_elim] lemma induction_on {P : Tensor f M → Prop} (x : Tensor f M)
    (hpure : ∀ m s, P (pure f m s)) (hadd : ∀ x y, P x → P y → P (x + y)) : P x := by
  refine Submodule.Quotient.induction_on (relations f M) x fun y => ?_
  exact TensorProduct.inductionOn y (fun s m => hpure m s)
    (fun a b ha hb => hadd _ _ ha hb)

variable {A : Type z} [AddCommGroup A]

/-- An additive map from the quotient is determined on pure tensors. -/
lemma addHom_ext {g h : Tensor f M →+ A}
    (H : ∀ m s, g (pure f m s) = h (pure f m s)) : g = h := by
  apply DFunLike.ext
  intro x
  exact induction_on f x H fun x y hx hy => by simp only [map_add, hx, hy]

/-- Balanced biadditive maps with values in an arbitrary abelian group. -/
def BalancedMap :=
  {h : M →+ S →+ A // ∀ r m s, h (op r • m) s = h m (f r * s)}

/-- The additive map on the integer tensor product induced by a biadditive map. -/
def rawAddLift (h : M →+ S →+ A) : S ⊗[ℤ] M →+ A :=
  TensorProduct.liftAddHom h.flip fun n s m => by
    simp only [AddMonoidHom.flip_apply, map_zsmul, AddMonoidHom.zsmul_apply]

@[simp] lemma rawAddLift_tmul (h : M →+ S →+ A) (m : M) (s : S) :
    rawAddLift h (s ⊗ₜ[ℤ] m) = h m s := rfl

/-- A balanced biadditive map vanishes on all of the relation submodule. -/
lemma relations_le_ker_rawAddLift (h : BalancedMap f (M := M) (A := A)) :
    (relations f M).toAddSubgroup ≤ (rawAddLift h.val).ker := by
  intro x hx
  have hi : x ∈ Submodule.span ℤ (generators f M) := by
    rw [← relations_restrictScalars]
    exact hx
  have hk : Submodule.span ℤ (generators f M) ≤ (rawAddLift h.val).toIntLinearMap.ker := by
    apply Submodule.span_le.mpr
    rintro x ⟨r, s, m, rfl⟩
    change rawAddLift h.val (relation f M r s m) = 0
    simp only [relation, map_sub, rawAddLift_tmul, ← h.property r m s, sub_self]
  exact hk hi

/-- Descend a balanced biadditive map to the literal tensor quotient. -/
def liftAddHom (h : BalancedMap f (M := M) (A := A)) : Tensor f M →+ A :=
  QuotientAddGroup.lift (relations f M).toAddSubgroup (rawAddLift h.val)
    (relations_le_ker_rawAddLift f h)

@[simp] lemma liftAddHom_pure (h : BalancedMap f (M := M) (A := A)) (m : M) (s : S) :
    liftAddHom f h (pure f m s) = h.val m s := rfl

/-- The additive extension is uniquely specified on pure tensors. -/
lemma liftAddHom_unique (h : BalancedMap f (M := M) (A := A)) (g : Tensor f M →+ A)
    (H : ∀ m s, g (pure f m s) = h.val m s) : g = liftAddHom f h := by
  apply addHom_ext f
  intro m s
  exact H m s

/-- Restrict an additive map to the universal balanced biadditive map. -/
def toBalancedMap (g : Tensor f M →+ A) : BalancedMap f (M := M) (A := A) :=
  ⟨{ toFun := fun m =>
       { toFun := fun s => g (pure f m s)
         map_zero' := by simp
         map_add' := fun s t => by simp }
     map_zero' := by ext s; simp
     map_add' := fun m n => by ext s; simp },
   fun r m s => congrArg g (pure_balance f r m s)⟩

/-- The genuine balanced biadditive universal property, with no module on the target. -/
def balancedHomEquiv : (Tensor f M →+ A) ≃ BalancedMap f (M := M) (A := A) where
  toFun := toBalancedMap f
  invFun := liftAddHom f
  left_inv g := addHom_ext f fun _ _ => rfl
  right_inv h := by apply Subtype.ext; ext m s; rfl

@[simp] lemma balancedHomEquiv_apply (g : Tensor f M →+ A) (m : M) (s : S) :
    (balancedHomEquiv f g).val m s = g (pure f m s) := rfl

@[simp] lemma balancedHomEquiv_symm_apply (h : BalancedMap f (M := M) (A := A)) :
    (balancedHomEquiv f).symm h = liftAddHom f h := rfl

/-- The canonical semilinear map into scalar extension. -/
def unit : M →ₛₗ[f.op] Tensor f M where
  toFun m := pure f m 1
  map_add' m n := pure_add_left f m n 1
  map_smul' r m := by
    change pure f (op (unop r) • m) 1 = op (f (unop r)) • pure f m 1
    rw [pure_balance, pure_smul, mul_one, one_mul]

@[simp] lemma unit_apply (m : M) : unit f m = pure f m 1 := rfl

/-- Every pure tensor is a right multiple of the canonical unit. -/
lemma pure_eq_smul_unit (m : M) (s : S) : pure f m s = op s • unit f m := by
  simp only [unit_apply, pure_smul, one_mul]

variable {N : Type z} [AddCommGroup N] [Module Sᵐᵒᵖ N]

/-- A semilinear map determines a balanced biadditive map by right multiplication. -/
def semilinearToBalanced (h : M →ₛₗ[f.op] N) : BalancedMap f (M := M) (A := N) :=
  ⟨{ toFun := fun m =>
       { toFun := fun s => op s • h m
         map_zero' := by simp
         map_add' := fun s t => by simp [add_smul] }
     map_zero' := by ext s; simp
     map_add' := fun m n => by ext s; simp [smul_add] },
   fun r m s => by
     change op s • h (op r • m) = op (f r * s) • h m
     rw [h.map_smulₛₗ]
     change op s • op (f r) • h m = op (f r * s) • h m
     rw [op_mul, mul_smul]⟩

/-- The linear extension of a semilinear map through the balanced quotient. -/
def lift (h : M →ₛₗ[f.op] N) : Tensor f M →ₗ[Sᵐᵒᵖ] N :=
  { liftAddHom f (semilinearToBalanced f h) with
    map_smul' := fun t x => by
      change liftAddHom f (semilinearToBalanced f h) (t • x) =
        t • liftAddHom f (semilinearToBalanced f h) x
      refine induction_on f x (fun m s => ?_) (fun x y hx hy => ?_)
      · rw [← op_unop t, pure_smul]
        change op (s * unop t) • h m = op (unop t) • op s • h m
        rw [op_mul, mul_smul]
      · simp only [smul_add, map_add, hx, hy] }

@[simp] lemma lift_pure (h : M →ₛₗ[f.op] N) (m : M) (s : S) :
    lift f h (pure f m s) = op s • h m := rfl

lemma lift_unit (h : M →ₛₗ[f.op] N) (m : M) :
    lift f h (unit f m) = h m := by simp

/-- Linear maps out of scalar extension agree if they agree on all pure tensors. -/
lemma hom_ext {g h : Tensor f M →ₗ[Sᵐᵒᵖ] N}
    (H : ∀ m s, g (pure f m s) = h (pure f m s)) : g = h := by
  apply DFunLike.ext
  intro x
  exact induction_on f x H fun x y hx hy => by simp only [map_add, hx, hy]

/-- Linear maps out of scalar extension agree if they agree on the canonical unit. -/
lemma hom_ext_unit {g h : Tensor f M →ₗ[Sᵐᵒᵖ] N}
    (H : ∀ m, g (unit f m) = h (unit f m)) : g = h := by
  apply hom_ext f
  intro m s
  simp only [pure_eq_smul_unit, map_smul, H]

@[simp] lemma lift_comp_unit (h : M →ₛₗ[f.op] N) : (lift f h).comp (unit f) = h := by
  ext m
  exact lift_unit f h m

@[simp] lemma lift_restrict (g : Tensor f M →ₗ[Sᵐᵒᵖ] N) :
    lift f (g.comp (unit f)) = g := by
  apply hom_ext_unit f
  intro m
  simp

/-- The extension is the unique linear map with its prescribed values on the unit. -/
lemma lift_unique (h : M →ₛₗ[f.op] N) (g : Tensor f M →ₗ[Sᵐᵒᵖ] N)
    (H : ∀ m, g (unit f m) = h m) : g = lift f h := by
  apply hom_ext_unit f
  intro m
  simpa using H m

/-- The scalar-extension adjunction on Hom groups for arbitrary target modules. -/
def homEquiv : (Tensor f M →ₗ[Sᵐᵒᵖ] N) ≃+ (M →ₛₗ[f.op] N) where
  toFun g := g.comp (unit f)
  invFun := lift f
  left_inv := lift_restrict f
  right_inv := lift_comp_unit f
  map_add' g h := by ext m; rfl

@[simp] lemma homEquiv_apply (g : Tensor f M →ₗ[Sᵐᵒᵖ] N) (m : M) :
    homEquiv f g m = g (unit f m) := rfl

@[simp] lemma homEquiv_symm_apply (h : M →ₛₗ[f.op] N) :
    (homEquiv f).symm h = lift f h := rfl

variable {P : Type*} [AddCommGroup P] [Module Sᵐᵒᵖ P]

/-- Extension is natural under arbitrary target-module linear maps. -/
lemma lift_postcomp (h : M →ₛₗ[f.op] N) (g : N →ₗ[Sᵐᵒᵖ] P) :
    lift f (g.comp h) = g.comp (lift f h) := by
  apply hom_ext_unit f
  intro m
  simp

/-- The Hom equivalence is natural in its target module. -/
lemma homEquiv_postcomp (h : Tensor f M →ₗ[Sᵐᵒᵖ] N) (g : N →ₗ[Sᵐᵒᵖ] P) :
    homEquiv f (g.comp h) = g.comp (homEquiv f h) := by
  ext m
  rfl

section Semilinear

variable {T : Type*} [Ring T] (g : S →+* T)
variable {Q : Type*} [AddCommGroup Q] [Module Tᵐᵒᵖ Q]

/-- Extend through a second ring map by restricting the target module's scalars. -/
def liftSemilinear (h : M →ₛₗ[(g.comp f).op] Q) : Tensor f M →ₛₗ[g.op] Q := by
  letI := Module.compHom Q g.op
  let h' : M →ₛₗ[f.op] Q :=
    { h.toAddMonoidHom with map_smul' := fun r m => h.map_smulₛₗ r m }
  exact { (lift f h').toAddMonoidHom with
    map_smul' := fun s x => (lift f h').map_smul s x }

@[simp] lemma liftSemilinear_pure (h : M →ₛₗ[(g.comp f).op] Q) (m : M) (s : S) :
    liftSemilinear f g h (pure f m s) = op (g s) • h m := rfl

lemma liftSemilinear_unit (h : M →ₛₗ[(g.comp f).op] Q) (m : M) :
    liftSemilinear f g h (unit f m) = h m := by simp

/-- Semilinear maps out of the quotient are determined on pure tensors. -/
lemma semilinear_ext {a b : Tensor f M →ₛₗ[g.op] Q}
    (H : ∀ m s, a (pure f m s) = b (pure f m s)) : a = b := by
  apply DFunLike.ext
  intro x
  exact induction_on f x H fun x y hx hy => by simp only [map_add, hx, hy]

/-- Semilinear maps out of scalar extension are determined by the unit. -/
lemma semilinear_ext_unit {a b : Tensor f M →ₛₗ[g.op] Q}
    (H : ∀ m, a (unit f m) = b (unit f m)) : a = b := by
  apply semilinear_ext f g
  intro m s
  simp only [pure_eq_smul_unit, map_smulₛₗ, H]

/-- The semilinear extension is uniquely specified by its values on the unit. -/
lemma liftSemilinear_unique (h : M →ₛₗ[(g.comp f).op] Q)
    (a : Tensor f M →ₛₗ[g.op] Q) (H : ∀ m, a (unit f m) = h m) :
    a = liftSemilinear f g h := by
  apply semilinear_ext_unit f g
  intro m
  simpa using H m

end Semilinear

end Quillen.RightScalarExtension
