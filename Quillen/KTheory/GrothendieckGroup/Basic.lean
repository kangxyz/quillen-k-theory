module

public import Quillen.CategoryTheory.ExactCategory.Basic
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.GroupTheory.QuotientGroup.Defs

/-!
# The algebraic Grothendieck group of an exact category

This is the quotient of the free abelian group on objects by the relations
`[S.X₂] - [S.X₁] - [S.X₃]` for conflations `S`. Isomorphism invariance is a theorem,
rather than an additional defining relation. We prove its universal property for
conflation-additive functions into arbitrary abelian groups.

This algebraic group is not identified here with `ExactStructure.K E 0`.
That comparison requires a separate theorem about the Q-construction.
-/
@[expose] public section


noncomputable section

universe v u w

open CategoryTheory CategoryTheory.Limits

namespace Quillen.ExactStructure

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasFiniteBiproducts C]
  (E : ExactStructure C)

/-- The additive relation associated to a short complex. -/
def grothendieckRelation (S : ShortComplex C) : FreeAbelianGroup C :=
  FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃

/-- The subgroup generated by all conflation relations. -/
def grothendieckRelations : AddSubgroup (FreeAbelianGroup C) :=
  AddSubgroup.closure {r | ∃ S : ShortComplex C, E.conflation S ∧
    r = grothendieckRelation S}

/-- The algebraic Grothendieck group, presented by objects and conflations. -/
abbrev GrothendieckGroup := FreeAbelianGroup C ⧸ E.grothendieckRelations

/-- The canonical class of an object in the algebraic Grothendieck group. -/
def grothendieckClass (X : C) : E.GrothendieckGroup :=
  QuotientAddGroup.mk' E.grothendieckRelations (FreeAbelianGroup.of X)

/-- A defining conflation relation belongs to the relation subgroup. -/
lemma grothendieckRelation_mem {S : ShortComplex C} (hS : E.conflation S) :
    grothendieckRelation S ∈ E.grothendieckRelations :=
  AddSubgroup.subset_closure ⟨S, hS, rfl⟩

/-- Classes are additive on the selected conflations. -/
lemma grothendieckClass_additive {S : ShortComplex C} (hS : E.conflation S) :
    E.grothendieckClass S.X₂ = E.grothendieckClass S.X₁ + E.grothendieckClass S.X₃ := by
  have h := (QuotientAddGroup.eq_zero_iff (grothendieckRelation S)).2
    (E.grothendieckRelation_mem hS)
  change E.grothendieckClass S.X₂ - E.grothendieckClass S.X₁ -
    E.grothendieckClass S.X₃ = 0 at h
  exact sub_eq_zero.mp ((sub_sub _ _ _).symm.trans h)

/-- Isomorphic objects have equal classes. This follows from conflation relations. -/
lemma grothendieckClass_iso {X Y : C} (e : X ≅ Y) :
    E.grothendieckClass X = E.grothendieckClass Y := by
  obtain ⟨Z, p, h, hS⟩ := E.inflation_id X
  have hp : p = 0 := by simpa using h
  let T := ShortComplex.mk e.hom (0 : Y ⟶ Z) (by simp)
  have hT : E.conflation T := E.iso_closed
    (ShortComplex.isoMk (Iso.refl X) e (Iso.refl Z) (by simp [T]) (by simp [T, hp])) hS
  have h₁ := E.grothendieckClass_additive hS
  have h₂ := E.grothendieckClass_additive hT
  exact h₁.trans h₂.symm

open ZeroObject in
/-- The chosen zero object represents zero in the Grothendieck group. -/
@[simp] lemma grothendieckClass_zero : E.grothendieckClass (0 : C) = 0 := by
  obtain ⟨Z, p, h, hS⟩ := E.inflation_id (0 : C)
  have hZ : IsZero Z := CokernelCofork.IsColimit.isZero_of_epi
    (E.cokernel (ShortComplex.mk (𝟙 (0 : C)) p h) hS)
  have hz := E.grothendieckClass_iso (hZ.iso (isZero_zero C))
  have hadd := E.grothendieckClass_additive hS
  change E.grothendieckClass (0 : C) =
    E.grothendieckClass (0 : C) + E.grothendieckClass Z at hadd
  rw [hz] at hadd
  exact (add_left_cancel (a := E.grothendieckClass (0 : C))
    (hadd.symm.trans (add_zero _).symm))

/-- A function on objects is a conflation-additive invariant if it takes a middle
object to the sum of the two outer objects for every conflation. -/
def IsAdditiveInvariant {A : Type w} [AddCommGroup A] (f : C → A) : Prop :=
  ∀ (S : ShortComplex C), E.conflation S → f S.X₂ = f S.X₁ + f S.X₃

variable {A : Type w} [AddCommGroup A]

/-- Additive invariants kill every element of the relation subgroup. -/
lemma grothendieckRelations_le_ker (f : C → A) (hf : E.IsAdditiveInvariant f) :
    E.grothendieckRelations ≤ (FreeAbelianGroup.lift f).ker := by
  apply (AddSubgroup.closure_le _).2
  rintro r ⟨S, hS, rfl⟩
  change FreeAbelianGroup.lift f (grothendieckRelation S) = 0
  simp [grothendieckRelation, hf S hS]

/-- The homomorphism induced by a conflation-additive invariant. -/
def grothendieckLift (f : C → A) (hf : E.IsAdditiveInvariant f) :
    E.GrothendieckGroup →+ A :=
  QuotientAddGroup.lift E.grothendieckRelations (FreeAbelianGroup.lift f)
    (E.grothendieckRelations_le_ker f hf)

@[simp] lemma grothendieckLift_class (f : C → A) (hf : E.IsAdditiveInvariant f) (X : C) :
    E.grothendieckLift f hf (E.grothendieckClass X) = f X := by
  simp [grothendieckLift, grothendieckClass]

/-- Homomorphisms out of the Grothendieck group are determined on object classes. -/
@[ext] lemma grothendieck_hom_ext (f g : E.GrothendieckGroup →+ A)
    (h : ∀ X, f (E.grothendieckClass X) = g (E.grothendieckClass X)) : f = g := by
  have hc : f.comp (QuotientAddGroup.mk' E.grothendieckRelations) =
      g.comp (QuotientAddGroup.mk' E.grothendieckRelations) :=
    FreeAbelianGroup.lift_ext _ _ h
  apply AddMonoidHom.ext
  intro x
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective E.grothendieckRelations x
  exact DFunLike.congr_fun hc a

/-- Uniqueness of the lift of an additive invariant. -/
lemma grothendieckLift_unique (f : C → A) (hf : E.IsAdditiveInvariant f)
    (g : E.GrothendieckGroup →+ A) (hg : ∀ X, g (E.grothendieckClass X) = f X) :
    g = E.grothendieckLift f hf := by
  apply E.grothendieck_hom_ext
  intro X
  rw [hg, E.grothendieckLift_class]

/-- The universal property: every conflation-additive invariant factors uniquely
through the algebraic Grothendieck group. -/
theorem grothendieck_universal (f : C → A) (hf : E.IsAdditiveInvariant f) :
    ∃! g : E.GrothendieckGroup →+ A, ∀ X, g (E.grothendieckClass X) = f X := by
  refine ⟨E.grothendieckLift f hf, E.grothendieckLift_class f hf, ?_⟩
  intro g hg
  exact E.grothendieckLift_unique f hf g hg

/-- The universal property as an equivalence between homomorphisms and
conflation-additive object invariants. -/
def grothendieckHomEquiv : (E.GrothendieckGroup →+ A) ≃
    {f : C → A // E.IsAdditiveInvariant f} where
  toFun g := ⟨fun X => g (E.grothendieckClass X), fun S hS => by
    dsimp only
    rw [E.grothendieckClass_additive hS, map_add]⟩
  invFun f := E.grothendieckLift f.1 f.2
  left_inv g := by
    apply E.grothendieck_hom_ext
    intro X
    exact E.grothendieckLift_class _ _ X
  right_inv f := by
    apply Subtype.ext
    funext X
    exact E.grothendieckLift_class _ _ X

/-- Conflation additivity alone implies isomorphism invariance. -/
lemma IsAdditiveInvariant.iso {f : C → A} (hf : E.IsAdditiveInvariant f)
    {X Y : C} (e : X ≅ Y) : f X = f Y := by
  rw [← E.grothendieckLift_class f hf X, ← E.grothendieckLift_class f hf Y,
    E.grothendieckClass_iso e]

open ZeroObject in
/-- An additive invariant necessarily vanishes on the zero object. -/
lemma IsAdditiveInvariant.zero {f : C → A} (hf : E.IsAdditiveInvariant f) :
    f (0 : C) = 0 := by
  rw [← E.grothendieckLift_class f hf (0 : C), E.grothendieckClass_zero, map_zero]

open ZeroObject in
/-- Any zero object, not merely the chosen one, represents zero. -/
lemma grothendieckClass_of_isZero {X : C} (hX : IsZero X) :
    E.grothendieckClass X = 0 :=
  (E.grothendieckClass_iso (hX.iso (isZero_zero C))).trans E.grothendieckClass_zero

end Quillen.ExactStructure
