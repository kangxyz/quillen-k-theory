module

public import Aglib.CategoryTheory.ExactCategory.Basic
public import Aglib.CategoryTheory.ExactCategory.Functor
public import Quillen.KTheory.GrothendieckComparison.Retraction
public import Quillen.Topology.ClassifyingSpace.CompletionSurjectivity

/-!
# Classical Grothendieck groups and genuine Quillen K₀

The original object-class homomorphism is an equivalence. Its source is the
classical group generated by objects with the original conflation relations;
its target is the existing homotopical Quillen K₀. The inverse is the previously
constructed topological retraction. Both directions respect exact functors.
-/
@[expose] public section

open CategoryTheory.ExactCategory


noncomputable section
universe v u
open CategoryTheory CategoryTheory.Limits
namespace CategoryTheory.ExactCategory.ExactStructure
open Quillen
variable {C : Type u} [Category.{v} C] [Preadditive C] [HasFiniteBiproducts C]
  (E : ExactStructure C)

/-- Every genuine K₀ class is represented by a completed Q-edge loop. -/
theorem qGroupoidToKZero_surjective : Function.Surjective E.qGroupoidToKZero :=
  E.kZeroFundamentalGroupEquiv.symm.surjective.comp
    (classifyingGroupoidCompletionMap_surjective E.QCategory E.qZero)

/-- The original object-class map attains every genuine homotopical K₀ class. -/
theorem grothendieckToKZero_surjective : Function.Surjective E.grothendieckToKZero :=
  E.grothendieckToKZero_surjective_iff.mpr E.qGroupoidToKZero_surjective

/-- The original classical-to-homotopical comparison is bijective. -/
theorem grothendieckToKZero_bijective : Function.Bijective E.grothendieckToKZero :=
  ⟨E.grothendieckToKZero_injective, E.grothendieckToKZero_surjective⟩

/-- The original comparison and the genuine topological retraction are mutually inverse. -/
@[simp] theorem grothendieckToKZero_comp_retraction :
    E.grothendieckToKZero.comp E.kZeroToGrothendieck = MonoidHom.id (E.K 0) := by
  apply MonoidHom.ext
  intro x
  obtain ⟨a, rfl⟩ := E.grothendieckToKZero_surjective x
  exact congrArg E.grothendieckToKZero (DFunLike.congr_fun E.kZeroToGrothendieck_comp a)

/-- The genuine canonical equivalence from the classical conflation presentation
to the existing homotopical Quillen K₀, with the original maps in both directions. -/
def grothendieckKZeroEquiv : Multiplicative E.GrothendieckGroup ≃* E.K 0 where
  toFun := E.grothendieckToKZero
  invFun := E.kZeroToGrothendieck
  left_inv := DFunLike.congr_fun E.kZeroToGrothendieck_comp
  right_inv := DFunLike.congr_fun E.grothendieckToKZero_comp_retraction
  map_mul' := E.grothendieckToKZero.map_mul

@[simp] theorem grothendieckKZeroEquiv_toMonoidHom :
    (E.grothendieckKZeroEquiv : Multiplicative E.GrothendieckGroup →* E.K 0) =
      E.grothendieckToKZero := rfl

@[simp] theorem grothendieckKZeroEquiv_symm_toMonoidHom :
    (E.grothendieckKZeroEquiv.symm : E.K 0 →* Multiplicative E.GrothendieckGroup) =
      E.kZeroToGrothendieck := rfl

/-- The canonical equivalence preserves every original object class exactly. -/
@[simp] theorem grothendieckKZeroEquiv_objectClass (X : C) :
    E.grothendieckKZeroEquiv (Multiplicative.ofAdd (E.grothendieckClass X)) =
      E.kZeroObjectClass X := E.grothendieckToKZero_class X

end CategoryTheory.ExactCategory.ExactStructure

namespace CategoryTheory.ExactCategory.ExactFunctor
open Quillen
variable {C D : Type u} [Category.{v} C] [Category.{v} D]
  [Preadditive C] [HasFiniteBiproducts C] [Preadditive D] [HasFiniteBiproducts D]
  {EC : ExactStructure C} {ED : ExactStructure D}

/-- The genuine canonical equivalence commutes with every exact-functor K₀ map. -/
theorem grothendieckKZeroEquiv_naturality (F : ExactFunctor EC ED) :
    (F.KMap 0).comp EC.grothendieckKZeroEquiv.toMonoidHom =
      ED.grothendieckKZeroEquiv.toMonoidHom.comp F.grothendieckMap.toMultiplicative :=
  F.grothendieckToKZero_naturality

/-- Naturality of the topological-to-classical inverse holds on all genuine K₀ classes. -/
theorem kZeroToGrothendieck_naturality (F : ExactFunctor EC ED) :
    F.grothendieckMap.toMultiplicative.comp EC.kZeroToGrothendieck =
      ED.kZeroToGrothendieck.comp (F.KMap 0) := by
  apply MonoidHom.ext
  intro x
  obtain ⟨a, rfl⟩ := EC.grothendieckToKZero_surjective x
  have h := DFunLike.congr_fun F.grothendieckToKZero_naturality a
  change F.KMap 0 (EC.grothendieckToKZero a) =
    ED.grothendieckToKZero (F.grothendieckMap.toMultiplicative a) at h
  change _ = ED.kZeroToGrothendieck (F.KMap 0 (EC.grothendieckToKZero a))
  rw [h]
  have hc := DFunLike.congr_fun EC.kZeroToGrothendieck_comp a
  have hd := DFunLike.congr_fun ED.kZeroToGrothendieck_comp
    (F.grothendieckMap.toMultiplicative a)
  change EC.kZeroToGrothendieck (EC.grothendieckToKZero a) = a at hc
  change ED.kZeroToGrothendieck
    (ED.grothendieckToKZero (F.grothendieckMap.toMultiplicative a)) =
      F.grothendieckMap.toMultiplicative a at hd
  change F.grothendieckMap.toMultiplicative
    (EC.kZeroToGrothendieck (EC.grothendieckToKZero a)) = _
  rw [hc, hd]

end CategoryTheory.ExactCategory.ExactFunctor
