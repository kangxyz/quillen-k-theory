import Quillen.KTheory.GrothendieckComparison.Cocycle
import Quillen.KTheory.GrothendieckComparison.Naturality
import Mathlib.CategoryTheory.Localization.Predicate

/-!
# The algebraic fundamental group of the Q-category

The actual categorical localization inverting every Q-arrow is a groupoid.
Its zero-based automorphism group is generated by the canonical object loops.
This is the algebraic edge-path presentation; identifying it with all continuous
loops in the realization is a separate topological theorem.
-/

noncomputable section
universe v u
open CategoryTheory CategoryTheory.Limits
open scoped ZeroObject
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
namespace Quillen.ExactStructure
variable {C : Type u} [Category.{v} C] [Preadditive C] [HasFiniteBiproducts C]
  (E : ExactStructure C)

/-- The actual categorical localization obtained by inverting all Q-arrows. -/
abbrev qGroupoid := (⊤ : MorphismProperty E.QCategory).Localization

instance qGroupoid_groupoid : Groupoid E.qGroupoid := Localization.groupoid

/-- The canonical functor from Q to its groupoid completion. -/
abbrev toQGroupoid : E.QCategory ⥤ E.qGroupoid := (⊤ : MorphismProperty E.QCategory).Q

/-- The zero-based vertex group of the categorical groupoid completion. -/
abbrev qGroupoidZeroGroup := End (E.toQGroupoid.obj E.qZero)

/-- The subgroup generated by the canonical object classes in the completion. -/
def qGroupoidObjectSubgroup : Subgroup E.qGroupoidZeroGroup :=
  Subgroup.closure (Set.range (E.qObjectClass E.toQGroupoid))

instance qGroupoidObjectSubgroup_isMulCommutative : IsMulCommutative E.qGroupoidObjectSubgroup := by
  apply Subgroup.isMulCommutative_closure
  rintro _ ⟨X, rfl⟩ _ ⟨Y, rfl⟩ _
  exact E.qObjectClass_commute E.toQGroupoid X Y

/-- Every object of the explicit localization has its canonical arrow from zero. -/
def qGroupoidZeroArrow (X : E.qGroupoid) : E.toQGroupoid.obj E.qZero ⟶ X :=
  E.toQGroupoid.map (E.fromZero X.as.obj)

/-- Normalize a completed Q-arrow into a based endomorphism. -/
def qGroupoidClosedArrow {X Y : E.qGroupoid} (f : X ⟶ Y) : E.qGroupoidZeroGroup :=
  E.qGroupoidZeroArrow X ≫ f ≫ inv (E.qGroupoidZeroArrow Y)

lemma qGroupoidClosedArrow_comp {X Y Z : E.qGroupoid} (f : X ⟶ Y) (g : Y ⟶ Z) :
    E.qGroupoidClosedArrow (f ≫ g) = E.qGroupoidClosedArrow g * E.qGroupoidClosedArrow f := by
  change _ = (_ ≫ _ ≫ _) ≫ (_ ≫ _ ≫ _)
  simp [qGroupoidClosedArrow, Category.assoc]

lemma qGroupoidClosedArrow_inv {X Y : E.qGroupoid} (e : X ≅ Y) :
    E.qGroupoidClosedArrow e.inv = (E.qGroupoidClosedArrow e.hom)⁻¹ := by
  change _ = CategoryTheory.inv (_ ≫ _ ≫ _)
  simp [qGroupoidClosedArrow, Category.assoc]

/-- The morphism property expressing generation by canonical object classes. -/
def qGroupoidGenerated : MorphismProperty E.qGroupoid :=
  fun _ _ f => E.qGroupoidClosedArrow f ∈ E.qGroupoidObjectSubgroup

instance qGroupoidGenerated_comp : E.qGroupoidGenerated.IsStableUnderComposition where
  comp_mem f g hf hg := by
    change E.qGroupoidClosedArrow (f ≫ g) ∈ E.qGroupoidObjectSubgroup
    rw [E.qGroupoidClosedArrow_comp]
    exact E.qGroupoidObjectSubgroup.mul_mem hg hf

/-- Localization's genuine generators-and-relations induction shows every
completed arrow is generated by the canonical object loops after closing. -/
theorem qGroupoidGenerated_eq_top : E.qGroupoidGenerated = ⊤ := by
  apply Localization.Construction.morphismProperty_eq_top'
  · intro X Y f
    change E.qEdgeClass E.toQGroupoid f ∈ E.qGroupoidObjectSubgroup
    obtain ⟨K, hK⟩ := E.qEdgeClass_eq_objectClass E.toQGroupoid f
    rw [hK]
    exact Subgroup.subset_closure ⟨K, rfl⟩
  · intro X Y e he
    change E.qGroupoidClosedArrow e.inv ∈ E.qGroupoidObjectSubgroup
    rw [E.qGroupoidClosedArrow_inv]
    exact E.qGroupoidObjectSubgroup.inv_mem he

/-- At zero, the canonical zero-apex arrow is the identity. -/
@[simp] lemma fromZero_self : E.fromZero E.qZero = 𝟙 E.qZero := by
  apply Quotient.sound
  refine ⟨Span.mkIso (Iso.refl _) ?_ ?_⟩ <;> simp [Q.of]

@[simp] lemma qGroupoidZeroArrow_zero :
    E.qGroupoidZeroArrow (E.toQGroupoid.obj E.qZero) = 𝟙 (E.toQGroupoid.obj E.qZero) := by
  change E.toQGroupoid.map (E.fromZero E.qZero) = _
  simp

@[simp] lemma qGroupoidClosedArrow_end (f : E.qGroupoidZeroGroup) :
    E.qGroupoidClosedArrow f = f := by simp [qGroupoidClosedArrow]

/-- Every element of the zero-based group in the categorical localization is
a product of canonical object classes and their inverses. -/
theorem qGroupoidObjectSubgroup_eq_top : E.qGroupoidObjectSubgroup = ⊤ := by
  apply (Subgroup.eq_top_iff' _).2
  intro f
  have h : E.qGroupoidGenerated f := by rw [E.qGroupoidGenerated_eq_top]; trivial
  simpa [qGroupoidGenerated] using h

open scoped IsMulCommutative in
/-- The groupoid-completion vertex group is commutative, proved from its
actual generators, without using topological edge-path generation. -/
instance qGroupoidZeroGroup_commGroup : CommGroup E.qGroupoidZeroGroup :=
  { (inferInstance : Group E.qGroupoidZeroGroup) with
    mul_comm := fun a b => by
      have ha : a ∈ E.qGroupoidObjectSubgroup := by rw [E.qGroupoidObjectSubgroup_eq_top]; trivial
      have hb : b ∈ E.qGroupoidObjectSubgroup := by rw [E.qGroupoidObjectSubgroup_eq_top]; trivial
      exact congrArg Subtype.val (mul_comm (⟨a, ha⟩ : E.qGroupoidObjectSubgroup) ⟨b, hb⟩) }

/-- Extend the proved Grothendieck cocycle to the actual groupoid localization. -/
def qGroupoidGrothendieckFunctor :
    E.qGroupoid ⥤ SingleObj (Multiplicative E.GrothendieckGroup) :=
  Localization.Construction.lift E.qGrothendieckFunctor (fun _ _ _ _ => inferInstance)

@[simp] lemma toQGroupoid_comp_grothendieckFunctor :
    E.toQGroupoid ⋙ E.qGroupoidGrothendieckFunctor = E.qGrothendieckFunctor :=
  Localization.Construction.fac _ _

/-- The canonical map from the localized zero-based vertex group to the
algebraic Grothendieck group. -/
def qGroupoidToGrothendieck : E.qGroupoidZeroGroup →* Multiplicative E.GrothendieckGroup :=
  (SingleObj.toEnd (Multiplicative E.GrothendieckGroup)).symm.toMonoidHom.comp
    (E.qGroupoidGrothendieckFunctor.mapEnd (E.toQGroupoid.obj E.qZero))

@[simp] lemma qGroupoidToGrothendieck_objectClass (X : C) :
    E.qGroupoidToGrothendieck (E.qObjectClass E.toQGroupoid X) =
      Multiplicative.ofAdd (E.grothendieckClass X) := by
  change (SingleObj.toEnd (Multiplicative E.GrothendieckGroup)).symm
    (E.qGroupoidGrothendieckFunctor.map (E.qObjectClass E.toQGroupoid X)) = _
  rw [← E.qObjectClass_comp, E.toQGroupoid_comp_grothendieckFunctor,
    E.qObjectClass_qGrothendieckFunctor]
  exact MulEquiv.symm_apply_apply _ _

/-- The canonical object classes induce the reverse homomorphism by the
Grothendieck universal property and the proved commutativity of the completion. -/
def grothendieckToQGroupoid : Multiplicative E.GrothendieckGroup →* E.qGroupoidZeroGroup :=
  AddMonoidHom.toMultiplicativeLeft
    (E.grothendieckLift (fun X => Additive.ofMul (E.qObjectClass E.toQGroupoid X))
      (fun _ hS => E.qObjectClass_conflation E.toQGroupoid hS))

@[simp] lemma grothendieckToQGroupoid_class (X : C) :
    E.grothendieckToQGroupoid (Multiplicative.ofAdd (E.grothendieckClass X)) =
      E.qObjectClass E.toQGroupoid X := by
  simp [grothendieckToQGroupoid, AddMonoidHom.toMultiplicativeLeft]

/-- The Grothendieck cocycle is a left inverse to the object-generator map. -/
@[simp] theorem qGroupoidToGrothendieck_comp :
    E.qGroupoidToGrothendieck.comp E.grothendieckToQGroupoid =
      MonoidHom.id (Multiplicative E.GrothendieckGroup) := by
  apply E.grothendieck_mulHom_ext
  intro X
  simp

/-- It is also a right inverse, by actual localization path generation. -/
@[simp] theorem grothendieckToQGroupoid_qGroupoidToGrothendieck (a : E.qGroupoidZeroGroup) :
    E.grothendieckToQGroupoid (E.qGroupoidToGrothendieck a) = a := by
  have ha : a ∈ E.qGroupoidObjectSubgroup := by rw [E.qGroupoidObjectSubgroup_eq_top]; trivial
  refine Subgroup.closure_induction
    (p := fun a _ => E.grothendieckToQGroupoid (E.qGroupoidToGrothendieck a) = a)
    ?_ ?_ ?_ ?_ ha
  · rintro a ⟨X, rfl⟩
    simp
  · change E.grothendieckToQGroupoid (E.qGroupoidToGrothendieck (1 : E.qGroupoidZeroGroup)) = 1
    rw [map_one, map_one]
  · intro a b ha hb h₁ h₂
    change E.grothendieckToQGroupoid (E.qGroupoidToGrothendieck (a * b)) = a * b
    rw [map_mul, map_mul, h₁, h₂]
  · intro a ha h
    change E.grothendieckToQGroupoid (E.qGroupoidToGrothendieck a⁻¹) = a⁻¹
    rw [map_inv, map_inv, h]

/-- The exact algebraic Q-edge-path calculation: the zero-based vertex group
of the actual groupoid completion is canonically the Grothendieck group. -/
def grothendieckQGroupoidEquiv :
    Multiplicative E.GrothendieckGroup ≃* E.qGroupoidZeroGroup where
  toFun := E.grothendieckToQGroupoid
  invFun := E.qGroupoidToGrothendieck
  left_inv a := DFunLike.congr_fun E.qGroupoidToGrothendieck_comp a
  right_inv := E.grothendieckToQGroupoid_qGroupoidToGrothendieck
  map_mul' := E.grothendieckToQGroupoid.map_mul

end Quillen.ExactStructure
