module

public import Mathlib.Data.Matrix.Basis
public import Mathlib.GroupTheory.IsPerfect
public import Mathlib.Tactic.Abel

/-!
# Elementary matrices over an arbitrary ring

Elementary matrices are constructed as actual units in the matrix ring, with
explicit inverses. The Steinberg commutator relation retains the order of its
coefficients and requires no commutativity of the ring. The subgroup generated
by elementary matrices is perfect whenever there is a third index distinct
from any given pair. Normality in the full general linear group is not asserted
at finite rank.
-/
@[expose] public section

universe u v

namespace Quillen.ElementaryMatrix

open scoped commutatorElement

variable {R : Type u} [Ring R] {n : Type v} [Fintype n] [DecidableEq n]

/-- The elementary matrix with coefficient `a` in position `(i,j)`. -/
def matrix (i j : n) (a : R) : Matrix n n R := 1 + Matrix.single i j a

omit [Fintype n] in
@[simp] lemma matrix_zero (i j : n) : matrix i j (0 : R) = 1 := by
  simp [matrix]

/-- Addition of coefficients is multiplication of elementary matrices. -/
lemma matrix_mul_same (i j : n) (hij : i ≠ j) (a b : R) :
    matrix i j a * matrix i j b = matrix i j (a + b) := by
  simp [matrix, add_mul, mul_add, hij.symm, Matrix.single_add, add_assoc]

/-- An elementary matrix as a unit, using the negative coefficient for its inverse. -/
def unit (i j : n) (hij : i ≠ j) (a : R) : (Matrix n n R)ˣ where
  val := matrix i j a
  inv := matrix i j (-a)
  val_inv := by rw [matrix_mul_same i j hij, add_neg_cancel, matrix_zero]
  inv_val := by rw [matrix_mul_same i j hij, neg_add_cancel, matrix_zero]

@[simp] lemma unit_val (i j : n) (hij : i ≠ j) (a : R) :
    (unit i j hij a).val = matrix i j a := rfl

@[simp] lemma unit_inv (i j : n) (hij : i ≠ j) (a : R) :
    (unit i j hij a)⁻¹ = unit i j hij (-a) := by
  apply Units.ext
  rfl

@[simp] lemma unit_zero (i j : n) (hij : i ≠ j) : unit i j hij (0 : R) = 1 := by
  apply Units.ext
  exact matrix_zero i j

lemma unit_mul_same (i j : n) (hij : i ≠ j) (a b : R) :
    unit i j hij a * unit i j hij b = unit i j hij (a + b) := by
  apply Units.ext
  exact matrix_mul_same i j hij a b

/-- Elementary matrices with disjoint interacting indices commute. -/
lemma unit_commute (i j k l : n) (hij : i ≠ j) (hkl : k ≠ l)
    (hjk : j ≠ k) (hli : l ≠ i) (a b : R) :
    Commute (unit i j hij a) (unit k l hkl b) := by
  apply Units.ext
  change matrix i j a * matrix k l b = matrix k l b * matrix i j a
  simp [matrix, add_mul, mul_add, hjk, hli]
  abel

/-- The Steinberg relation over a possibly noncommutative ring. -/
lemma unit_commutator (i j k : n) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k)
    (a b : R) :
    ⁅unit i j hij a, unit j k hjk b⁆ = unit i k hik (a * b) := by
  apply Units.ext
  simp only [commutatorElement_def, Units.val_mul, unit_inv, unit_val]
  simp [matrix, add_mul, mul_add, hij.symm, hjk.symm, hik.symm,
    ← Matrix.single_neg]
  abel

/-- The genuine elementary subgroup, generated by the elementary matrix units. -/
def subgroup (n : Type v) [Fintype n] [DecidableEq n] (R : Type u) [Ring R] :
    Subgroup (Matrix n n R)ˣ :=
  Subgroup.closure {g | ∃ (i j : n) (hij : i ≠ j) (a : R), g = unit i j hij a}

lemma unit_mem_subgroup (i j : n) (hij : i ≠ j) (a : R) :
    unit i j hij a ∈ subgroup n R :=
  Subgroup.subset_closure ⟨i, j, hij, a, rfl⟩

/-- Every generator is a commutator of elementary matrices when a spare index exists. -/
lemma unit_mem_commutator (i j k : n) (hij : i ≠ j) (hik : i ≠ k) (hkj : k ≠ j)
    (a : R) : unit i j hij a ∈ ⁅subgroup n R, subgroup n R⁆ := by
  have h := Subgroup.commutator_mem_commutator
    (unit_mem_subgroup i k hik a) (unit_mem_subgroup k j hkj (1 : R))
  rw [unit_commutator i k j hik hkj hij, mul_one] at h
  exact h

/-- Perfectness of the elementary subgroup, with the precise index hypothesis. -/
theorem subgroup_isPerfect
    (hthird : ∀ i j : n, i ≠ j → ∃ k : n, i ≠ k ∧ k ≠ j) :
    Group.IsPerfect (subgroup n R) := by
  apply Subgroup.isPerfect_iff.mpr
  apply le_antisymm (Subgroup.commutator_le_of_le le_rfl le_rfl)
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, j, hij, a, rfl⟩
  obtain ⟨k, hik, hkj⟩ := hthird i j hij
  exact unit_mem_commutator i j k hij hik hkj a

section RingMap

variable {S : Type*} [Ring S] {T : Type*} [Ring T]

/-- Entrywise change of rings on the actual matrix units. -/
def map (f : R →+* S) : (Matrix n n R)ˣ →* (Matrix n n S)ˣ :=
  Units.map (RingHom.mapMatrix f).toMonoidHom

@[simp] lemma map_unit (f : R →+* S) (i j : n) (hij : i ≠ j) (a : R) :
    map f (unit i j hij a) = unit i j hij (f a) := by
  apply Units.ext
  change (RingHom.mapMatrix f) (1 + Matrix.single i j a) =
    1 + Matrix.single i j (f a)
  rw [map_add, map_one]
  congr 1
  exact Matrix.map_single i j a f

@[simp] lemma map_id : map (n := n) (RingHom.id R) = MonoidHom.id _ := by
  ext g i j
  rfl

@[simp] lemma map_comp (f : R →+* S) (g : S →+* T) :
    map (n := n) (g.comp f) = (map g).comp (map f) := by
  ext x i j
  rfl

/-- Change of rings preserves the subgroup generated by elementary matrices. -/
lemma map_subgroup_le (f : R →+* S) :
    (subgroup n R).map (map f) ≤ subgroup n S := by
  rw [Subgroup.map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, j, hij, a, rfl⟩
  change map f (unit i j hij a) ∈ subgroup n S
  rw [map_unit]
  exact unit_mem_subgroup i j hij (f a)

end RingMap

end Quillen.ElementaryMatrix
