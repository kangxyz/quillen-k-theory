module

public import Mathlib.Algebra.Polynomial.Laurent
public import Mathlib.RingTheory.Localization.Away.AdjoinRoot

/-! # The original mixed diagonal evaluation into the Laurent ring

The polynomial variables map to the original Laurent coordinate and its inverse.
The actual evaluation is surjective with kernel generated by `C X * X - 1`, over every
commutative ring. The quotient isomorphism retains this literal ring map.
-/
@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
universe u
open Polynomial
namespace Quillen.PolynomialDiagonal
variable (R : Type u) [CommRing R]
/-- The actual mixed-coordinate evaluation, with variables sent to T and its inverse. -/
def mixedEvaluation : Polynomial (Polynomial R) →+* LaurentPolynomial R :=
  Polynomial.eval₂RingHom Polynomial.toLaurent (LaurentPolynomial.T (-1))
/-- The mixed relation presents the original Laurent ring. -/
def mixedQuotientIso :
    AdjoinRoot (C (X : Polynomial R) * X - 1) ≃ₐ[Polynomial R] LaurentPolynomial R := by
  letI := IsLocalization.adjoin_inv (X : Polynomial R)
  exact IsLocalization.algEquiv (Submonoid.powers (X : Polynomial R)) _ _
/-- The adjoined root maps to the original inverse Laurent coordinate. -/
theorem mixedQuotientIso_root :
    mixedQuotientIso R (AdjoinRoot.root (C (X : Polynomial R) * X - 1)) =
      LaurentPolynomial.T (-1) := by
  apply (IsUnit.mul_left_inj (LaurentPolynomial.isUnit_T (R := R) 1)).mp
  have h := congrArg (mixedQuotientIso R) (AdjoinRoot.root_isInv (X : Polynomial R))
  have hx : mixedQuotientIso R (AdjoinRoot.of (C (X : Polynomial R) * X - 1) X) =
      LaurentPolynomial.T 1 := by
    rw [← AdjoinRoot.algebraMap_eq, AlgEquiv.commutes,
      LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_X]
  rw [map_mul, map_one, hx] at h
  rw [mul_comm (mixedQuotientIso R _), mul_comm (LaurentPolynomial.T (-1)), h,
    ← LaurentPolynomial.T_add]
  norm_num
/-- The quotient presentation retains the literal mixed evaluation ring homomorphism. -/
theorem mixedEvaluation_eq :
    mixedEvaluation R = (mixedQuotientIso R).toRingHom.comp
      (AdjoinRoot.mk (C (X : Polynomial R) * X - 1)) := by
  apply Polynomial.ringHom_ext
  · intro p
    change Polynomial.eval₂ Polynomial.toLaurent (LaurentPolynomial.T (-1)) (C p) =
      mixedQuotientIso R
      (algebraMap (Polynomial R) (AdjoinRoot (C (X : Polynomial R) * X - 1)) p)
    rw [Polynomial.eval₂_C, AlgEquiv.commutes, LaurentPolynomial.algebraMap_eq_toLaurent]
  · simpa [mixedEvaluation] using (mixedQuotientIso_root R).symm
/-- The actual mixed evaluation is surjective. -/
theorem mixedEvaluation_surjective : Function.Surjective (mixedEvaluation R) := by
  rw [mixedEvaluation_eq]
  exact (mixedQuotientIso R).surjective.comp (Ideal.Quotient.mk_surjective)
/-- The actual kernel is the principal ideal of the mixed incidence equation. -/
theorem mixedEvaluation_ker : RingHom.ker (mixedEvaluation R) =
    Ideal.span {C (X : Polynomial R) * X - 1} := by
  rw [mixedEvaluation_eq]
  exact (RingHom.ker_comp_of_injective (AdjoinRoot.mk _)
    (f := (mixedQuotientIso R).toRingHom) (mixedQuotientIso R).injective).trans Ideal.mk_ker
end Quillen.PolynomialDiagonal
