module

public import Quillen.Aglib.LinearAlgebra.Matrix.GeneralLinearGroup.ElementaryStabilization
public import Quillen.Algebra.Group.StableGeneralLinear
public import Quillen.Aglib.LinearAlgebra.Matrix.BlockWhitehead
public import Quillen.Aglib.LinearAlgebra.Matrix.ElementaryReindex

/-!
# The stable elementary subgroup

The elementary subgroup of the genuine stable general linear group is generated
by the images of finite elementary matrices. A fresh index after stabilization
expresses every generator as a commutator of generators, proving perfectness
over an arbitrary ring. Whitehead's block factorization proves that this subgroup
is the full commutator subgroup, hence normal. Entrywise ring maps preserve it.
-/
@[expose] public section

universe u

noncomputable section

namespace Quillen.StableGeneralLinear

open scoped commutatorElement

variable (R : Type u) [Ring R]

/-- The subgroup generated by the actual stable elementary matrices. -/
def elementary : Subgroup (Group R) :=
  Subgroup.closure {g | ∃ (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R),
    g = of R n (ElementaryMatrix.unit i j hij a)}

lemma unit_mem_elementary (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    of R n (ElementaryMatrix.unit i j hij a) ∈ elementary R :=
  Subgroup.subset_closure ⟨n, i, j, hij, a, rfl⟩

/-- Finite elementary subgroups map into the stable elementary subgroup. -/
lemma of_elementary_le (n : ℕ) :
    (ElementaryMatrix.subgroup (Fin n) R).map (of R n) ≤ elementary R := by
  rw [Subgroup.map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, j, hij, a, rfl⟩
  exact unit_mem_elementary R n i j hij a

lemma of_mem_elementary {n : ℕ} {g : GL R n}
    (hg : g ∈ ElementaryMatrix.subgroup (Fin n) R) : of R n g ∈ elementary R :=
  of_elementary_le R n (Subgroup.mem_map_of_mem (of R n) hg)

lemma of_unit_succ (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    of R (n + 1) (ElementaryMatrix.unit i.castSucc j.castSucc (by simpa using hij) a) =
      of R n (ElementaryMatrix.unit i j hij a) := by
  rw [← step_unit]
  simpa only [transition_succ] using
    of_transition R (Nat.le_succ n) (ElementaryMatrix.unit i j hij a)

/-- A newly adjoined coordinate expresses any stable generator as an elementary commutator. -/
lemma unit_mem_elementary_commutator (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    of R n (ElementaryMatrix.unit i j hij a) ∈ ⁅elementary R, elementary R⁆ := by
  have hi : i.castSucc ≠ Fin.last n := Fin.castSucc_ne_last i
  have hj : Fin.last n ≠ j.castSucc := (Fin.castSucc_ne_last j).symm
  have hij' : i.castSucc ≠ j.castSucc := by simpa using hij
  have h := Subgroup.commutator_mem_commutator
    (unit_mem_elementary R (n + 1) i.castSucc (Fin.last n) hi a)
    (unit_mem_elementary R (n + 1) (Fin.last n) j.castSucc hj (1 : R))
  rw [← map_commutatorElement, ElementaryMatrix.unit_commutator
    i.castSucc (Fin.last n) j.castSucc hi hj hij', mul_one, of_unit_succ] at h
  exact h

/-- The stable elementary group is perfect for every ring, including the zero ring. -/
instance elementary_isPerfect : _root_.Group.IsPerfect (elementary R) := by
  apply Subgroup.isPerfect_iff.mpr
  apply le_antisymm (Subgroup.commutator_le_of_le le_rfl le_rfl)
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨n, i, j, hij, a, rfl⟩
  exact unit_mem_elementary_commutator R n i j hij a

/-- The elementary subgroup is contained in the stable commutator subgroup. -/
lemma elementary_le_commutator : elementary R ≤ commutator (Group R) := by
  rw [← Subgroup.commutator_eq_self (H := elementary R), commutator_def]
  exact Subgroup.commutator_mono le_top le_top

/-- The stable image of each finite-stage commutator is elementary. -/
lemma of_commutator_mem_elementary (n : ℕ) (g h : GL R n) :
    of R n ⁅g, h⁆ ∈ elementary R := by
  rw [← of_transition R (Nat.le_add_right n n) ⁅g, h⁆]
  apply of_mem_elementary
  rw [transition_eq_reindex_blockSum]
  exact ElementaryMatrix.reindex_subgroup_le finSumFinEquiv
    (Subgroup.mem_map_of_mem _ (ElementaryMatrix.blockSum_commutator_mem_subgroup g h))

/-- Every commutator in the stable general linear group is elementary. -/
lemma commutator_le_elementary : commutator (Group R) ≤ elementary R := by
  rw [commutator_def]
  apply Subgroup.commutator_le.mpr
  intro g _ h _
  obtain ⟨n, a, b, rfl, rfl⟩ := exists_of₂ R g h
  rw [← map_commutatorElement]
  exact of_commutator_mem_elementary R n a b

/-- Whitehead's lemma for the actual stable matrix group over an arbitrary ring. -/
theorem elementary_eq_commutator : elementary R = commutator (Group R) :=
  le_antisymm (elementary_le_commutator R) (commutator_le_elementary R)

instance elementary_normal : (elementary R).Normal := by
  rw [elementary_eq_commutator]
  infer_instance

/-- Every perfect subgroup of the stable matrix group lies in its elementary subgroup. -/
theorem perfect_le_elementary (H : Subgroup (Group R)) [_root_.Group.IsPerfect H] :
    H ≤ elementary R := by
  rw [← Subgroup.commutator_eq_self (H := H), elementary_eq_commutator, commutator_def]
  exact Subgroup.commutator_mono le_top le_top

section RingMap

variable {R} {S : Type*} [Ring S]

/-- Every ring homomorphism preserves the actual stable elementary subgroup. -/
lemma map_elementary_le (f : R →+* S) :
    (elementary R).map (map f) ≤ elementary S := by
  rw [Subgroup.map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨n, i, j, hij, a, rfl⟩
  change map f (of R n (ElementaryMatrix.unit i j hij a)) ∈ elementary S
  rw [map_of]
  change of S n (ElementaryMatrix.map f (ElementaryMatrix.unit i j hij a)) ∈ elementary S
  rw [ElementaryMatrix.map_unit]
  exact unit_mem_elementary S n i j hij (f a)

end RingMap

end Quillen.StableGeneralLinear
