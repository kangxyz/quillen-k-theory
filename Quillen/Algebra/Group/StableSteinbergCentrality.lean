module

public import Quillen.Algebra.Group.StableSteinberg
public import Mathlib.GroupTheory.NoncommPiCoprod
public import Mathlib.GroupTheory.Subgroup.Center

/-!
# Centrality of the actual stable Steinberg kernel

`ker_toElementary_le_center` proves that the kernel of the original map onto
the actual stable elementary subgroup is central. Every presented word lies
in a finite-stage root subgroup. Fresh-column and fresh-row products transform
under conjugation by its literal finite matrix and the inverse row action.
Injectivity of the finite-stage stable-GL map makes both actions trivial on
the kernel; the original fresh-index chain relation then centralizes every root.

The proof uses only this finite-rank-labelled presentation and its original
matrix map. All fields, including the fields with two or three elements, are
included. No universal central extension property or Quillen K2 comparison
is asserted.
-/
@[expose] public noncomputable section

universe u

namespace Quillen.StableSteinberg

open scoped commutatorElement Matrix

variable (F : Type u) [Field F]

/-- The subgroup generated by the roots at one actual finite rank. -/
def stage (n : ℕ) : Subgroup (Group F) :=
  Subgroup.closure {g | ∃ (i j : Fin n) (hij : i ≠ j) (a : F),
    g = x F n i j hij a}

/-- Every root of a finite rank lies in its stage subgroup. -/
lemma x_mem_stage (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : F) :
    x F n i j hij a ∈ stage F n :=
  Subgroup.subset_closure ⟨i, j, hij, a, rfl⟩

/-- The defining stabilization relation makes successive stage subgroups nested. -/
lemma stage_le_succ (n : ℕ) : stage F n ≤ stage F (n + 1) := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, j, hij, a, rfl⟩
  rw [x_stabilize]
  exact x_mem_stage F (n + 1) i.castSucc j.castSucc (by simpa using hij) a

/-- Stage subgroups are nested under every rank increase. -/
lemma stage_mono {n m : ℕ} (h : n ≤ m) : stage F n ≤ stage F m := by
  induction h using Nat.leRec with
  | refl => exact le_rfl
  | @le_succ_of_le m h ih => exact ih.trans (stage_le_succ F m)

/-- Every presented group element is contained in some actual finite-rank root subgroup. -/
lemma exists_stage (g : Group F) : ∃ n, g ∈ stage F n := by
  let H : Subgroup (Group F) := {
    carrier := {g | ∃ n, g ∈ stage F n}
    one_mem' := ⟨0, (stage F 0).one_mem⟩
    mul_mem' := by
      rintro a b ⟨n, hn⟩ ⟨m, hm⟩
      exact ⟨max n m, (stage F (max n m)).mul_mem
        (stage_mono F (Nat.le_max_left n m) hn)
        (stage_mono F (Nat.le_max_right n m) hm)⟩
    inv_mem' := by
      rintro a ⟨n, hn⟩
      exact ⟨n, (stage F n).inv_mem hn⟩ }
  apply PresentedGroup.generated_by (relations F) H _ g
  rintro ⟨n, i, j, hij, a⟩
  exact ⟨n, x_mem_stage F n i j hij a⟩

/-- The additive coefficient homomorphism of one original root subgroup. -/
def rootCoefficientHom (n : ℕ) (i j : Fin n) (hij : i ≠ j) :
    F →+ Additive (Group F) where
  toFun a := Additive.ofMul (x F n i j hij a)
  map_zero' := x_zero F n i j hij
  map_add' a b := (x_add F n i j hij a b).symm

/-- The canonical product of the commuting roots in a newly adjoined column. -/
def freshColumnHom (n : ℕ) : (Fin n → F) →+ Additive (Group F) :=
  AddMonoidHom.noncommPiCoprod
    (fun i => rootCoefficientHom F (n + 1) i.castSucc (Fin.last n) (Fin.castSucc_ne_last i))
    (fun i j _ a b => by
      change Commute (x F (n + 1) i.castSucc (Fin.last n) _ a)
        (x F (n + 1) j.castSucc (Fin.last n) _ b)
      exact x_commute F (n + 1) i.castSucc (Fin.last n) j.castSucc (Fin.last n)
        (Fin.castSucc_ne_last i) (Fin.castSucc_ne_last j)
        (Fin.castSucc_ne_last j).symm (Fin.castSucc_ne_last i).symm a b)

/-- The canonical product of the commuting roots in a newly adjoined row. -/
def freshRowHom (n : ℕ) : (Fin n → F) →+ Additive (Group F) :=
  AddMonoidHom.noncommPiCoprod
    (fun i => rootCoefficientHom F (n + 1) (Fin.last n) i.castSucc (Fin.castSucc_ne_last i).symm)
    (fun i j _ a b => by
      change Commute (x F (n + 1) (Fin.last n) i.castSucc _ a)
        (x F (n + 1) (Fin.last n) j.castSucc _ b)
      exact x_commute F (n + 1) (Fin.last n) i.castSucc (Fin.last n) j.castSucc
        (Fin.castSucc_ne_last i).symm (Fin.castSucc_ne_last j).symm
        (Fin.castSucc_ne_last i) (Fin.castSucc_ne_last j) a b)

/-- The original root product representing a vector in the fresh last column. -/
def columnWord (n : ℕ) (v : Fin n → F) : Group F := (freshColumnHom F n v).toMul
/-- The original root product representing a vector in the fresh last row. -/
def rowWord (n : ℕ) (v : Fin n → F) : Group F := (freshRowHom F n v).toMul

/-- A coordinate vector gives its original fresh-column root. -/
lemma columnWord_single (n : ℕ) (i : Fin n) (a : F) :
    columnWord F n (Pi.single i a) =
      x F (n + 1) i.castSucc (Fin.last n) (Fin.castSucc_ne_last i) a := by
  unfold columnWord freshColumnHom
  erw [AddMonoidHom.noncommPiCoprod_single]
  rfl

/-- A coordinate vector gives its original fresh-row root. -/
lemma rowWord_single (n : ℕ) (i : Fin n) (a : F) :
    rowWord F n (Pi.single i a) =
      x F (n + 1) (Fin.last n) i.castSucc (Fin.castSucc_ne_last i).symm a := by
  unfold rowWord freshRowHom
  erw [AddMonoidHom.noncommPiCoprod_single]
  rfl

/-- Vector addition is multiplication of fresh-column root products. -/
lemma columnWord_add (n : ℕ) (v w : Fin n → F) :
    columnWord F n (v + w) = columnWord F n v * columnWord F n w := by
  unfold columnWord
  rw [map_add]
  rfl

/-- Vector addition is multiplication of fresh-row root products. -/
lemma rowWord_add (n : ℕ) (v w : Fin n → F) :
    rowWord F n (v + w) = rowWord F n v * rowWord F n w := by
  unfold rowWord
  rw [map_add]
  rfl

private def conjAddHom (g : Group F) : Additive (Group F) →+ Additive (Group F) where
  toFun a := Additive.ofMul (g * a.toMul * g⁻¹)
  map_zero' := by simp
  map_add' a b := by
    change g * (a.toMul * b.toMul) * g⁻¹ =
      g * a.toMul * g⁻¹ * (g * b.toMul * g⁻¹)
    simp [mul_assoc]

private def mulVecAddHom {n : ℕ} (A : Matrix (Fin n) (Fin n) F) :
    (Fin n → F) →+ (Fin n → F) where
  toFun v := A *ᵥ v
  map_zero' := Matrix.mulVec_zero A
  map_add' v w := Matrix.mulVec_add A v w

private def vecMulAddHom {n : ℕ} (A : Matrix (Fin n) (Fin n) F) :
    (Fin n → F) →+ (Fin n → F) where
  toFun v := v ᵥ* A
  map_zero' := Matrix.zero_vecMul A
  map_add' v w := Matrix.add_vecMul A v w


/-- The zero vector gives the identity fresh-column product. -/
lemma columnWord_zero (n : ℕ) : columnWord F n 0 = 1 := by
  unfold columnWord
  rw [map_zero]
  rfl

/-- The zero vector gives the identity fresh-row product. -/
lemma rowWord_zero (n : ℕ) : rowWord F n 0 = 1 := by
  unfold rowWord
  rw [map_zero]
  rfl

private lemma root_neg (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : F) :
    x F n i j hij (-a) = (x F n i j hij a)⁻¹ :=
  congrArg Additive.toMul (map_neg (rootCoefficientHom F n i j hij) a)

private lemma elementary_mulVec {n : ℕ} (i j : Fin n) (hij : i ≠ j)
    (a : F) (v : Fin n → F) :
    (ElementaryMatrix.unit i j hij a).val *ᵥ v = Pi.single i (a * v j) + v := by
  rw [ElementaryMatrix.unit_val, ElementaryMatrix.matrix, Matrix.add_mulVec,
    Matrix.one_mulVec, Matrix.single_mulVec, add_comm]
  rfl

private lemma elementary_vecMul {n : ℕ} (i j : Fin n) (hij : i ≠ j)
    (a : F) (v : Fin n → F) :
    v ᵥ* (ElementaryMatrix.unit i j hij a).val = Pi.single j (v i * a) + v := by
  rw [ElementaryMatrix.unit_val, ElementaryMatrix.matrix, Matrix.vecMul_add,
    Matrix.vecMul_one, add_comm]
  congr 1
  ext k
  by_cases hk : k = j
  · subst k
    simp [Matrix.vecMul, dotProduct, Matrix.single]
  · simp [Matrix.vecMul, dotProduct, Matrix.single, hk, (Ne.symm hk)]

private lemma generator_conj_column (n : ℕ) (i j : Fin n) (hij : i ≠ j)
    (a : F) (v : Fin n → F) :
    x F n i j hij a * columnWord F n v * (x F n i j hij a)⁻¹ =
      columnWord F n ((ElementaryMatrix.unit i j hij a).val *ᵥ v) := by
  have h : (conjAddHom F (x F n i j hij a)).comp (freshColumnHom F n) =
      (freshColumnHom F n).comp
        (mulVecAddHom F (ElementaryMatrix.unit i j hij a).val) := by
    apply AddMonoidHom.pi_ext
    intro k b
    change x F n i j hij a * columnWord F n (Pi.single k b) * (x F n i j hij a)⁻¹ =
      columnWord F n ((ElementaryMatrix.unit i j hij a).val *ᵥ Pi.single k b)
    by_cases hk : k = j
    · subst k
      rw [elementary_mulVec, Pi.single_eq_same, columnWord_add,
        columnWord_single, columnWord_single]
      simp only [x_stabilize F n i j hij a]
      change MulAut.conj (x F (n + 1) i.castSucc j.castSucc (by simpa using hij) a)
        (x F (n + 1) j.castSucc (Fin.last n) _ b) = _
      rw [conj_eq_commutatorElement_mul, x_commutator]
    · rw [elementary_mulVec]
      simp only [Pi.single_eq_of_ne (Ne.symm hk), mul_zero, Pi.single_zero, zero_add]
      rw [columnWord_single]
      simp only [x_stabilize F n i j hij a]
      have hc := x_commute F (n + 1) i.castSucc j.castSucc k.castSucc (Fin.last n)
        (by simpa using hij) (Fin.castSucc_ne_last k) (by simpa using (Ne.symm hk))
        (Fin.castSucc_ne_last i).symm a b
      rw [hc.eq, mul_inv_cancel_right]
  exact congrArg Additive.toMul (DFunLike.congr_fun h v)

private lemma generator_conj_row (n : ℕ) (i j : Fin n) (hij : i ≠ j)
    (a : F) (v : Fin n → F) :
    x F n i j hij a * rowWord F n v * (x F n i j hij a)⁻¹ =
      rowWord F n (v ᵥ* (ElementaryMatrix.unit i j hij a)⁻¹.val) := by
  have h : (conjAddHom F (x F n i j hij a)).comp (freshRowHom F n) =
      (freshRowHom F n).comp (vecMulAddHom F (ElementaryMatrix.unit i j hij a)⁻¹.val) := by
    apply AddMonoidHom.pi_ext
    intro k b
    change x F n i j hij a * rowWord F n (Pi.single k b) * (x F n i j hij a)⁻¹ =
      rowWord F n (Pi.single k b ᵥ* (ElementaryMatrix.unit i j hij a)⁻¹.val)
    rw [ElementaryMatrix.unit_inv, elementary_vecMul]
    by_cases hk : k = i
    · subst k
      rw [Pi.single_eq_same, mul_neg, rowWord_add, rowWord_single, rowWord_single]
      simp only [x_stabilize F n i j hij a]
      change MulAut.conj (x F (n + 1) i.castSucc j.castSucc (by simpa using hij) a)
        (x F (n + 1) (Fin.last n) i.castSucc _ b) = _
      rw [conj_eq_commutatorElement_mul, ← commutatorElement_inv, x_commutator,
        ← root_neg]
    · simp only [Pi.single_eq_of_ne (Ne.symm hk), zero_mul, Pi.single_zero, zero_add]
      rw [rowWord_single]
      simp only [x_stabilize F n i j hij a]
      have hc := x_commute F (n + 1) i.castSucc j.castSucc (Fin.last n) k.castSucc
        (by simpa using hij) (Fin.castSucc_ne_last k).symm (Fin.castSucc_ne_last j)
        (by simpa using hk) a b
      rw [hc.eq, mul_inv_cancel_right]
  exact congrArg Additive.toMul (DFunLike.congr_fun h v)


/-- A finite-stage word acts on the original fresh-column and fresh-row products by its
literal finite matrix and the inverse row action, respectively. -/
lemma exists_stage_matrix_actions (n : ℕ) (g : Group F) (hg : g ∈ stage F n) :
    ∃ A : StableGeneralLinear.GL F n,
      toStableGeneralLinear F g = StableGeneralLinear.of F n A ∧
      (∀ v, g * columnWord F n v * g⁻¹ = columnWord F n (A.val *ᵥ v)) ∧
      (∀ v, g * rowWord F n v * g⁻¹ = rowWord F n (v ᵥ* (A⁻¹).val)) := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
      obtain ⟨i, j, hij, a, rfl⟩ := hg
      exact ⟨ElementaryMatrix.unit i j hij a, toStableGeneralLinear_x F n i j hij a,
        generator_conj_column F n i j hij a, generator_conj_row F n i j hij a⟩
  | one =>
      refine ⟨1, by simp, ?_, ?_⟩ <;> intro v <;> simp
  | mul g h _ _ ihg ihh =>
      obtain ⟨A, hA, hcA, hrA⟩ := ihg
      obtain ⟨B, hB, hcB, hrB⟩ := ihh
      refine ⟨A * B, ?_, ?_, ?_⟩
      · simp only [map_mul, hA, hB]
      · intro v
        calc
          (g * h) * columnWord F n v * (g * h)⁻¹ =
              g * (h * columnWord F n v * h⁻¹) * g⁻¹ := by simp [mul_assoc]
          _ = g * columnWord F n (B.val *ᵥ v) * g⁻¹ := by rw [hcB]
          _ = columnWord F n (A.val *ᵥ (B.val *ᵥ v)) := hcA _
          _ = columnWord F n ((A * B).val *ᵥ v) := by
            rw [Matrix.mulVec_mulVec]
            rfl
      · intro v
        calc
          (g * h) * rowWord F n v * (g * h)⁻¹ =
              g * (h * rowWord F n v * h⁻¹) * g⁻¹ := by simp [mul_assoc]
          _ = g * rowWord F n (v ᵥ* (B⁻¹).val) * g⁻¹ := by rw [hrB]
          _ = rowWord F n ((v ᵥ* (B⁻¹).val) ᵥ* (A⁻¹).val) := hrA _
          _ = rowWord F n (v ᵥ* ((A * B)⁻¹).val) := by
            rw [Matrix.vecMul_vecMul]
            rfl
  | inv g _ ih =>
      obtain ⟨A, hA, hcA, hrA⟩ := ih
      refine ⟨A⁻¹, ?_, ?_, ?_⟩
      · simp only [map_inv, hA]
      · intro v
        have hAA : A.val * (A⁻¹).val = 1 := A.val_inv
        have hc := hcA ((A⁻¹).val *ᵥ v)
        rw [Matrix.mulVec_mulVec, hAA, Matrix.one_mulVec] at hc
        simpa [mul_assoc] using congrArg (fun z => g⁻¹ * z * g) hc.symm
      · intro v
        have hAA : A.val * (A⁻¹).val = 1 := A.val_inv
        have hr := hrA (v ᵥ* A.val)
        rw [Matrix.vecMul_vecMul, hAA, Matrix.vecMul_one] at hr
        simpa [mul_assoc] using congrArg (fun z => g⁻¹ * z * g) hr.symm

private lemma commute_of_conj_eq {g h : Group F} (hgh : g * h * g⁻¹ = h) :
    Commute g h := by
  change g * h = h * g
  exact mul_inv_eq_iff_eq_mul.mp hgh

/-- A finite-stage element with trivial actual stable matrix commutes with its whole stage. -/
lemma kernel_commutes_stage (n : ℕ) (g : Group F) (hg : g ∈ stage F n)
    (hker : toStableGeneralLinear F g = 1) (h : Group F) (hh : h ∈ stage F n) :
    Commute g h := by
  obtain ⟨A, hA, hcA, hrA⟩ := exists_stage_matrix_actions F n g hg
  have hA1 : A = 1 := StableGeneralLinear.of_injective F n (by
    rw [← hA, map_one]
    exact hker)
  have hc (v : Fin n → F) : Commute g (columnWord F n v) :=
    commute_of_conj_eq F (by simpa only [hA1, Units.val_one, Matrix.one_mulVec] using hcA v)
  have hr (v : Fin n → F) : Commute g (rowWord F n v) :=
    commute_of_conj_eq F (by
      simpa only [hA1, inv_one, Units.val_one, Matrix.vecMul_one] using hrA v)
  induction hh using Subgroup.closure_induction with
  | mem h hh =>
      obtain ⟨i, j, hij, a, rfl⟩ := hh
      rw [x_eq_commutator_succ, commutatorElement_def]
      have hci := hc (Pi.single i a)
      rw [columnWord_single] at hci
      have hrj := hr (Pi.single j 1)
      rw [rowWord_single] at hrj
      exact ((hci.mul_right hrj).mul_right hci.inv_right).mul_right hrj.inv_right
  | one => exact Commute.one_right g
  | mul h k _ _ ihh ihk => exact ihh.mul_right ihk
  | inv h _ ih => exact ih.inv_right

/-- The kernel of the original stable-matrix homomorphism is central in this presentation. -/
theorem ker_toStableGeneralLinear_le_center :
    (toStableGeneralLinear F).ker ≤ Subgroup.center (Group F) := by
  intro g hg
  apply Subgroup.mem_center_iff.mpr
  intro h
  obtain ⟨n, hn⟩ := exists_stage F g
  obtain ⟨m, hm⟩ := exists_stage F h
  exact (kernel_commutes_stage F (max n m) g
    (stage_mono F (Nat.le_max_left n m) hn) hg h
    (stage_mono F (Nat.le_max_right n m) hm)).symm.eq

/-- Faithful inclusion of the actual elementary subgroup preserves the original kernel. -/
lemma ker_toElementary_eq : (toElementary F).ker = (toStableGeneralLinear F).ker := by
  ext g
  change toElementary F g = 1 ↔ toStableGeneralLinear F g = 1
  constructor
  · intro h
    exact congrArg (fun z : StableGeneralLinear.elementary F =>
      (z : StableGeneralLinear.Group F)) h
  · intro h
    exact Subtype.ext h

/-- The kernel of the original map onto the actual stable elementary subgroup is central. -/
theorem ker_toElementary_le_center :
    (toElementary F).ker ≤ Subgroup.center (Group F) := by
  rw [ker_toElementary_eq]
  exact ker_toStableGeneralLinear_le_center F

end Quillen.StableSteinberg
