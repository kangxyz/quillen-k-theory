module

public import Quillen.Algebra.Group.StableSteinbergBruhat

/-!
# Generation of the actual stable Steinberg kernel by ordered defects

For every field F, including F2 and F3, the subgroup generated by the original
ordered defects `h(a) h(b) h(ab)⁻¹` equals the kernel of the original `toElementary`.
`milnorToKernel_surjective` proves surjectivity of the existing Aglib-based map
with its original ordered pair formula. Its injectivity is a separate question.

The proof retains the actual finite-rank root words and stabilization. The source
coverage `B * V * B` from `StableSteinbergBruhat` is followed by finite matrix
detection: B preserves the last-row line, while a V element preserving that line
has zero row vector. For a kernel word in B, the last diagonal entry forces its
pivot-torus parameter to be one. The original parabolic kernel theorem therefore
gives `stage_succ_kernel_descent`. Finite-stage induction and the existing actual
finite-word containment finish generation.

No injectivity of an unstable Steinberg-stage embedding, additional generation
hypothesis, Matsumoto record, or field-size cutoff is used. No comparison with
Quillen products or claim about perfection of the completion fiber is made.
-/
@[expose] public section

noncomputable section
universe u

namespace Quillen.StableSteinberg.KernelGeneration.LineDetection
open Parabolic RootRelocation TorusParabolic RowColumnClosure
open scoped Matrix
variable (F : Type u) [Field F]

/-- The final coordinate row vector at the actual finite rank. -/
def lastVector (n : ℕ) : Fin (n + 1) → F := Pi.single (Fin.last n) 1

/-- The finite invertible matrices fixing the final coordinate row vector. -/
def fixedLast (n : ℕ) : Subgroup (StableGeneralLinear.GL F (n + 1)) where
  carrier := {A | lastVector F n ᵥ* A.val = lastVector F n}
  one_mem' := by simp
  mul_mem' := by
    intro A B hA hB
    change lastVector F n ᵥ* (A.val * B.val) = _
    rw [← Matrix.vecMul_vecMul, hA, hB]
  inv_mem' := by
    intro A hA
    have hh := congrArg (fun v => v ᵥ* (A⁻¹).val) hA
    rw [Matrix.vecMul_vecMul] at hh
    have hAA : A.val * (A⁻¹).val = 1 := A.val_inv
    rw [hAA, Matrix.vecMul_one] at hh
    exact hh.symm

/-- The finite invertible matrices preserving the final coordinate row line. -/
def lastLine (n : ℕ) : Subgroup (StableGeneralLinear.GL F (n + 1)) where
  carrier := {A | ∃ a : Fˣ, lastVector F n ᵥ* A.val = (a : F) • lastVector F n}
  one_mem' := ⟨1, by simp⟩
  mul_mem' := by
    rintro A B ⟨a, ha⟩ ⟨b, hb⟩
    refine ⟨a * b, ?_⟩
    change lastVector F n ᵥ* (A.val * B.val) = _
    rw [← Matrix.vecMul_vecMul, ha, Matrix.smul_vecMul, hb, smul_smul, Units.val_mul]
  inv_mem' := by
    rintro A ⟨a, ha⟩
    refine ⟨a⁻¹, ?_⟩
    have hAA : A.val * (A⁻¹).val = 1 := A.val_inv
    calc
      _ = ((a⁻¹ : Fˣ) : F) • (((a : F) • lastVector F n) ᵥ* (A⁻¹).val) := by
        rw [Matrix.smul_vecMul, smul_smul]
        simp
      _ = ((a⁻¹ : Fˣ) : F) • ((lastVector F n ᵥ* A.val) ᵥ* (A⁻¹).val) := by rw [ha]
      _ = _ := by rw [Matrix.vecMul_vecMul, hAA, Matrix.vecMul_one]

lemma fixedLast_le_lastLine (n : ℕ) : fixedLast F n ≤ lastLine F n := by
  intro A hA
  refine ⟨1, ?_⟩
  change lastVector F n ᵥ* A.val = lastVector F n at hA
  simpa only [Units.val_one, one_smul] using hA

lemma unit_mem_fixedLast (n : ℕ) (i j : Fin (n + 1)) (hij : i ≠ j)
    (hi : i ≠ Fin.last n) (t : F) : ElementaryMatrix.unit i j hij t ∈ fixedLast F n := by
  change lastVector F n ᵥ* (ElementaryMatrix.unit i j hij t).val = _
  rw [ElementaryMatrix.unit_val, ElementaryMatrix.matrix, Matrix.vecMul_add, Matrix.vecMul_one]
  have hz : lastVector F n ᵥ* Matrix.single i j t = 0 := by
    rw [lastVector, Matrix.single_vecMul]
    ext k
    simp [Matrix.single, hi]
  rw [hz, add_zero]

/-- The image of the finite last-row stabilizer in the original stable GL group. -/
def stableFixedLast (n : ℕ) : Subgroup (StableGeneralLinear.Group F) :=
  (fixedLast F n).map (StableGeneralLinear.of F (n + 1))

/-- The image of the finite last-row line stabilizer in the original stable GL group. -/
def stableLastLine (n : ℕ) : Subgroup (StableGeneralLinear.Group F) :=
  (lastLine F n).map (StableGeneralLinear.of F (n + 1))

lemma parabolic_image_fixes_last (n : ℕ) :
    upperParabolic F n ≤ (stableFixedLast F n).comap (toStableGeneralLinear F) := by
  rw [upperParabolic_eq_rootSpan]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, j, hij, hi, t, rfl⟩
  exact ⟨ElementaryMatrix.unit i j hij t, unit_mem_fixedLast F n i j hij hi t,
    (toStableGeneralLinear_x F (n + 1) i j hij t).symm⟩

/-- The original stable GL map descended through the original defect quotient. -/
def quotientStable : DefectQuotient F →* StableGeneralLinear.Group F :=
  (StableGeneralLinear.elementary F).subtype.comp (quotientToElementary F)

lemma quotientStable_mk (g : Group F) :
    quotientStable F ((QuotientGroup.mk' (defectSubgroup F)) g) = toStableGeneralLinear F g := rfl

lemma pivotTorus_lastVector (n : ℕ) (hn : 1 ≤ n) (a : Fˣ) :
    lastVector F n ᵥ*
      (pairHGL F (n + 1) ⟨0, by omega⟩ (Fin.last n) (Fin.ne_of_val_ne (by simp; omega)) a).val =
        ((a⁻¹ : Fˣ) : F) • lastVector F n := by
  change Pi.single (Fin.last n) (1 : F) ᵥ* _ =
    ((a⁻¹ : Fˣ) : F) • Pi.single (Fin.last n) (1 : F)
  rw [← Pi.single_smul, smul_eq_mul, mul_one, pairHGL_val, Matrix.single_vecMul_diagonal,
    one_mul]
  congr 1
  unfold pairScale
  have hlast : (Fin.last n) ≠ (⟨0, by omega⟩ : Fin (n + 1)) :=
    Fin.ne_of_val_ne (by simp; omega)
  rw [ite_eq_right hlast, ite_eq_left rfl]

lemma quotientStable_pivotTorus (n : ℕ) (hn : 1 ≤ n) (a : Fˣ) :
    quotientStable F (pivotTorusHom F n hn a) =
      StableGeneralLinear.of F (n + 1)
        (pairHGL F (n + 1) ⟨0, by omega⟩ (Fin.last n)
          (Fin.ne_of_val_ne (by simp; omega)) a) := by
  change quotientStable F ((QuotientGroup.mk' (defectSubgroup F))
    (pairH F (n + 1) ⟨0, by omega⟩ (Fin.last n)
      (Fin.ne_of_val_ne (by simp; omega)) a)) = _
  rw [quotientStable_mk, pairH_image]

lemma fullParabolic_image_lastLine (n : ℕ) (hn : 1 ≤ n) :
    fullParabolic F n hn ≤ (stableLastLine F n).comap (quotientStable F) := by
  intro z hz
  obtain ⟨a, p, hp, heq⟩ := (mem_fullParabolic F n hn z).mp hz
  change quotientStable F z ∈ stableLastLine F n
  rw [heq, map_mul]
  apply (stableLastLine F n).mul_mem
  · rw [quotientStable_pivotTorus]
    exact Subgroup.mem_map_of_mem (StableGeneralLinear.of F (n + 1))
      (show pairHGL F (n + 1) ⟨0, by omega⟩ (Fin.last n)
        (Fin.ne_of_val_ne (by simp; omega)) a ∈ lastLine F n from
          ⟨a⁻¹, pivotTorus_lastVector F n hn a⟩)
  · rw [quotientStable_mk]
    obtain ⟨A, hA, he⟩ := parabolic_image_fixes_last F n hp
    exact ⟨A, fixedLast_le_lastLine F n hA, he⟩

private def rowN (n : ℕ) (v : Fin n → F) : Matrix (Fin (n + 1)) (Fin (n + 1)) F :=
  ∑ i : Fin n, Matrix.single (Fin.last n) i.castSucc (v i)

private lemma rowN_add (n : ℕ) (v w : Fin n → F) :
    rowN F n (v + w) = rowN F n v + rowN F n w := by
  simp [rowN, Matrix.single_add, Finset.sum_add_distrib]

private lemma rowN_zero (n : ℕ) : rowN F n 0 = 0 := by simp [rowN]

private lemma rowN_mul (n : ℕ) (v w : Fin n → F) : rowN F n v * rowN F n w = 0 := by
  simp only [rowN, Finset.sum_mul, Finset.mul_sum]
  apply Finset.sum_eq_zero
  intro i _
  apply Finset.sum_eq_zero
  intro j _
  exact Matrix.single_mul_single_of_ne (l := Fin (n + 1)) (m := Fin (n + 1))
    (n := Fin (n + 1)) (v j) (Fin.last n) j.castSucc (Fin.last n) (Fin.castSucc_ne_last j) (w i)

private lemma rowN_single (n : ℕ) (i : Fin n) (a : F) :
    rowN F n (Pi.single i a) = Matrix.single (Fin.last n) i.castSucc a := by
  simp [rowN, Pi.single_apply, apply_ite]

private lemma rowN_last_row (n : ℕ) (v : Fin n → F) (i : Fin n) :
    rowN F n v (Fin.last n) i.castSucc = v i := by
  simp [rowN, Matrix.single, Matrix.sum_apply, eq_comm]

private lemma rowMatrix_mul (n : ℕ) (v w : Fin n → F) :
    (1 + rowN F n v) * (1 + rowN F n w) = 1 + rowN F n (v + w) := by
  rw [add_mul, mul_add, mul_add, one_mul, one_mul, mul_one, rowN_mul, add_zero, rowN_add]
  abel

private def rowGL (n : ℕ) (v : Fin n → F) : StableGeneralLinear.GL F (n + 1) where
  val := 1 + rowN F n v
  inv := 1 + rowN F n (-v)
  val_inv := by rw [rowMatrix_mul, add_neg_cancel, rowN_zero, add_zero]
  inv_val := by rw [rowMatrix_mul, neg_add_cancel, rowN_zero, add_zero]

private def rowGLHom (n : ℕ) : (Fin n → F) →+ Additive (StableGeneralLinear.GL F (n + 1)) where
  toFun v := Additive.ofMul (rowGL F n v)
  map_zero' := by
    change rowGL F n 0 = 1
    apply Units.ext
    simp [rowGL, rowN_zero]
  map_add' v w := by apply Units.ext; exact (rowMatrix_mul F n v w).symm

private lemma rowGL_single (n : ℕ) (i : Fin n) (a : F) :
    rowGL F n (Pi.single i a) =
      ElementaryMatrix.unit (Fin.last n) i.castSucc (Fin.castSucc_ne_last i).symm a := by
  apply Units.ext
  change 1 + rowN F n (Pi.single i a) = _
  rw [rowN_single]
  rfl

private lemma toStableGeneralLinear_rowWord (n : ℕ) (v : Fin n → F) :
    toStableGeneralLinear F (rowWord F n v) = StableGeneralLinear.of F (n + 1) (rowGL F n v) := by
  have hh : (toStableGeneralLinear F).toAdditive.comp (freshRowHom F n) =
      (StableGeneralLinear.of F (n + 1)).toAdditive.comp (rowGLHom F n) := by
    apply AddMonoidHom.pi_ext
    intro i a
    change toStableGeneralLinear F (rowWord F n (Pi.single i a)) =
      StableGeneralLinear.of F (n + 1) (rowGL F n (Pi.single i a))
    rw [rowWord_single, toStableGeneralLinear_x, rowGL_single]
  exact congrArg Additive.toMul (congrArg (fun k => k v) hh)

lemma rowImage_eq_one_of_image_lastLine (n : ℕ) (z : DefectQuotient F)
    (hz : z ∈ rowImage F n) (hline : quotientStable F z ∈ stableLastLine F n) : z = 1 := by
  obtain ⟨v, rfl⟩ := (mem_rowImage F n z).mp hz
  obtain ⟨A, ⟨a, ha⟩, hA⟩ := hline
  have he : A = rowGL F n v := by
    apply StableGeneralLinear.of_injective F (n + 1)
    exact hA.trans (toStableGeneralLinear_rowWord F n v)
  rw [he] at ha
  have hv : v = 0 := by
    ext i
    have hh := congrArg (fun w : Fin (n + 1) → F => w i.castSucc) ha
    simp only [lastVector, Matrix.single_vecMul, one_smul] at hh
    change (1 + rowN F n v) (Fin.last n) i.castSucc = _ at hh
    simpa [Matrix.add_apply, rowN_last_row, Pi.single_apply, Matrix.one_apply,
      (Fin.castSucc_ne_last i).symm] using hh
  simp [qRow, hv, rowWord_zero]

theorem fullParabolic_kernel_descent (n : ℕ) (hn : 2 ≤ n) (g : Group F)
    (hg : (QuotientGroup.mk' (defectSubgroup F)) g ∈ fullParabolic F n (by omega))
    (hk : toElementary F g = 1) : g ∈ stage F n := by
  obtain ⟨a, p, hp, hq⟩ := (mem_fullParabolic F n (by omega) _).mp hg
  have him : toStableGeneralLinear F g = 1 := congrArg Subtype.val hk
  have hh := congrArg (quotientStable F) hq
  simp only [map_mul, quotientStable_mk, quotientStable_pivotTorus] at hh
  rw [him] at hh
  obtain ⟨A, hA, hAp⟩ := parabolic_image_fixes_last F n hp
  rw [← hAp, ← map_mul] at hh
  have hmat : (1 : StableGeneralLinear.GL F (n + 1)) =
      pairHGL F (n + 1) ⟨0, by omega⟩ (Fin.last n) (Fin.ne_of_val_ne (by simp; omega)) a * A := by
    apply StableGeneralLinear.of_injective F (n + 1)
    exact (map_one _).trans hh
  have hvec := congrArg (fun B : StableGeneralLinear.GL F (n + 1) => lastVector F n ᵥ* B.val) hmat
  change lastVector F n ᵥ* 1 = lastVector F n ᵥ* (_ * _) at hvec
  rw [Matrix.vecMul_one, ← Matrix.vecMul_vecMul, pivotTorus_lastVector F n (by omega) a,
    Matrix.smul_vecMul] at hvec
  change lastVector F n = ((a⁻¹ : Fˣ) : F) • (lastVector F n ᵥ* A.val) at hvec
  change lastVector F n ᵥ* A.val = lastVector F n at hA
  rw [hA] at hvec
  have ha : a = 1 := by
    have he := congrArg (fun v : Fin (n + 1) → F => v (Fin.last n)) hvec
    have hinv : ((a⁻¹ : Fˣ) : F) = 1 := by simpa [lastVector] using he.symm
    apply inv_eq_one.mp
    exact Units.ext hinv
  subst a
  rw [map_one, one_mul] at hq
  apply stage_kernel_descent_of_quotient_parabolic F n hn g hk
  exact ⟨p, hp, hq.symm⟩

end Quillen.StableSteinberg.KernelGeneration.LineDetection

namespace Quillen.StableSteinberg.KernelGeneration
open Parabolic TorusParabolic RowColumnClosure BruhatCoverage LineDetection
variable (F : Type u) [Field F]

/-- Genuine one-step descent for every original next-stage kernel word, including over F2/F3. -/
theorem stage_succ_kernel_descent (n : ℕ) (hn : 2 ≤ n) (g : Group F)
    (hg : g ∈ stage F (n + 1)) (hk : toElementary F g = 1) : g ∈ stage F n := by
  obtain ⟨b₁, hb₁, v, hv, b₂, hb₂, he⟩ := stage_quotient_BVB F n hn g hg
  have him : quotientStable F ((QuotientGroup.mk' (defectSubgroup F)) g) = 1 :=
    congrArg Subtype.val hk
  have hb₁' := fullParabolic_image_lastLine F n (by omega) hb₁
  have hb₂' := fullParabolic_image_lastLine F n (by omega) hb₂
  have hm : quotientStable F b₁ * quotientStable F v * quotientStable F b₂ = 1 := by
    have hh := congrArg (quotientStable F) he
    rw [him, map_mul, map_mul] at hh
    exact hh.symm
  have hv' : quotientStable F v = (quotientStable F b₁)⁻¹ * (quotientStable F b₂)⁻¹ := by
    have hh := congrArg (fun z => (quotientStable F b₁)⁻¹ * z * (quotientStable F b₂)⁻¹) hm
    simpa only [mul_assoc, inv_mul_cancel_left, mul_inv_cancel, mul_one, one_mul] using hh
  have hline : quotientStable F v ∈ stableLastLine F n := by
    rw [hv']
    exact (stableLastLine F n).mul_mem ((stableLastLine F n).inv_mem hb₁')
      ((stableLastLine F n).inv_mem hb₂')
  have hv1 := rowImage_eq_one_of_image_lastLine F n v hv hline
  apply fullParabolic_kernel_descent F n hn g _ hk
  rw [he, hv1, mul_one]
  exact (fullParabolic F n (by omega)).mul_mem hb₁ hb₂

/-- Every original finite-stage kernel word lies in the subgroup generated by the marked defects. -/
theorem finite_stage_kernel_mem_defects (n : ℕ) (hn : 2 ≤ n) (g : Group F)
    (hg : g ∈ stage F n) (hk : toElementary F g = 1) : g ∈ defectSubgroup F := by
  induction n, hn using Nat.le_induction generalizing g with
  | base => exact stage_two_kernel_mem_defectSubgroup hg hk
  | succ n hn ih => exact ih g (stage_succ_kernel_descent F n hn g hg hk) hk

/-- The original elementary kernel is generated by the original ordered torus defects. -/
theorem defectSubgroup_eq_kernel : defectSubgroup F = (toElementary F).ker := by
  apply (kernel_generation_iff_large_stage F 2).mpr
  intro n hn g hg hk
  exact finite_stage_kernel_mem_defects F n hn g hg hk

/-- Every element of the original kernel lies in the original rank-two stage. -/
theorem kernel_le_stage_two : (toElementary F).ker ≤ stage F 2 := by
  rw [← defectSubgroup_eq_kernel F]
  exact defectSubgroup_le_stage_two

/-- The existing marked Milnor map is surjective over every field. Injectivity is separate. -/
theorem milnorToKernel_surjective : Function.Surjective (milnorToKernel F) :=
  (milnorToKernel_surjective_iff F).mpr (defectSubgroup_eq_kernel F)

end Quillen.StableSteinberg.KernelGeneration
