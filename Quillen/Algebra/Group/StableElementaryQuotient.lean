module

public import Quillen.Algebra.Group.StableElementary
public import Mathlib.GroupTheory.Abelianization.Defs
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# The stable general linear group modulo elementary matrices

This module constructs the actual quotient `GL(R)/E(R)` and identifies it with
the abelianization of the stable general linear group using Whitehead's lemma.
The original quotient homomorphism has kernel exactly `E(R)`. Change of rings
induces quotient homomorphisms and commutes with the projections and the
abelianization comparison. No comparison with the Q-construction is asserted.
-/
@[expose] public section

noncomputable section

universe u

namespace Quillen.StableGeneralLinear

variable (R : Type u) [Ring R]

/-- The quotient by the actual subgroup generated by stable elementary matrices. -/
abbrev ElementaryQuotient := Group R ⧸ elementary R

/-- The original quotient projection. -/
def quotientMap : Group R →* ElementaryQuotient R := QuotientGroup.mk' (elementary R)

lemma quotientMap_surjective : Function.Surjective (quotientMap R) :=
  QuotientGroup.mk'_surjective (elementary R)

@[simp] theorem ker_quotientMap : (quotientMap R).ker = elementary R :=
  QuotientGroup.ker_mk' (elementary R)

@[simp] lemma quotientMap_eq_one (g : Group R) :
    quotientMap R g = 1 ↔ g ∈ elementary R :=
  QuotientGroup.eq_one_iff g

/-- Whitehead's equality identifies the quotient with the ordinary abelianization. -/
def quotientEquivAbelianization : ElementaryQuotient R ≃* Abelianization (Group R) :=
  QuotientGroup.quotientMulEquivOfEq (elementary_eq_commutator R)

@[simp] lemma quotientEquivAbelianization_quotientMap (g : Group R) :
    quotientEquivAbelianization R (quotientMap R g) = Abelianization.of g := rfl

@[simp] lemma quotientEquivAbelianization_comp_quotientMap :
    (quotientEquivAbelianization R :
        ElementaryQuotient R →* Abelianization (Group R)).comp (quotientMap R) =
      Abelianization.of := rfl

instance elementaryQuotientCommGroup : CommGroup (ElementaryQuotient R) where
  mul_comm a b := (quotientEquivAbelianization R).injective (by simp [map_mul, mul_comm])

/-- Maps out of the quotient are determined by their values on the original stable matrices. -/
@[ext] lemma quotient_hom_ext {H : Type*} [Monoid H]
    {f g : ElementaryQuotient R →* H}
    (h : ∀ x : Group R, f (quotientMap R x) = g (quotientMap R x)) : f = g := by
  apply MonoidHom.ext
  intro x
  obtain ⟨a, rfl⟩ := quotientMap_surjective R x
  exact h a

/-- Every homomorphism to a commutative group factors through the actual elementary quotient. -/
def quotientLift {H : Type*} [CommGroup H] (f : Group R →* H) :
    ElementaryQuotient R →* H :=
  (Abelianization.lift f).comp (quotientEquivAbelianization R).toMonoidHom

@[simp] lemma quotientLift_quotientMap {H : Type*} [CommGroup H]
    (f : Group R →* H) (g : Group R) :
    quotientLift R f (quotientMap R g) = f g := rfl

lemma quotientLift_unique {H : Type*} [CommGroup H] (f : Group R →* H)
    (g : ElementaryQuotient R →* H) (hg : g.comp (quotientMap R) = f) :
    g = quotientLift R f := by
  apply quotient_hom_ext
  intro x
  exact DFunLike.congr_fun hg x

section RingMap

variable {R} {S : Type*} [Ring S] {T : Type*} [Ring T]

/-- The quotient map induced by an arbitrary unital ring homomorphism. -/
def quotientRingMap (f : R →+* S) : ElementaryQuotient R →* ElementaryQuotient S :=
  QuotientGroup.map (elementary R) (elementary S) (map f)
    (Subgroup.map_le_iff_le_comap.mp (map_elementary_le f))

@[simp] lemma quotientRingMap_quotientMap (f : R →+* S) (g : Group R) :
    quotientRingMap f (quotientMap R g) = quotientMap S (map f g) := rfl

/-- The original projections form a natural transformation under change of rings. -/
lemma quotientMap_naturality (f : R →+* S) :
    (quotientRingMap f).comp (quotientMap R) = (quotientMap S).comp (map f) := rfl

@[simp] lemma quotientRingMap_id :
    quotientRingMap (RingHom.id R) = MonoidHom.id (ElementaryQuotient R) := by
  apply quotient_hom_ext
  intro x
  simp

@[simp] lemma quotientRingMap_comp (f : R →+* S) (g : S →+* T) :
    quotientRingMap (g.comp f) = (quotientRingMap g).comp (quotientRingMap f) := by
  apply quotient_hom_ext
  intro x
  simp

/-- The abelianization comparison retains the original ring-induced maps. -/
lemma quotientEquivAbelianization_naturality (f : R →+* S) :
    (quotientEquivAbelianization S).toMonoidHom.comp (quotientRingMap f) =
      (Abelianization.map (map f)).comp (quotientEquivAbelianization R).toMonoidHom := by
  apply quotient_hom_ext
  intro x
  rfl

end RingMap

end Quillen.StableGeneralLinear
