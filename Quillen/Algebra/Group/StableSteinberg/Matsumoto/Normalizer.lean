/-!
# Normalizer

Canonical provider for the accepted interfaces described in the sections below.

The declarations retain their original field, rank, central-kernel and explicit
transport hypotheses. Their current consumer is the finite Matsumoto normalizer,
Bruhat action, or conditional original-root detector construction.
-/

@[expose] public section

/-! ## RootCoordinateNormalizer -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- The actual permutation subgroup generated by torus translations and signed Weyl lifts. -/
def LiftedNormalizer (n : ℕ) : Subgroup (Equiv.Perm (NormalizerState F n)) :=
  Subgroup.closure (Set.range (torusLeft F n) ∪ Set.range (@liftedWeyl F _ n))

/-- The literal faithful torus inclusion into the generated permutation group. -/
def normalizerTorus (n : ℕ) : Torus F n →* LiftedNormalizer F n :=
  (torusLeft F n).codRestrict (LiftedNormalizer F n) fun h =>
    Subgroup.subset_closure (Or.inl ⟨h, rfl⟩)

lemma normalizerTorus_injective (n : ℕ) : Function.Injective (normalizerTorus F n) := by
  intro x y he
  exact torusLeft_injective F n (congrArg Subtype.val he)

/-- The actual lift of W_i(-1), retaining its nontrivial torus square. -/
def normalizerLambda {n : ℕ} (i : Fin n) : LiftedNormalizer F n :=
  ⟨liftedWeyl F i, Subgroup.subset_closure (Or.inr ⟨i, rfl⟩)⟩

lemma normalizerLambda_square {n : ℕ} (i : Fin n) :
    normalizerLambda F i * normalizerLambda F i = normalizerTorus F n (simple F i (-1)) := by
  apply Subtype.ext
  apply Equiv.ext
  intro s
  exact liftedWeyl_square F i s

lemma normalizerLambda_mul_torus {n : ℕ} (i : Fin n) (h : Torus F n) :
    normalizerLambda F i * normalizerTorus F n h =
      normalizerTorus F n (theta F i h) * normalizerLambda F i := by
  apply Subtype.ext
  apply Equiv.ext
  intro s
  apply Prod.ext
  · change theta F i ((h * s.1) * descentCarry F i s.2) =
      theta F i h * theta F i (s.1 * descentCarry F i s.2)
    simp [map_mul, mul_assoc]
  · rfl

/-- The original normalization W_i(a)=H_i(a)W_i(-1) inverse in the actual permutation group. -/
def normalizerW {n : ℕ} (i : Fin n) (a : Fˣ) : LiftedNormalizer F n :=
  normalizerTorus F n (simple F i a) * (normalizerLambda F i)⁻¹

lemma normalizerW_neg_one {n : ℕ} (i : Fin n) :
    normalizerW F i (-1) = normalizerLambda F i := by
  rw [normalizerW, ← normalizerLambda_square]
  simp [mul_assoc]

lemma normalizerW_one {n : ℕ} (i : Fin n) :
    normalizerW F i 1 = (normalizerLambda F i)⁻¹ := by
  simp [normalizerW]

/-- The source word H_i(a)=W_i(a)W_i(-1) holds literally. -/
theorem normalizerW_mul_neg_one {n : ℕ} (i : Fin n) (a : Fˣ) :
    normalizerW F i a * normalizerW F i (-1) = normalizerTorus F n (simple F i a) := by
  rw [normalizerW_neg_one, normalizerW]
  simp [mul_assoc]

lemma simple_inverse_parameter_neg {n : ℕ} (i : Fin n) (a : Fˣ) :
    simple F i (-a) = (simple F i a⁻¹)⁻¹ * simple F i (-1) := by
  apply (eq_inv_mul_iff_mul_eq).mpr
  rw [simple_mul, pair_inv_left, pair_self_neg, neg_zero]
  simp

/-- Negation inverts the actual normalized Weyl element, with the sign symbol retained. -/
theorem normalizerW_neg {n : ℕ} (i : Fin n) (a : Fˣ) :
    normalizerW F i (-a) = (normalizerW F i a)⁻¹ := by
  rw [normalizerW, normalizerW, _root_.mul_inv_rev, inv_inv, simple_inverse_parameter_neg,
    map_mul, map_inv, ← normalizerLambda_square]
  have he := normalizerLambda_mul_torus F i ((simple F i a)⁻¹)
  rw [map_inv, map_inv, theta_simple_self, map_inv] at he
  rw [he]
  group

/-- The two Weyl squares differ by inversion of H_i(-1); they are not identified. -/
theorem normalizerW_one_square {n : ℕ} (i : Fin n) :
    normalizerW F i 1 * normalizerW F i 1 =
      normalizerTorus F n ((simple F i (-1))⁻¹) := by
  rw [normalizerW_one, map_inv, ← normalizerLambda_square]
  simp [_root_.mul_inv_rev]

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateNormalizerRelations -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
open scoped commutatorElement
variable (F : Type u) [Field F]

/-- The two concrete families generate the actual permutation subgroup internally. -/
lemma normalizer_generated (n : ℕ) (S : Subgroup (LiftedNormalizer F n))
    (ht : ∀ h, normalizerTorus F n h ∈ S) (hw : ∀ i, normalizerLambda F i ∈ S) : S = ⊤ := by
  have hle : LiftedNormalizer F n ≤ S.map (LiftedNormalizer F n).subtype := by
    apply (Subgroup.closure_le _).mpr
    rintro g (⟨h, rfl⟩ | ⟨i, rfl⟩)
    · exact ⟨normalizerTorus F n h, ht h, rfl⟩
    · exact ⟨normalizerLambda F i, hw i, rfl⟩
  apply top_unique
  intro x _
  obtain ⟨y, hy, he⟩ := hle x.property
  have he' : y = x := Subtype.ext he
  change y ∈ S at hy
  exact he' ▸ hy

lemma normalizerLambda_commute {n : ℕ} (i j : Fin n) (hne : i ≠ j)
    (hij : i.val + 1 ≠ j.val) (hji : j.val + 1 ≠ i.val) :
    Commute (normalizerLambda F i) (normalizerLambda F j) := by
  change normalizerLambda F i * normalizerLambda F j =
    normalizerLambda F j * normalizerLambda F i
  apply Subtype.ext
  apply Equiv.ext
  intro s
  exact liftedWeyl_commute F i j hne hij hji s

lemma normalizerLambda_braid {n : ℕ} (i j : Fin n) (hij : i.val + 1 = j.val) :
    normalizerLambda F i * normalizerLambda F j * normalizerLambda F i =
      normalizerLambda F j * normalizerLambda F i * normalizerLambda F j := by
  apply Subtype.ext
  apply Equiv.ext
  intro s
  exact liftedWeyl_braid F i j hij s

/-- Disjoint normalized Weyl elements commute for all unit parameters. -/
theorem normalizerW_commute {n : ℕ} (i j : Fin n) (hne : i ≠ j)
    (hij : i.val + 1 ≠ j.val) (hji : j.val + 1 ≠ i.val) (a b : Fˣ) :
    Commute (normalizerW F i a) (normalizerW F j b) := by
  have htt := (simple_commute_distant F i j hne hij hji a b).map (normalizerTorus F n)
  have hwt : Commute (normalizerLambda F i) (normalizerTorus F n (simple F j b)) := by
    change normalizerLambda F i * normalizerTorus F n (simple F j b) = _
    rw [normalizerLambda_mul_torus, theta_simple_distant F i j hne hij hji]
  have htw : Commute (normalizerTorus F n (simple F i a)) (normalizerLambda F j) := by
    apply Commute.symm
    change normalizerLambda F j * normalizerTorus F n (simple F i a) = _
    rw [normalizerLambda_mul_torus, theta_simple_distant F j i hne.symm hji hij]
  have hww := normalizerLambda_commute F i j hne hij hji
  exact (htt.mul_right htw.inv_right).mul_left (hwt.inv_left.mul_right hww.inv_left.inv_right)

/-- The original parameter-one Weyl lifts satisfy the adjacent braid. -/
theorem normalizerW_one_braid {n : ℕ} (i j : Fin n) (hij : i.val + 1 = j.val) :
    normalizerW F i 1 * normalizerW F j 1 * normalizerW F i 1 =
      normalizerW F j 1 * normalizerW F i 1 * normalizerW F j 1 := by
  have he := congrArg Inv.inv (normalizerLambda_braid F i j hij)
  simpa only [normalizerW_one, _root_.mul_inv_rev, mul_assoc] using he

/-- The unchanged Milnor coefficient group inside the actual normalizer prototype. -/
def normalizerCoefficient (n : ℕ) : Multiplicative (MilnorK.K F 2) →* LiftedNormalizer F n :=
  (normalizerTorus F n).comp (coefficient F n)

lemma normalizerCoefficient_injective (n : ℕ) : Function.Injective (normalizerCoefficient F n) :=
  (normalizerTorus_injective F n).comp (coefficient_injective F n)

/-- Positive ordered marking in the constructed permutation group. -/
theorem normalizer_defect {n : ℕ} (i : Fin n) (a b : Fˣ) :
    normalizerTorus F n (simple F i a) * normalizerTorus F n (simple F i b) *
        (normalizerTorus F n (simple F i (a * b)))⁻¹ =
      normalizerCoefficient F n (Multiplicative.ofAdd (MilnorK.symbol ![a, b])) := by
  simpa only [normalizerCoefficient, MonoidHom.comp_apply, map_mul, map_inv] using
    congrArg (normalizerTorus F n) (simple_defect F i a b)

/-- Positive 01,02 commutator marking, using the shifted signed section. -/
theorem normalizer_01_02_commutator (a b : Fˣ) :
    ⁅normalizerTorus F 2 (simple F (0 : Fin 2) a), normalizerTorus F 2 (signedH02 F b)⁆ =
      normalizerCoefficient F 2 (Multiplicative.ofAdd (MilnorK.symbol ![a, b])) := by
  simpa only [normalizerCoefficient, MonoidHom.comp_apply,
    commutatorElement_def, map_mul, map_inv] using
    congrArg (normalizerTorus F 2) (signedH02_commutator F a b)

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateNormalizerProjection -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- State permutations whose second component is literal left multiplication. -/
def secondLinear (n : ℕ) : Subgroup (Equiv.Perm (NormalizerState F n)) where
  carrier := {g | ∀ s, (g s).2 = (g (1, 1)).2 * s.2}
  one_mem' := by intro s; simp
  mul_mem' := by
    intro g h hg hh s
    change (g (h s)).2 = (g (h (1, 1))).2 * s.2
    rw [hg (h s), hh s, hg (h (1, 1)), hh (1, 1)]
    simp [mul_assoc]
  inv_mem' := by
    intro g hg
    have hval (s : NormalizerState F n) :
        (g⁻¹ s).2 = ((g (1, 1)).2)⁻¹ * s.2 := by
      apply (eq_inv_mul_iff_mul_eq).mpr
      have he := hg (g⁻¹ s)
      simpa using he.symm
    intro s
    change (g⁻¹ s).2 = (g⁻¹ (1, 1)).2 * s.2
    rw [hval, hval]
    simp

lemma normalizer_le_secondLinear (n : ℕ) : LiftedNormalizer F n ≤ secondLinear F n := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨h, rfl⟩ | ⟨i, rfl⟩)
  · intro s
    change s.2 = 1 * s.2
    simp
  · intro s
    change simpleSwap i * s.2 = (simpleSwap i * 1) * s.2
    simp

/-- The actual permutation projection, read from the concrete action at the identity state. -/
def normalizerPermutation (n : ℕ) : LiftedNormalizer F n →* Equiv.Perm (Fin (n + 1)) where
  toFun g := (g.val (1, 1)).2
  map_one' := rfl
  map_mul' g h := by
    have hg := normalizer_le_secondLinear F n g.property
    change (g.val (h.val (1, 1))).2 = (g.val (1, 1)).2 * (h.val (1, 1)).2
    exact hg _

@[simp] lemma normalizerPermutation_torus (n : ℕ) (h : Torus F n) :
    normalizerPermutation F n (normalizerTorus F n h) = 1 := rfl

@[simp] lemma normalizerPermutation_lambda {n : ℕ} (i : Fin n) :
    normalizerPermutation F n (normalizerLambda F i) = simpleSwap i := by
  change simpleSwap i * 1 = simpleSwap i
  exact mul_one _

lemma normalizer_torus_le_permutation_kernel (n : ℕ) :
    (normalizerTorus F n).range ≤ (normalizerPermutation F n).ker := by
  rintro _ ⟨h, rfl⟩
  exact normalizerPermutation_torus F n h

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateTorusNormal -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

lemma normalizerLambda_conjugate_torus {n : ℕ} (i : Fin n) (h : Torus F n) :
    normalizerLambda F i * normalizerTorus F n h * (normalizerLambda F i)⁻¹ =
      normalizerTorus F n (theta F i h) := by
  rw [normalizerLambda_mul_torus]
  simp [mul_assoc]

lemma normalizerLambda_mem_torus_normalizer {n : ℕ} (i : Fin n) :
    normalizerLambda F i ∈
      Subgroup.normalizer ((normalizerTorus F n).range : Set (LiftedNormalizer F n)) := by
  apply Subgroup.mem_normalizer_iff.mpr
  intro g
  constructor
  · rintro ⟨h, rfl⟩
    exact ⟨theta F i h, (normalizerLambda_conjugate_torus F i h).symm⟩
  · rintro ⟨h, hh⟩
    refine ⟨reflection F i h, ?_⟩
    apply (MulAut.conj (normalizerLambda F i)).injective
    change normalizerLambda F i * normalizerTorus F n (reflection F i h) *
      (normalizerLambda F i)⁻¹ = normalizerLambda F i * g * (normalizerLambda F i)⁻¹
    rw [normalizerLambda_conjugate_torus]
    simpa only [theta, MulEquiv.symm_apply_apply] using hh

/-- The faithful torus is normal in the actual generated permutation group. -/
instance normalizerTorusRange_normal (n : ℕ) : (normalizerTorus F n).range.Normal := by
  apply Subgroup.normalizer_eq_top_iff.mp
  apply normalizer_generated F n
  · intro h
    exact Subgroup.le_normalizer ⟨h, rfl⟩
  · exact normalizerLambda_mem_torus_normalizer F

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateCoefficientCenter -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- The original Milnor coefficient subgroup is central in the actual permutation model. -/
theorem normalizerCoefficient_le_center (n : ℕ) :
    (normalizerCoefficient F n).range ≤ Subgroup.center (LiftedNormalizer F n) := by
  rintro _ ⟨a, rfl⟩
  have ht : Subgroup.centralizer ({normalizerCoefficient F n a} : Set (LiftedNormalizer F n)) =
      ⊤ := by
    apply normalizer_generated F n
    · intro h
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      change normalizerTorus F n h * normalizerTorus F n (coefficient F n a) =
        normalizerTorus F n (coefficient F n a) * normalizerTorus F n h
      have hc := Subgroup.mem_center_iff.mp (coefficient_le_center F n ⟨a, rfl⟩) h
      simpa only [map_mul] using congrArg (normalizerTorus F n) hc
    · intro i
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      change normalizerLambda F i * normalizerTorus F n (coefficient F n a) =
        normalizerTorus F n (coefficient F n a) * normalizerLambda F i
      rw [normalizerLambda_mul_torus, theta_coefficient]
  apply Subgroup.mem_center_iff.mpr
  intro g
  apply Subgroup.mem_centralizer_singleton_iff.mp
  rw [ht]
  trivial

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateWeylQuotient -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- The actual generated normalizer modulo its proved normal torus. -/
abbrev WeylQuotient (n : ℕ) := LiftedNormalizer F n ⧸ (normalizerTorus F n).range

/-- The ordinary quotient map by the faithful normal torus. -/
def weylQuotientMap (n : ℕ) : LiftedNormalizer F n →* WeylQuotient F n :=
  QuotientGroup.mk' (normalizerTorus F n).range

@[simp] lemma weylQuotientMap_torus (n : ℕ) (h : Torus F n) :
    weylQuotientMap F n (normalizerTorus F n h) = 1 :=
  (QuotientGroup.eq_one_iff _).mpr ⟨h, rfl⟩

/-- The actual adjacent generators in the torus quotient. -/
def quotientSimple {n : ℕ} (i : Fin n) : WeylQuotient F n :=
  weylQuotientMap F n (normalizerLambda F i)

lemma quotientSimple_square {n : ℕ} (i : Fin n) :
    quotientSimple F i * quotientSimple F i = 1 := by
  rw [quotientSimple, ← map_mul, normalizerLambda_square, weylQuotientMap_torus]

lemma quotientSimple_commute {n : ℕ} (i j : Fin n) (hij : i.val + 1 < j.val) :
    Commute (quotientSimple F i) (quotientSimple F j) := by
  have hne : i ≠ j := by intro he; have := congrArg Fin.val he; omega
  exact (normalizerLambda_commute F i j hne (by omega) (by omega)).map (weylQuotientMap F n)

lemma quotientSimple_braid {n : ℕ} (i j : Fin n) (hij : i.val + 1 = j.val) :
    quotientSimple F i * quotientSimple F j * quotientSimple F i =
      quotientSimple F j * quotientSimple F i * quotientSimple F j := by
  simpa only [quotientSimple, map_mul] using
    congrArg (weylQuotientMap F n) (normalizerLambda_braid F i j hij)

lemma quotientSimple_generate (n : ℕ) :
    Subgroup.closure (Set.range (@quotientSimple F _ n)) = ⊤ := by
  let S := Subgroup.closure (Set.range (@quotientSimple F _ n))
  have hc : S.comap (weylQuotientMap F n) = ⊤ := by
    apply normalizer_generated F n
    · intro h
      change weylQuotientMap F n (normalizerTorus F n h) ∈ S
      rw [weylQuotientMap_torus]
      exact S.one_mem
    · intro i
      exact Subgroup.subset_closure ⟨i, rfl⟩
  apply top_unique
  intro x _
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (normalizerTorus F n).range x
  have hg : g ∈ S.comap (weylQuotientMap F n) := by rw [hc]; trivial
  exact hg

/-- The concrete second-coordinate projection descends through the actual torus quotient. -/
def quotientPermutation (n : ℕ) : WeylQuotient F n →* Equiv.Perm (Fin (n + 1)) :=
  QuotientGroup.lift (normalizerTorus F n).range (normalizerPermutation F n)
    (fun _ hg => normalizer_torus_le_permutation_kernel F n hg)

@[simp] lemma quotientPermutation_simple {n : ℕ} (i : Fin n) :
    quotientPermutation F n (quotientSimple F i) = Equiv.swap i.castSucc i.succ := by
  exact normalizerPermutation_lambda F i

/-- The independently proved type-A presentation supplies actual quotient injectivity. -/
lemma quotientPermutation_injective (n : ℕ) : Function.Injective (quotientPermutation F n) :=
  Equiv.Perm.AdjacentPresentation.projection_injective_of_generated
    (@quotientSimple F _ n) (quotientSimple_square F) (quotientSimple_commute F)
    (quotientSimple_braid F) (quotientSimple_generate F n) (quotientPermutation F n)
    (quotientPermutation_simple F)

/-- The actual permutation kernel consists exactly of the faithful torus subgroup. -/
theorem normalizerPermutation_ker (n : ℕ) :
    (normalizerPermutation F n).ker = (normalizerTorus F n).range := by
  apply le_antisymm
  · intro g hg
    apply (QuotientGroup.eq_one_iff g).mp
    apply quotientPermutation_injective F n
    change normalizerPermutation F n g = quotientPermutation F n 1
    rw [map_one]
    exact hg
  · exact normalizer_torus_le_permutation_kernel F n

/-- The genuine inverse supplied by the finite type-A presentation. -/
def quotientPermutationSection (n : ℕ) : Equiv.Perm (Fin (n + 1)) →* WeylQuotient F n :=
  Equiv.Perm.AdjacentPresentation.permLift (@quotientSimple F _ n)
    (quotientSimple_square F) (quotientSimple_commute F) (quotientSimple_braid F)

lemma quotientPermutation_section (n : ℕ) (σ : Equiv.Perm (Fin (n + 1))) :
    quotientPermutation F n (quotientPermutationSection F n σ) = σ := by
  have he : (quotientPermutation F n).comp (quotientPermutationSection F n) =
      MonoidHom.id (Equiv.Perm (Fin (n + 1))) := by
    apply MonoidHom.eq_of_eqOn_denseM (Equiv.Perm.mclosure_swap_castSucc_succ n)
    rintro _ ⟨i, rfl⟩
    change quotientPermutation F n
      (Equiv.Perm.AdjacentPresentation.permLift (@quotientSimple F _ n)
        (quotientSimple_square F) (quotientSimple_commute F) (quotientSimple_braid F)
          (Equiv.swap i.castSucc i.succ)) = Equiv.swap i.castSucc i.succ
    rw [Equiv.Perm.AdjacentPresentation.permLift_adjacentSwap, quotientPermutation_simple]
  exact DFunLike.congr_fun he σ

lemma normalizerPermutation_surjective (n : ℕ) :
    Function.Surjective (normalizerPermutation F n) := by
  intro σ
  obtain ⟨g, hg⟩ := QuotientGroup.mk'_surjective (normalizerTorus F n).range
    (quotientPermutationSection F n σ)
  refine ⟨g, ?_⟩
  change quotientPermutation F n ((QuotientGroup.mk' (normalizerTorus F n).range) g) = σ
  rw [hg, quotientPermutation_section]

/-- The actual Weyl quotient, with its original adjacent permutation marking. -/
def quotientPermutationEquiv (n : ℕ) : WeylQuotient F n ≃* Equiv.Perm (Fin (n + 1)) :=
  MulEquiv.ofBijective (quotientPermutation F n)
    ⟨quotientPermutation_injective F n,
      fun σ => ⟨quotientPermutationSection F n σ, quotientPermutation_section F n σ⟩⟩

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateNormalizerRegular -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- Evaluation of the concrete normalizer action at the identity state. -/
def normalizerEvaluation (n : ℕ) (g : LiftedNormalizer F n) : NormalizerState F n :=
  g.val (1, 1)

lemma normalizerEvaluation_injective (n : ℕ) : Function.Injective (normalizerEvaluation F n) := by
  intro g h he
  have hp := congrArg Prod.snd he
  have hk : h⁻¹ * g ∈ (normalizerPermutation F n).ker := by
    change normalizerPermutation F n (h⁻¹ * g) = 1
    rw [map_mul, map_inv]
    change (normalizerEvaluation F n h).2⁻¹ * (normalizerEvaluation F n g).2 = 1
    rw [hp]
    exact inv_mul_cancel _
  rw [normalizerPermutation_ker] at hk
  obtain ⟨t, ht⟩ := hk
  have hs : (h⁻¹ * g).val (1, 1) = (1, 1) := by
    change h.val⁻¹ (g.val (1, 1)) = (1, 1)
    change g.val (1, 1) = h.val (1, 1) at he
    rw [he]
    simp
  rw [← ht] at hs
  have ht1 := congrArg Prod.fst hs
  change t * 1 = 1 at ht1
  have ht0 : t = 1 := by simpa only [mul_one] using ht1
  have heq : h⁻¹ * g = 1 := by rw [← ht, ht0, map_one]
  exact (inv_mul_eq_one.mp heq).symm

lemma normalizerEvaluation_surjective (n : ℕ) : Function.Surjective (normalizerEvaluation F n) := by
  rintro ⟨t, σ⟩
  obtain ⟨g, hg⟩ := normalizerPermutation_surjective F n σ
  refine ⟨normalizerTorus F n (t * (normalizerEvaluation F n g).1⁻¹) * g, ?_⟩
  apply Prod.ext
  · change (t * (g.val (1, 1)).1⁻¹) * (g.val (1, 1)).1 = t
    group
  · exact hg

/-- The constructed normalizer acts regularly on the literal torus-permutation state set. -/
def normalizerStateEquiv (n : ℕ) : LiftedNormalizer F n ≃ NormalizerState F n :=
  Equiv.ofBijective (normalizerEvaluation F n)
    ⟨normalizerEvaluation_injective F n, normalizerEvaluation_surjective F n⟩

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateCompositeMarking -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
open scoped commutatorElement
variable (F : Type u) [Field F]

/-- The signed nonsimple section over two consecutive simple coroots in arbitrary rank. -/
def adjacentComposite {n : ℕ} (i j : Fin n) (a : Fˣ) : Torus F n :=
  simple F j a * simple F i a

lemma reflection_simple_composite {n : ℕ} (i j : Fin n) (hij : i.val + 1 = j.val)
    (a : Fˣ) : reflection F i (simple F j a) = adjacentComposite F i j a :=
  reflection_simple_adjacent F i j (Or.inl hij) a

lemma adjacentComposite_mul {n : ℕ} (i j : Fin n) (hij : i.val + 1 = j.val)
    (a b : Fˣ) : adjacentComposite F i j a * adjacentComposite F i j b =
      coefficient F n (Multiplicative.ofAdd (pair F a b)) * adjacentComposite F i j (a * b) := by
  rw [← reflection_simple_composite F i j hij, ← reflection_simple_composite F i j hij,
    ← map_mul, simple_mul, map_mul, reflection_coefficient, reflection_simple_composite F i j hij]

lemma cocycle_adjacent_forward {n : ℕ} (i j : Fin n) (hij : i.val + 1 = j.val)
    (a b : Fˣ) : cocycle F n (Pi.mulSingle i a) (Pi.mulSingle j b) = 0 := by
  have hne : j ≠ i := by intro he; have := congrArg Fin.val he; omega
  have hji : i.val ≠ j.val + 1 := by omega
  rw [cocycle_single_right, following_single]
  simp [hne, hji]

lemma cocycle_adjacent_reverse {n : ℕ} (i j : Fin n) (hij : i.val + 1 = j.val)
    (a b : Fˣ) : cocycle F n (Pi.mulSingle j b) (Pi.mulSingle i a) = -pair F b a := by
  have hne : i ≠ j := by intro he; have := congrArg Fin.val he; omega
  rw [cocycle_single_right, following_single]
  simp [hne, hij.symm]

/-- The original positive simple/composite commutator works in every ambient rank. -/
theorem simple_composite_commutator {n : ℕ} (i j : Fin n) (hij : i.val + 1 = j.val)
    (a b : Fˣ) : ⁅simple F i a, adjacentComposite F i j b⁆ =
      coefficient F n (Multiplicative.ofAdd (MilnorK.symbol ![a, b])) := by
  rw [commutator_formula]
  have hi : (simple F i a).diagonal = (Pi.mulSingle i a : Fin n → Fˣ) := rfl
  have hc : (adjacentComposite F i j b).diagonal =
      (Pi.mulSingle j b : Fin n → Fˣ) * Pi.mulSingle i b := rfl
  rw [hi, hc]
  rw [cocycle_mul_right, cocycle_mul_left, cocycle_adjacent_forward F i j hij,
    cocycle_adjacent_reverse F i j hij, cocycle_single_single, cocycle_single_single]
  simp only [zero_add, neg_add_cancel, sub_zero]
  rfl

/-- The marked commutator in the actual permutation normalizer, in every ambient rank. -/
theorem normalizer_simple_composite_commutator {n : ℕ} (i j : Fin n)
    (hij : i.val + 1 = j.val) (a b : Fˣ) :
    ⁅normalizerTorus F n (simple F i a), normalizerTorus F n (adjacentComposite F i j b)⁆ =
      normalizerCoefficient F n (Multiplicative.ofAdd (MilnorK.symbol ![a, b])) := by
  simpa only [normalizerCoefficient, MonoidHom.comp_apply,
    commutatorElement_def, map_mul, map_inv] using
    congrArg (normalizerTorus F n) (simple_composite_commutator F i j hij a b)

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateWeylConjugation -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- Inverse lambda conjugation is exactly the frozen theta-inverse automorphism. -/
lemma normalizerLambda_inv_conjugate_torus {n : ℕ} (i : Fin n) (h : Torus F n) :
    (normalizerLambda F i)⁻¹ * normalizerTorus F n h * normalizerLambda F i =
      normalizerTorus F n (reflection F i h) := by
  have he := normalizerLambda_mul_torus F i (reflection F i h)
  simp only [theta, MulEquiv.symm_apply_apply] at he
  have he' := congrArg (fun x => (normalizerLambda F i)⁻¹ * x) he
  simpa only [← mul_assoc, inv_mul_cancel, one_mul] using he'.symm

/-- Unit-parameter Weyl conjugation retains the actual central correction. -/
theorem normalizerW_conjugate_torus {n : ℕ} (i : Fin n) (a : Fˣ) (h : Torus F n) :
    normalizerW F i a * normalizerTorus F n h * (normalizerW F i a)⁻¹ =
      normalizerTorus F n (simple F i a * reflection F i h * (simple F i a)⁻¹) := by
  rw [normalizerW, _root_.mul_inv_rev, inv_inv]
  calc
    _ = normalizerTorus F n (simple F i a) *
        ((normalizerLambda F i)⁻¹ * normalizerTorus F n h * normalizerLambda F i) *
          (normalizerTorus F n (simple F i a))⁻¹ := by group
    _ = _ := by
      rw [normalizerLambda_inv_conjugate_torus, map_mul, map_mul, map_inv]

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateBruhatDiamond -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- The nondegenerate crossing follows from the original Aglib Steinberg symbol relation. -/
lemma bruhat_pair_diamond (u v f d : Fˣ)
    (hd : (d : F) = (u : F) * (v : F) - (f : F)) :
    pair F (d * v⁻¹) v + pair F f⁻¹ v =
      pair F u (d * u⁻¹) + pair F f⁻¹ (d * u⁻¹) := by
  have hs : pair F ((u * v) * f⁻¹) (((-1) * d) * f⁻¹) = 0 := by
    apply pair_steinberg
    simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_neg, Units.val_one]
    rw [hd]
    field_simp
    ring
  calc
    pair F (d * v⁻¹) v + pair F f⁻¹ v =
        (pair F u (d * u⁻¹) + pair F f⁻¹ (d * u⁻¹)) -
          pair F ((u * v) * f⁻¹) (((-1) * d) * f⁻¹) +
            (pair F u (-1) + pair F u (-1)) := by
      simp only [pair_mul_left, pair_mul_right, pair_inv_left, pair_inv_right, pair_self]
      rw [pair_skew F u d, pair_skew F v d, pair_skew F u f, pair_skew F v f,
        pair_skew F f d]
      abel
    _ = pair F u (d * u⁻¹) + pair F f⁻¹ (d * u⁻¹) := by
      rw [hs, pair_sign_two]
      simp

lemma negative_simple_product {n : ℕ} (i : Fin n) (a b : Fˣ) (z : MilnorK.K F 2) :
    (simple F i (-a))⁻¹ * coefficient F n (Multiplicative.ofAdd z) * simple F i b⁻¹ =
      (simple F i (-1))⁻¹ *
        coefficient F n (Multiplicative.ofAdd (pair F a b + z)) * simple F i (a * b)⁻¹ := by
  rw [simple_inverse_parameter_neg F i a, _root_.mul_inv_rev, inv_inv]
  have hc := Subgroup.mem_center_iff.mp
    (coefficient_le_center F n ⟨Multiplicative.ofAdd z, rfl⟩) (simple F i b⁻¹)
  calc
    _ = (simple F i (-1))⁻¹ * (simple F i a⁻¹ * simple F i b⁻¹) *
        coefficient F n (Multiplicative.ofAdd z) := by rw [mul_assoc, ← hc]; group
    _ = _ := by
      rw [simple_mul, pair_inv_left, pair_inv_right, neg_neg]
      have hi : a⁻¹ * b⁻¹ = (a * b)⁻¹ := by simp [mul_comm]
      rw [hi]
      have hc' := Subgroup.mem_center_iff.mp
        (coefficient_le_center F n ⟨Multiplicative.ofAdd z, rfl⟩) (simple F i (a * b)⁻¹)
      simp only [mul_assoc]
      rw [hc', ← mul_assoc (coefficient F n (Multiplicative.ofAdd (pair F a b))),
        ← map_mul]
      rfl

/-- The actual simple-coroot torus closes the opposite nonzero crossing with all signs retained. -/
theorem bruhat_torus_diamond {n : ℕ} (i : Fin n) (u v f d : Fˣ)
    (hd : (d : F) = (u : F) * (v : F) - (f : F)) :
    (simple F i (-(d * v⁻¹)))⁻¹ * coefficient F n (Multiplicative.ofAdd (pair F f⁻¹ v)) *
        simple F i v⁻¹ =
      (simple F i (-u))⁻¹ *
        coefficient F n (Multiplicative.ofAdd (pair F f⁻¹ (d * u⁻¹))) *
          simple F i (d * u⁻¹)⁻¹ := by
  rw [negative_simple_product F i (d * v⁻¹) v (pair F f⁻¹ v),
    negative_simple_product F i u (d * u⁻¹) (pair F f⁻¹ (d * u⁻¹)),
    bruhat_pair_diamond F u v f d hd]
  have hm : (d * v⁻¹) * v = u * (d * u⁻¹) := by simp [mul_comm u, mul_assoc]
  rw [hm]

end Quillen.StableSteinberg.RootCoordinate

end

end
