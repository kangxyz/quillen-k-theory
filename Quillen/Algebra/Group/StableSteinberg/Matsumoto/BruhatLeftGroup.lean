/-!
# BruhatLeftGroup

Canonical provider for the accepted interfaces described in the sections below.

The declarations retain their original field, rank, central-kernel and explicit
transport hypotheses. Their current consumer is the finite Matsumoto normalizer,
Bruhat action, or conditional original-root detector construction.
-/

@[expose] public section

/-! ## RootCoordinateBruhatLeftGroup -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- The actual finite group generated by the three lifted left operator families. -/
def BruhatLeftGroup (n : ℕ) : Subgroup (Equiv.Perm (BruhatState F n)) :=
  Subgroup.closure (Set.range (bruhatUpperLeft F n) ∪ Set.range (bruhatTorusLeft F n) ∪
    Set.range (@bruhatWeylLeft F _ n))

/-- Actual state permutations inducing left multiplication by their basepoint matrix. -/
def bruhatLeftCovariant (n : ℕ) : Subgroup (Equiv.Perm (BruhatState F n)) where
  carrier := {e | ∀ s, (e s).matrix = (e (bruhatBase F n)).matrix * s.matrix}
  one_mem' := by intro s; simp [bruhatBase]
  mul_mem' := by
    intro e f he hf s
    change (e (f s)).matrix = (e (f (bruhatBase F n))).matrix * s.matrix
    rw [he (f s), hf s, he (f (bruhatBase F n))]
    exact (mul_assoc _ _ _).symm
  inv_mem' := by
    intro e he
    have hinv (s : BruhatState F n) :
        (e⁻¹ s).matrix = (e (bruhatBase F n)).matrix⁻¹ * s.matrix := by
      apply (eq_inv_mul_iff_mul_eq).mpr
      simpa using (he (e⁻¹ s)).symm
    intro s
    rw [hinv, hinv]
    change _ = ((e (bruhatBase F n)).matrix⁻¹ * 1) * s.matrix
    rw [mul_one]

lemma bruhatLeftGroup_le_covariant (n : ℕ) :
    BruhatLeftGroup F n ≤ bruhatLeftCovariant F n := by
  apply (Subgroup.closure_le _).mpr
  rintro e ((⟨U, rfl⟩ | ⟨h, rfl⟩) | ⟨i, rfl⟩) s
  · change U * s.matrix = (U * 1) * s.matrix
    rw [mul_one]
  · change torusToGL F n h * s.matrix = (torusToGL F n h * 1) * s.matrix
    rw [mul_one]
  · change simpleWMatrix F i 1 * s.matrix = (simpleWMatrix F i 1 * 1) * s.matrix
    rw [mul_one]

/-- Evaluation gives the actual finite left-group matrix homomorphism. -/
def bruhatLeftToGL (n : ℕ) : BruhatLeftGroup F n →*
    Matrix.GeneralLinearGroup (Fin (n + 1)) F where
  toFun e := (e.val (bruhatBase F n)).matrix
  map_one' := rfl
  map_mul' e f := bruhatLeftGroup_le_covariant F n e.property (f.val (bruhatBase F n))

/-- The literal upper group inside the actual left permutation group. -/
def bruhatUpperInclusion (n : ℕ) : _root_.Matrix.Bruhat.upperUnipotent F (n + 1) →* BruhatLeftGroup
  F n :=
  (bruhatUpperLeftHom F n).codRestrict (BruhatLeftGroup F n) fun U =>
    Subgroup.subset_closure (Or.inl (Or.inl ⟨U, rfl⟩))

/-- The existing torus inside the actual left permutation group. -/
def bruhatTorusInclusion (n : ℕ) : Torus F n →* BruhatLeftGroup F n :=
  (bruhatTorusLeftHom F n).codRestrict (BruhatLeftGroup F n) fun h =>
    Subgroup.subset_closure (Or.inl (Or.inr ⟨h, rfl⟩))

/-- The actual left W_i(1) element. -/
def bruhatLeftWeylElement {n : ℕ} (i : Fin n) : BruhatLeftGroup F n :=
  ⟨bruhatWeylLeft F i, Subgroup.subset_closure (Or.inr ⟨i, rfl⟩)⟩

@[simp] lemma bruhatLeftToGL_upper (n : ℕ) (U : _root_.Matrix.Bruhat.upperUnipotent F (n + 1)) :
    bruhatLeftToGL F n (bruhatUpperInclusion F n U) = U := mul_one _

@[simp] lemma bruhatLeftToGL_torus (n : ℕ) (h : Torus F n) :
    bruhatLeftToGL F n (bruhatTorusInclusion F n h) = torusToGL F n h := mul_one _

@[simp] lemma bruhatLeftToGL_weyl {n : ℕ} (i : Fin n) :
    bruhatLeftToGL F n (bruhatLeftWeylElement F i) = simpleWMatrix F i 1 := mul_one _

lemma bruhatTorusInclusion_injective (n : ℕ) :
    Function.Injective (bruhatTorusInclusion F n) := by
  intro h k he
  exact bruhatTorusLeft_injective F n (congrArg Subtype.val he)

/-- No element of the actual left group changes the determinant. -/
theorem bruhatLeftToGL_det (n : ℕ) (e : BruhatLeftGroup F n) :
    Matrix.GeneralLinearGroup.det (bruhatLeftToGL F n e) = 1 :=
  bruhatState_det F n (e.val (bruhatBase F n))

lemma normalizerToGL_mem_left_range (n : ℕ) (ν : LiftedNormalizer F n) :
    normalizerToGL F n ν ∈ (bruhatLeftToGL F n).range := by
  let S := (bruhatLeftToGL F n).range.comap (normalizerToGL F n)
  have hS : S = ⊤ := by
    apply normalizer_generated F n
    · intro h
      change normalizerToGL F n (normalizerTorus F n h) ∈ (bruhatLeftToGL F n).range
      rw [normalizerToGL_torus]
      exact ⟨bruhatTorusInclusion F n h, bruhatLeftToGL_torus F n h⟩
    · intro i
      change normalizerToGL F n (normalizerLambda F i) ∈ (bruhatLeftToGL F n).range
      rw [normalizerToGL_lambda]
      refine ⟨(bruhatLeftWeylElement F i)⁻¹, ?_⟩
      rw [map_inv, bruhatLeftToGL_weyl, simpleWMatrix_neg]
  have hν : ν ∈ S := by rw [hS]; trivial
  exact hν

/-- The actual projection is onto every original determinant-one finite matrix. -/
theorem bruhatLeftToGL_surjective_det_one (n : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin (n + 1)) F)
    (hg : Matrix.GeneralLinearGroup.det g = 1) :
    ∃ e : BruhatLeftGroup F n, bruhatLeftToGL F n e = g := by
  obtain ⟨s, hs⟩ := bruhatState_exists F n g hg
  obtain ⟨U, V, hUV⟩ := _root_.Matrix.Bruhat.bruhatMonomial_factorization F (n + 1) s.matrix
  have hr : s.matrix ∈ (bruhatLeftToGL F n).range := by
    change s.matrix = (U : Matrix.GeneralLinearGroup (Fin (n + 1)) F) *
      bruhatGL F n s.matrix * V at hUV
    rw [hUV, ← s.compatible]
    exact (bruhatLeftToGL F n).range.mul_mem
      ((bruhatLeftToGL F n).range.mul_mem
        ⟨bruhatUpperInclusion F n U, bruhatLeftToGL_upper F n U⟩
        (normalizerToGL_mem_left_range F n s.normalizer))
      ⟨bruhatUpperInclusion F n V, bruhatLeftToGL_upper F n V⟩
  rw [hs] at hr
  exact hr

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateBruhatCoefficients -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- The unchanged coefficient group inside the actual generated left permutation group. -/
def bruhatLeftCoefficient (n : ℕ) : Multiplicative (MilnorK.K F 2) →* BruhatLeftGroup F n :=
  (bruhatTorusInclusion F n).comp (coefficient F n)

lemma bruhatLeftCoefficient_injective (n : ℕ) :
    Function.Injective (bruhatLeftCoefficient F n) :=
  (bruhatTorusInclusion_injective F n).comp (coefficient_injective F n)

@[simp] lemma bruhatLeftToGL_coefficient (n : ℕ) (a : Multiplicative (MilnorK.K F 2)) :
    bruhatLeftToGL F n (bruhatLeftCoefficient F n a) = 1 := by
  change bruhatLeftToGL F n (bruhatTorusInclusion F n (coefficient F n a)) = 1
  rw [bruhatLeftToGL_torus]
  simpa only [normalizerCoefficient, MonoidHom.comp_apply, normalizerToGL_torus] using
    normalizerToGL_coefficient F n a

/-- The faithfully embedded coefficient is already central, independently of Weyl/Weyl coherence. -/
theorem bruhatLeftCoefficient_le_center (n : ℕ) :
    (bruhatLeftCoefficient F n).range ≤ Subgroup.center (BruhatLeftGroup F n) := by
  rintro _ ⟨a, rfl⟩
  have he : BruhatLeftGroup F n ≤ Subgroup.centralizer
      ({bruhatTorusLeft F n (coefficient F n a)} : Set (Equiv.Perm (BruhatState F n))) := by
    apply (Subgroup.closure_le _).mpr
    rintro e ((⟨U, rfl⟩ | ⟨h, rfl⟩) | ⟨i, rfl⟩)
    · apply Subgroup.mem_centralizer_singleton_iff.mpr
      rw [bruhatCoefficient_left_eq_right]
      exact bruhatUpperLeft_torusRight F n U _
    · apply Subgroup.mem_centralizer_singleton_iff.mpr
      rw [bruhatCoefficient_left_eq_right]
      exact bruhatTorusLeft_torusRight F n h _
    · apply Subgroup.mem_centralizer_singleton_iff.mpr
      rw [bruhatCoefficient_left_eq_right]
      exact bruhatWeylLeft_torusRight F i _
  apply Subgroup.mem_center_iff.mpr
  intro e
  apply Subtype.ext
  exact Subgroup.mem_centralizer_singleton_iff.mp (he e.property)

/-- The actual torus inclusion conjugates the actual upper inclusion as their matrices do. -/
theorem bruhatTorusInclusion_upper_conjugate (n : ℕ) (h : Torus F n)
    (U : _root_.Matrix.Bruhat.upperUnipotent F (n + 1)) :
    bruhatTorusInclusion F n h * bruhatUpperInclusion F n U *
        (bruhatTorusInclusion F n h)⁻¹ =
      bruhatUpperInclusion F n (torusConjugateUpper F n h U) := by
  apply Subtype.ext
  exact bruhatTorus_upper_conjugate F n h U

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateBruhatUpperRoot -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
variable (F : Type u) [Field F]

/-- Each original upper elementary matrix in the actual upper subgroup. -/
def upperRootMatrix {n : ℕ} (i j : Fin (n + 1)) (hij : i < j) (a : F) :
    _root_.Matrix.Bruhat.upperUnipotent F (n + 1) :=
  ⟨_root_.Quillen.ElementaryMatrix.unit i j hij.ne a, _root_.Matrix.Bruhat.elementary_mem_upper F i
    j hij a⟩

/-- The actual additive upper-root section in the generated lifted group. -/
def bruhatUpperRoot {n : ℕ} (i j : Fin (n + 1)) (hij : i < j) (a : F) :
    BruhatLeftGroup F n := bruhatUpperInclusion F n (upperRootMatrix F i j hij a)

@[simp] lemma bruhatUpperRoot_projection {n : ℕ} (i j : Fin (n + 1))
    (hij : i < j) (a : F) :
    bruhatLeftToGL F n (bruhatUpperRoot F i j hij a) = _root_.Quillen.ElementaryMatrix.unit i j
      hij.ne a :=
  bruhatLeftToGL_upper F n _

theorem bruhatUpperRoot_add {n : ℕ} (i j : Fin (n + 1)) (hij : i < j) (a b : F) :
    bruhatUpperRoot F i j hij (a + b) =
      bruhatUpperRoot F i j hij a * bruhatUpperRoot F i j hij b := by
  simp only [bruhatUpperRoot, ← map_mul]
  congr 1
  apply Subtype.ext
  exact (_root_.Quillen.ElementaryMatrix.unit_mul_same i j hij.ne a b).symm

lemma torusConjugateUpper_root {n : ℕ} (h : Torus F n) (i j : Fin (n + 1))
    (hij : i < j) (a : F) :
    torusConjugateUpper F n h (upperRootMatrix F i j hij a) =
      upperRootMatrix F i j hij
        (((diagonalCoordinates F h.diagonal i *
          (diagonalCoordinates F h.diagonal j)⁻¹ : Fˣ) : F) * a) := by
  apply Subtype.ext
  change torusToGL F n h * _root_.Quillen.ElementaryMatrix.unit i j hij.ne a * (torusToGL F n h)⁻¹ =
    _
  rw [torusToGL_eq_diagonalGL]
  apply Units.ext
  ext r s
  rw [_root_.Matrix.Bruhat.diagonalGL_conjugate_val]
  simp only [upperRootMatrix, _root_.Quillen.ElementaryMatrix.unit_val,
    _root_.Quillen.ElementaryMatrix.matrix, Matrix.add_apply]
  have hne := hij.ne
  by_cases hrs : r = s <;> by_cases hir : i = r <;> by_cases hjs : j = s <;>
    simp_all [Matrix.one_apply, mul_assoc, mul_comm]

/-- Exact product-one diagonal covariance for the concrete additive upper section. -/
theorem bruhatUpperRoot_diagonal_covariance {n : ℕ} (h : Torus F n)
    (i j : Fin (n + 1)) (hij : i < j) (a : F) :
    bruhatTorusInclusion F n h * bruhatUpperRoot F i j hij a *
        (bruhatTorusInclusion F n h)⁻¹ =
      bruhatUpperRoot F i j hij
        (((diagonalCoordinates F h.diagonal i *
          (diagonalCoordinates F h.diagonal j)⁻¹ : Fˣ) : F) * a) := by
  rw [bruhatUpperRoot, bruhatTorusInclusion_upper_conjugate, torusConjugateUpper_root]
  rfl

end Quillen.StableSteinberg.RootCoordinate

end

end

/-! ## RootCoordinateBruhatMarking -/

section

noncomputable section
universe u
namespace Quillen.StableSteinberg.RootCoordinate
open scoped commutatorElement
variable (F : Type u) [Field F]

/-- The exact positive simple/composite marking inside the actual finite left group. -/
theorem bruhatTorus_simple_composite_commutator {n : ℕ} (i j : Fin n)
    (hij : i.val + 1 = j.val) (a b : Fˣ) :
    ⁅bruhatTorusInclusion F n (simple F i a),
      bruhatTorusInclusion F n (adjacentComposite F i j b)⁆ =
        bruhatLeftCoefficient F n (Multiplicative.ofAdd (MilnorK.symbol ![a, b])) := by
  simpa only [bruhatLeftCoefficient, MonoidHom.comp_apply,
    commutatorElement_def, map_mul, map_inv] using
    congrArg (bruhatTorusInclusion F n) (simple_composite_commutator F i j hij a b)

/-- A coefficient readout on the actual finite group; no homomorphism property is asserted. -/
def bruhatCoefficientReadout (n : ℕ) : BruhatLeftGroup F n → Multiplicative (MilnorK.K F 2) :=
  Function.invFun (bruhatLeftCoefficient F n)

/-- The readout is a genuine left inverse to the unchanged faithful coefficient inclusion. -/
theorem bruhatCoefficientReadout_coefficient (n : ℕ) (a : Multiplicative (MilnorK.K F 2)) :
    bruhatCoefficientReadout F n (bruhatLeftCoefficient F n a) = a :=
  Function.leftInverse_invFun (bruhatLeftCoefficient_injective F n) a

end Quillen.StableSteinberg.RootCoordinate

end

