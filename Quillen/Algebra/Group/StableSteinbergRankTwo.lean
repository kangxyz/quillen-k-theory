module

public import Quillen.Algebra.Group.StableSteinbergSymbols
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Ordered defects and the actual rank-two Steinberg kernel

Let `C` be the subgroup of the original stable Steinberg presentation generated by
its ordered words `h(a) h(b) h(ab)⁻¹`. This module proves the exact equality
`C = stage F 2 ⊓ (toElementary F).ker`, for every field, including F2 and F3.
It follows that surjectivity of the existing canonical `milnorToKernel` is
EQUIVALENT to the remaining assertion that the full kernel lies in `stage F 2`.
That all-rank containment is not a hypothesis of the rank-two theorem and is not
proved here.

The proof descends the original elementary map to `St/C`, where the original
rank-two torus word becomes multiplicative. Original finite-stage matrix actions
on fresh columns and rows give exact Weyl conjugation of roots. They yield a
two-cell rank-two Bruhat collection using only zero versus nonzero pivots.
Literal finite matrix entries then detect identity among those normal forms.
Every source word and stabilization is from the original finite-rank presentation.
No equality of arbitrary source words is inferred from equal matrix images.

The Milnor range reduction uses the provided symbol extensionality and the
existing ordered pair formula. It assumes neither Steinberg kernel generation
nor a Matsumoto comparison, and makes no injectivity claim for the Milnor map.
-/
@[expose] public section

noncomputable section
universe u
namespace Quillen.StableSteinberg.KernelGeneration
open scoped commutatorElement Matrix

section Reduction
variable (F : Type u) [Field F]
attribute [local instance] kernelCommGroup

/-- The original ordered rank-two defects, as elements of the actual stable presentation. -/
def defects : Set (Group F) := {g | ∃ a b : Fˣ, g = torusDefect a b}
/-- The subgroup generated by the original ordered defects. -/
def defectSubgroup : Subgroup (Group F) := Subgroup.closure (defects F)

/-- Every generated defect has trivial image under the original elementary map. -/
lemma defectSubgroup_le_kernel : defectSubgroup F ≤ (toElementary F).ker := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨a, b, rfl⟩
  exact toElementary_torusDefect a b

/-- The generated defect subgroup is central in the original presentation. -/
lemma defectSubgroup_le_center : defectSubgroup F ≤ Subgroup.center (Group F) :=
  (defectSubgroup_le_kernel F).trans (ker_toElementary_le_center F)

/-- Centrality supplies normality for the actual quotient by ordered defects. -/
instance defectSubgroup_normal : (defectSubgroup F).Normal :=
  Subgroup.normal_of_le_center (defectSubgroup_le_center F)

/-- The actual stable presentation modulo its generated ordered defects. -/
abbrev DefectQuotient := Group F ⧸ defectSubgroup F

/-- The original elementary map descended through the actual defect quotient. -/
def quotientToElementary : DefectQuotient F →* StableGeneralLinear.elementary F :=
  QuotientGroup.lift (defectSubgroup F) (toElementary F) (defectSubgroup_le_kernel F)

/-- Quotient descent retains the original elementary map on every original word. -/
lemma quotientToElementary_mk (g : Group F) :
    quotientToElementary F (QuotientGroup.mk g) = toElementary F g := rfl

/-- The original torus words become multiplicative in the defect quotient. -/
lemma quotient_h_mul (a b : Fˣ) :
    (QuotientGroup.mk' (defectSubgroup F)) (h a) *
      (QuotientGroup.mk' (defectSubgroup F)) (h b) =
        (QuotientGroup.mk' (defectSubgroup F)) (h (a * b)) := by
  apply mul_inv_eq_one.mp
  rw [← map_inv, ← map_mul, ← map_mul]
  apply (QuotientGroup.eq_one_iff _).mpr
  exact Subgroup.subset_closure ⟨a, b, rfl⟩

/-- Injectivity of this quotient map is exactly the missing kernel-generation assertion. -/
lemma quotientToElementary_injective_iff :
    Function.Injective (quotientToElementary F) ↔ defectSubgroup F = (toElementary F).ker := by
  constructor
  · intro hinj
    apply le_antisymm (defectSubgroup_le_kernel F)
    intro g hg
    apply (QuotientGroup.eq_one_iff _).mp
    apply hinj
    exact hg.trans (map_one _).symm
  · intro heq
    apply (quotientToElementary F).ker_eq_bot_iff.mp
    apply le_antisymm _ bot_le
    intro a ha
    induction a using QuotientGroup.induction_on with
    | H g =>
      apply (QuotientGroup.eq_one_iff _).mpr
      rw [heq]
      exact ha

/-- Generation is equivalent to generation at all actual finite stages. -/
lemma kernel_generation_iff_finite_stage :
    defectSubgroup F = (toElementary F).ker ↔
      ∀ (n : ℕ) (g : Group F), g ∈ stage F n → toElementary F g = 1 →
        g ∈ defectSubgroup F := by
  constructor
  · intro heq n g _ hg
    rw [heq]
    exact hg
  · intro hgen
    apply le_antisymm (defectSubgroup_le_kernel F)
    intro g hg
    obtain ⟨n, hn⟩ := exists_stage F g
    exact hgen n g hn hg

/-- Actual stabilization permits any fixed lower bound on the finite stages tested. -/
lemma kernel_generation_iff_large_stage (N : ℕ) :
    defectSubgroup F = (toElementary F).ker ↔
      ∀ (n : ℕ), N ≤ n → ∀ g : Group F, g ∈ stage F n → toElementary F g = 1 →
        g ∈ defectSubgroup F := by
  constructor
  · intro heq n _ g _ hg
    rw [heq]
    exact hg
  · intro hgen
    apply le_antisymm (defectSubgroup_le_kernel F)
    intro g hg
    obtain ⟨n, hn⟩ := exists_stage F g
    exact hgen (max n N) (Nat.le_max_right _ _) g
      (stage_mono F (Nat.le_max_left _ _) hn) hg

private def kernelDefectSubgroup : Subgroup ((toElementary F).ker) :=
  Subgroup.closure {g | ∃ a b : Fˣ, g = torusDefectKernel a b}

private def milnorToKernelMul : Multiplicative (MilnorK.K F 2) →* (toElementary F).ker :=
  (milnorToKernel F).toMultiplicative

private lemma milnorToKernelMul_pair (a b : Fˣ) :
    milnorToKernelMul F (Multiplicative.ofAdd (MilnorK.symbol ![a, b])) =
      torusDefectKernel a b :=
  congrArg Additive.toMul (milnorToKernel_pair a b)

private lemma range_milnorToKernelMul : (milnorToKernelMul F).range = kernelDefectSubgroup F := by
  apply le_antisymm
  · let q := QuotientGroup.mk' (kernelDefectSubgroup F)
    have hz : q.toAdditive.comp (milnorToKernel F) = 0 := by
      apply MilnorK.addHom_ext
      intro a
      simp only [AddMonoidHom.comp_apply, milnorToKernel_symbol, AddMonoidHom.zero_apply]
      change q (torusDefectKernel (a 0) (a 1)) = 1
      apply (QuotientGroup.eq_one_iff _).mpr
      exact Subgroup.subset_closure ⟨a 0, a 1, rfl⟩
    rintro g ⟨a, rfl⟩
    apply (QuotientGroup.eq_one_iff _).mp
    exact congrArg Additive.toMul
      (congrArg (fun k : MilnorK.K F 2 →+ Additive _ => k a.toAdd) hz)
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨a, b, rfl⟩
    exact ⟨Multiplicative.ofAdd (MilnorK.symbol ![a, b]), milnorToKernelMul_pair F a b⟩

private lemma map_kernelDefectSubgroup :
    (kernelDefectSubgroup F).map (toElementary F).ker.subtype = defectSubgroup F := by
  rw [kernelDefectSubgroup, MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨z, ⟨a, b, rfl⟩, rfl⟩
    exact ⟨a, b, rfl⟩
  · rintro ⟨a, b, rfl⟩
    exact ⟨torusDefectKernel a b, ⟨a, b, rfl⟩, rfl⟩

/-- Surjectivity of the provided canonical Milnor map is equivalent to actual defect generation. -/
lemma milnorToKernel_surjective_iff :
    Function.Surjective (milnorToKernel F) ↔ defectSubgroup F = (toElementary F).ker := by
  constructor
  · intro hsurj
    have hrange : (milnorToKernelMul F).range = ⊤ := by
      apply MonoidHom.range_eq_top.mpr
      intro a
      obtain ⟨z, hz⟩ := hsurj (Additive.ofMul a)
      exact ⟨Multiplicative.ofAdd z, congrArg Additive.toMul hz⟩
    rw [← map_kernelDefectSubgroup, ← range_milnorToKernelMul, hrange, Subgroup.map_top]
    exact (toElementary F).ker.range_subtype
  · intro hgen a
    have ha : a.toMul ∈ kernelDefectSubgroup F := by
      have hmem : (a.toMul : Group F) ∈ defectSubgroup F := hgen.ge a.toMul.property
      rw [← map_kernelDefectSubgroup] at hmem
      obtain ⟨b, hb, heq⟩ := hmem
      have hbEq : b = a.toMul := Subtype.ext heq
      exact hbEq ▸ hb
    rw [← range_milnorToKernelMul] at ha
    obtain ⟨b, hb⟩ := ha
    exact ⟨b.toAdd, congrArg Additive.ofMul hb⟩

end Reduction

section RankTwo
variable {F : Type u} [Field F]

/-- Finite matrix actions on fresh columns and rows determine conjugation of the original roots. -/
lemma conj_root_of_vectors (n : ℕ) (g : Group F) (hg : g ∈ stage F n)
    (A : StableGeneralLinear.GL F n)
    (hA : toStableGeneralLinear F g = StableGeneralLinear.of F n A)
    (i j k l : Fin n) (hij : i ≠ j) (hkl : k ≠ l) (t p q : F)
    (hc : A.val *ᵥ Pi.single i t = Pi.single k p)
    (hr : Pi.single j 1 ᵥ* (A⁻¹).val = Pi.single l q) :
    g * x F n i j hij t * g⁻¹ = x F n k l hkl (p * q) := by
  obtain ⟨B, hB, hcol, hrow⟩ := exists_stage_matrix_actions F n g hg
  have hBA : B = A := StableGeneralLinear.of_injective F n (hB.symm.trans hA)
  subst B
  have hi : g * x F (n + 1) i.castSucc (Fin.last n) (Fin.castSucc_ne_last i) t * g⁻¹ =
      x F (n + 1) k.castSucc (Fin.last n) (Fin.castSucc_ne_last k) p := by
    rw [← columnWord_single F n i t, hcol, hc, columnWord_single]
  have hj : g * x F (n + 1) (Fin.last n) j.castSucc (Fin.castSucc_ne_last j).symm 1 *
      g⁻¹ = x F (n + 1) (Fin.last n) l.castSucc (Fin.castSucc_ne_last l).symm q := by
    rw [← rowWord_single F n j 1, hrow, hr, rowWord_single]
  calc
    _ = ⁅g * x F (n + 1) i.castSucc (Fin.last n) (Fin.castSucc_ne_last i) t * g⁻¹,
        g * x F (n + 1) (Fin.last n) j.castSucc (Fin.castSucc_ne_last j).symm 1 * g⁻¹⁆ := by
      rw [x_eq_commutator_succ, conjugate_commutatorElement]
    _ = ⁅x F (n + 1) k.castSucc (Fin.last n) (Fin.castSucc_ne_last k) p,
        x F (n + 1) (Fin.last n) l.castSucc (Fin.castSucc_ne_last l).symm q⁆ := by rw [hi, hj]
    _ = x F (n + 1) k.castSucc l.castSucc (by simpa using hkl) (p * q) :=
      x_commutator F (n + 1) k.castSucc (Fin.last n) l.castSucc
        (Fin.castSucc_ne_last k) (Fin.castSucc_ne_last l).symm (by simpa using hkl) p q
    _ = _ := (x_stabilize F n k l hkl (p * q)).symm

private lemma w_mem_stage (a : Fˣ) : w a ∈ stage F 2 :=
  (stage F 2).mul_mem
    ((stage F 2).mul_mem (x_mem_stage F 2 0 1 (by decide) a)
      (x_mem_stage F 2 1 0 (by decide) (-((a⁻¹ : Fˣ) : F))))
    (x_mem_stage F 2 0 1 (by decide) a)

private lemma h_mem_stage (a : Fˣ) : h a ∈ stage F 2 :=
  (stage F 2).mul_mem (w_mem_stage a) (w_mem_stage (-1 : Fˣ))

private lemma wMatrix_inv_val (a : Fˣ) :
    ((wMatrix a)⁻¹).val = !![0, -(a : F); ((a⁻¹ : Fˣ) : F), 0] := by
  have he : wMatrix (-a) = (wMatrix a)⁻¹ :=
    StableGeneralLinear.of_injective F 2 (by
      rw [← toStableGeneralLinear_w, w_neg, map_inv, toStableGeneralLinear_w, map_inv])
  rw [← he, wMatrix_val]
  simp

private lemma hMatrix_inv_val (a : Fˣ) :
    ((hMatrix a)⁻¹).val = Matrix.diagonal ![((a⁻¹ : Fˣ) : F), (a : F)] := by
  have hone : hMatrix (1 : Fˣ) = 1 := by
    apply Units.ext
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hMatrix_val]
  have hh : hMatrix a * hMatrix (a⁻¹) = 1 := by
    rw [hMatrix_mul, mul_inv_cancel, hone]
  have he : hMatrix (a⁻¹) = (hMatrix a)⁻¹ := eq_inv_of_mul_eq_one_right hh
  rw [← he, hMatrix_val]
  simp

local notation "U" => (x F 2 (0 : Fin 2) 1 (by decide))
local notation "V" => (x F 2 (1 : Fin 2) 0 (by decide))

private lemma w_conj_upper (a : Fˣ) (t : F) :
    w a * U t * (w a)⁻¹ = V (-((a⁻¹ : Fˣ) : F) ^ 2 * t) := by
  have hc : (wMatrix a).val *ᵥ Pi.single (0 : Fin 2) t =
      Pi.single (1 : Fin 2) (-((a⁻¹ : Fˣ) : F) * t) := by
    rw [wMatrix_val]
    ext i
    fin_cases i <;> simp [Matrix.mulVec, dotProduct, Pi.single_apply]
  have hr : Pi.single (1 : Fin 2) (1 : F) ᵥ* ((wMatrix a)⁻¹).val =
      Pi.single (0 : Fin 2) ((a⁻¹ : Fˣ) : F) := by
    rw [wMatrix_inv_val]
    ext i
    fin_cases i <;> simp [Matrix.vecMul, dotProduct, Pi.single_apply]
  convert conj_root_of_vectors 2 (w a) (w_mem_stage a) (wMatrix a)
    (toStableGeneralLinear_w a) 0 1 1 0 (by decide) (by decide) t
    (-((a⁻¹ : Fˣ) : F) * t) ((a⁻¹ : Fˣ) : F) hc hr using 1
  congr 1
  ring

private lemma w_conj_lower (a : Fˣ) (t : F) :
    w a * V t * (w a)⁻¹ = U (-(a : F) ^ 2 * t) := by
  have hc : (wMatrix a).val *ᵥ Pi.single (1 : Fin 2) t =
      Pi.single (0 : Fin 2) ((a : F) * t) := by
    rw [wMatrix_val]
    ext i
    fin_cases i <;> simp [Matrix.mulVec, dotProduct, Pi.single_apply]
  have hr : Pi.single (0 : Fin 2) (1 : F) ᵥ* ((wMatrix a)⁻¹).val =
      Pi.single (1 : Fin 2) (-(a : F)) := by
    rw [wMatrix_inv_val]
    ext i
    fin_cases i <;> simp [Matrix.vecMul, dotProduct, Pi.single_apply]
  convert conj_root_of_vectors 2 (w a) (w_mem_stage a) (wMatrix a)
    (toStableGeneralLinear_w a) 1 0 0 1 (by decide) (by decide) t
    ((a : F) * t) (-(a : F)) hc hr using 1
  congr 1
  ring

private lemma h_conj_upper (a : Fˣ) (t : F) :
    h a * U t * (h a)⁻¹ = U ((a : F) ^ 2 * t) := by
  have hc : (hMatrix a).val *ᵥ Pi.single (0 : Fin 2) t =
      Pi.single (0 : Fin 2) ((a : F) * t) := by
    rw [hMatrix_val]
    ext i
    fin_cases i <;> simp [Matrix.mulVec, dotProduct, Pi.single_apply]
  have hr : Pi.single (1 : Fin 2) (1 : F) ᵥ* ((hMatrix a)⁻¹).val =
      Pi.single (1 : Fin 2) (a : F) := by
    rw [hMatrix_inv_val]
    ext i
    fin_cases i <;> simp [Matrix.vecMul, dotProduct, Pi.single_apply]
  convert conj_root_of_vectors 2 (h a) (h_mem_stage a) (hMatrix a)
    (toStableGeneralLinear_h a) 0 1 0 1 (by decide) (by decide) t
    ((a : F) * t) (a : F) hc hr using 1
  congr 1
  ring

private lemma w_alt (a : Fˣ) :
    w a = V (-((a⁻¹ : Fˣ) : F)) * U (a : F) * V (-((a⁻¹ : Fˣ) : F)) := by
  have hs : -(a : F) ^ 2 * ((a⁻¹ : Fˣ) : F) = -(a : F) := by
    simp [pow_two, Units.val_inv_eq_inv_val]
  have hw : w a * V (((a⁻¹ : Fˣ) : F)) = U (-(a : F)) * w a := by
    apply mul_inv_eq_iff_eq_mul.mp
    rw [w_conj_lower, hs]
  calc
    w a = (w a * V (((a⁻¹ : Fˣ) : F))) * V (-((a⁻¹ : Fˣ) : F)) := by
      rw [mul_assoc, x_add, add_neg_cancel, x_zero, mul_one]
    _ = _ := by
      rw [hw]
      simp only [w, ← mul_assoc, x_add, neg_add_cancel, x_zero, one_mul]

private lemma w_one_conj_w (a : Fˣ) : w (1 : Fˣ) * w a * (w (1 : Fˣ))⁻¹ = w a⁻¹ := by
  calc
    _ = (w (1 : Fˣ) * U (a : F) * (w (1 : Fˣ))⁻¹) *
        (w (1 : Fˣ) * V (-((a⁻¹ : Fˣ) : F)) * (w (1 : Fˣ))⁻¹) *
        (w (1 : Fˣ) * U (a : F) * (w (1 : Fˣ))⁻¹) := by simp [w, mul_assoc]
    _ = V (-(a : F)) * U (((a⁻¹ : Fˣ) : F)) * V (-(a : F)) := by
      rw [w_conj_upper, w_conj_lower]
      simp
    _ = _ := by rw [w_alt]; simp

private lemma w_one_conj_h (a : Fˣ) : w (1 : Fˣ) * h a * (w (1 : Fˣ))⁻¹ = h a⁻¹ := by
  calc
    _ = (w (1 : Fˣ) * w a * (w (1 : Fˣ))⁻¹) *
        (w (1 : Fˣ) * w (-1 : Fˣ) * (w (1 : Fˣ))⁻¹) := by simp [h, mul_assoc]
    _ = _ := by rw [w_one_conj_w, w_one_conj_w]; simp [h]

private lemma lower_w (a : Fˣ) (t : F) :
    V t * w a = w a * U (-(a : F) ^ 2 * t) := by
  have hw := w_conj_lower (-a) t
  rw [w_neg, inv_inv] at hw
  simp only [Units.val_neg, neg_sq] at hw
  simpa [mul_assoc] using congrArg (fun z => w a * z) hw

private lemma upper_as_w (a : Fˣ) :
    U (a : F) = V (((a⁻¹ : Fˣ) : F)) * w a * V (((a⁻¹ : Fˣ) : F)) := by
  rw [w_alt]
  simp only [← mul_assoc, x_add, add_neg_cancel, x_zero, one_mul]
  rw [mul_assoc, x_add, neg_add_cancel, x_zero, mul_one]

private def qU (t : F) : DefectQuotient F :=
  QuotientGroup.mk' (defectSubgroup F) (U t)

private def qV (t : F) : DefectQuotient F :=
  QuotientGroup.mk' (defectSubgroup F) (V t)

private def qW (a : Fˣ) : DefectQuotient F :=
  QuotientGroup.mk' (defectSubgroup F) (w a)

private def qH : Fˣ →* DefectQuotient F where
  toFun a := QuotientGroup.mk' (defectSubgroup F) (h a)
  map_one' := by rw [h_one, map_one]
  map_mul' a b := (quotient_h_mul F a b).symm

private lemma qU_add (r s : F) : qU r * qU s = qU (r + s) := by
  simp only [qU, ← map_mul, x_add]

@[simp] private lemma qU_zero : qU (0 : F) = 1 := by rw [qU, x_zero, map_one]

private lemma qW_neg (a : Fˣ) : qW (-a) = (qW a)⁻¹ := by rw [qW, w_neg, map_inv]; rfl

private lemma qW_as_h (a : Fˣ) : qW a = qH a * qW (1 : Fˣ) := by
  change QuotientGroup.mk' _ (w a) = QuotientGroup.mk' _ (h a) * QuotientGroup.mk' _ (w 1)
  rw [← map_mul, h, w_neg, mul_assoc, inv_mul_cancel, mul_one]

private lemma qW_one_conj_h (a : Fˣ) :
    qW (1 : Fˣ) * qH a * (qW (1 : Fˣ))⁻¹ = qH a⁻¹ := by
  change QuotientGroup.mk' _ (w 1) * QuotientGroup.mk' _ (h a) *
    (QuotientGroup.mk' _ (w 1))⁻¹ = QuotientGroup.mk' _ (h a⁻¹)
  rw [← map_inv, ← map_mul, ← map_mul, w_one_conj_h]

private lemma qW_one_sq : qW (1 : Fˣ) * qW (1 : Fˣ) = qH (-1 : Fˣ) := by
  have he : qH (-1 : Fˣ) = (qW (1 : Fˣ) * qW (1 : Fˣ))⁻¹ := by
    change QuotientGroup.mk' _ (h (-1 : Fˣ)) = _
    simp only [h, map_mul, w_neg, map_inv, qW, mul_inv_rev]
  calc
    _ = (qH (-1 : Fˣ))⁻¹ := by rw [he, inv_inv]
    _ = _ := by rw [← map_inv]; simp

private lemma qW_mul (a b : Fˣ) : qW a * qW b = qH (-a * b⁻¹) := by
  rw [qW_as_h a, qW_as_h b]
  calc
    _ = qH a * (qW (1 : Fˣ) * qH b * (qW (1 : Fˣ))⁻¹) *
        (qW (1 : Fˣ) * qW (1 : Fˣ)) := by simp only [mul_assoc, inv_mul_cancel_left]
    _ = qH a * qH b⁻¹ * qH (-1 : Fˣ) := by rw [qW_one_conj_h, qW_one_sq]
    _ = _ := by rw [← map_mul, ← map_mul]; congr 1; simp

private lemma qH_mul_qW (a b : Fˣ) : qH a * qW b = qW (a * b) := by
  rw [qW_as_h b, qW_as_h (a * b), map_mul, mul_assoc]

private lemma qH_mul_qU (a : Fˣ) (t : F) : qH a * qU t = qU ((a : F) ^ 2 * t) * qH a := by
  have hh := congrArg (QuotientGroup.mk' (defectSubgroup F))
    (mul_inv_eq_iff_eq_mul.mp (h_conj_upper a t))
  simp only [map_mul] at hh
  exact hh

private lemma qW_mul_qV (a : Fˣ) (t : F) : qW a * qV t = qU (-(a : F) ^ 2 * t) * qW a := by
  have hh := congrArg (QuotientGroup.mk' (defectSubgroup F))
    (mul_inv_eq_iff_eq_mul.mp (w_conj_lower a t))
  simp only [map_mul] at hh
  exact hh

private lemma qV_mul_qW (a : Fˣ) (t : F) : qV t * qW a = qW a * qU (-(a : F) ^ 2 * t) := by
  have hh := congrArg (QuotientGroup.mk' (defectSubgroup F)) (lower_w a t)
  simp only [map_mul] at hh
  exact hh

private lemma qU_as_w (a : Fˣ) :
    qU (a : F) = qV (((a⁻¹ : Fˣ) : F)) * qW a * qV (((a⁻¹ : Fˣ) : F)) := by
  have hh := congrArg (QuotientGroup.mk' (defectSubgroup F)) (upper_as_w a)
  simp only [map_mul] at hh
  exact hh

private lemma qV_as_w (t : F) :
    qV t = qW (1 : Fˣ) * qU (-t) * qW (-1 : Fˣ) := by
  have hh := congrArg (QuotientGroup.mk' (defectSubgroup F)) (w_conj_upper (1 : Fˣ) (-t))
  simp only [map_mul, map_inv, inv_one, Units.val_one, one_pow, neg_mul,
    one_mul, neg_neg] at hh
  rw [qW_neg]
  exact hh.symm

private def RankTwoNormal (g : DefectQuotient F) : Prop :=
  (∃ a : Fˣ, ∃ t : F, g = qU t * qH a) ∨
    (∃ a : Fˣ, ∃ t s : F, g = qU t * qW a * qU s)

private lemma normal_one : RankTwoNormal (1 : DefectQuotient F) := by
  left
  exact ⟨1, 0, by simp⟩

private lemma normal_mul_upper {g : DefectQuotient F} (hg : RankTwoNormal g) (r : F) :
    RankTwoNormal (g * qU r) := by
  rcases hg with ⟨a, t, rfl⟩ | ⟨a, t, s, rfl⟩
  · left
    refine ⟨a, t + (a : F) ^ 2 * r, ?_⟩
    rw [mul_assoc, qH_mul_qU, ← mul_assoc, qU_add]
  · right
    exact ⟨a, t, s + r, by rw [mul_assoc, qU_add]⟩

private lemma qW_upper_qW (a b s : Fˣ) :
    qW a * qU (s : F) * qW b =
      qU (-(a : F) ^ 2 * ((s⁻¹ : Fˣ) : F)) * qW ((-a * s⁻¹) * b) *
        qU (-(b : F) ^ 2 * ((s⁻¹ : Fˣ) : F)) := by
  rw [qU_as_w s]
  calc
    _ = (qW a * qV (((s⁻¹ : Fˣ) : F))) * qW s *
        (qV (((s⁻¹ : Fˣ) : F)) * qW b) := by simp only [mul_assoc]
    _ = (qU (-(a : F) ^ 2 * ((s⁻¹ : Fˣ) : F)) * qW a) * qW s *
        (qW b * qU (-(b : F) ^ 2 * ((s⁻¹ : Fˣ) : F))) := by
      rw [qW_mul_qV, qV_mul_qW]
    _ = _ := by
      rw [mul_assoc (qU _) (qW a) (qW s), qW_mul]
      simp only [← mul_assoc]
      rw [mul_assoc (qU _) (qH _) (qW b), qH_mul_qW]

private lemma normal_mul_w {g : DefectQuotient F} (hg : RankTwoNormal g) (b : Fˣ) :
    RankTwoNormal (g * qW b) := by
  rcases hg with ⟨a, t, rfl⟩ | ⟨a, t, s, rfl⟩
  · right
    exact ⟨a * b, t, 0, by rw [qU_zero, mul_one, mul_assoc, qH_mul_qW]⟩
  · by_cases hs : s = 0
    · subst s
      left
      exact ⟨-a * b⁻¹, t, by rw [qU_zero, mul_one, mul_assoc, qW_mul]⟩
    · let c : Fˣ := Units.mk0 s hs
      right
      refine ⟨(-a * c⁻¹) * b, t + (-(a : F) ^ 2 * ((c⁻¹ : Fˣ) : F)),
        -(b : F) ^ 2 * ((c⁻¹ : Fˣ) : F), ?_⟩
      change (qU t * qW a * qU (c : F)) * qW b = _
      rw [mul_assoc (qU t) (qW a) (qU _), mul_assoc,
        qW_upper_qW, ← mul_assoc, ← mul_assoc, qU_add]

private lemma normal_mul_lower {g : DefectQuotient F} (hg : RankTwoNormal g) (r : F) :
    RankTwoNormal (g * qV r) := by
  have hh := normal_mul_w (normal_mul_upper (normal_mul_w hg (1 : Fˣ)) (-r)) (-1 : Fˣ)
  simpa only [qV_as_w, mul_assoc] using hh

private lemma normal_of_mem_stage_two {g : Group F} (hg : g ∈ stage F 2) :
    RankTwoNormal ((QuotientGroup.mk' (defectSubgroup F)) g) := by
  induction hg using Subgroup.closure_induction_right with
  | one => simpa only [map_one] using (normal_one (F := F))
  | mul_right g hg z hz ih =>
    obtain ⟨i, j, hij, t, rfl⟩ := hz
    fin_cases i <;> fin_cases j
    · exact (hij rfl).elim
    · change RankTwoNormal ((QuotientGroup.mk' _) (g * U t))
      rw [map_mul]
      exact normal_mul_upper ih t
    · change RankTwoNormal ((QuotientGroup.mk' _) (g * V t))
      rw [map_mul]
      exact normal_mul_lower ih t
    · exact (hij rfl).elim
  | mul_inv_cancel g hg z hz ih =>
    obtain ⟨i, j, hij, t, rfl⟩ := hz
    rw [← x_neg, map_mul]
    fin_cases i <;> fin_cases j
    · exact (hij rfl).elim
    · exact normal_mul_upper ih (-t)
    · exact normal_mul_lower ih (-t)
    · exact (hij rfl).elim

private def quotientToStableGL : DefectQuotient F →* StableGeneralLinear.Group F :=
  (StableGeneralLinear.elementary F).subtype.comp (quotientToElementary F)

private lemma quotientToStableGL_mk (g : Group F) :
    quotientToStableGL ((QuotientGroup.mk' (defectSubgroup F)) g) =
      toStableGeneralLinear F g := rfl

private lemma quotientToStableGL_qU (t : F) :
    quotientToStableGL (qU t) =
      StableGeneralLinear.of F 2 (ElementaryMatrix.unit (0 : Fin 2) 1 (by decide) t) :=
  by rw [qU, quotientToStableGL_mk, toStableGeneralLinear_x]

private lemma quotientToStableGL_qW (a : Fˣ) :
    quotientToStableGL (qW a) = StableGeneralLinear.of F 2 (wMatrix a) :=
  toStableGeneralLinear_w a

private lemma quotientToStableGL_qH (a : Fˣ) :
    quotientToStableGL (qH a) = StableGeneralLinear.of F 2 (hMatrix a) :=
  toStableGeneralLinear_h a

private lemma normal_eq_one_of_image {g : DefectQuotient F} (hg : RankTwoNormal g)
    (himage : quotientToStableGL g = 1) : g = 1 := by
  rcases hg with ⟨a, t, rfl⟩ | ⟨a, t, s, rfl⟩
  · rw [map_mul, quotientToStableGL_qU, quotientToStableGL_qH, ← map_mul] at himage
    have he : ElementaryMatrix.unit (0 : Fin 2) 1 (by decide) t * hMatrix a = 1 :=
      StableGeneralLinear.of_injective F 2 (himage.trans (map_one _).symm)
    have ha : (a : F) = 1 := by
      have hh := congrArg (fun A : StableGeneralLinear.GL F 2 => A.val 0 0) he
      simpa [Units.val_mul, ElementaryMatrix.unit_val, ElementaryMatrix.matrix,
        hMatrix_val, Matrix.mul_apply, Fin.sum_univ_two, Matrix.single, Matrix.one_apply] using hh
    have ha' : a = 1 := Units.ext ha
    subst a
    have ht : t = 0 := by
      have hh := congrArg (fun A : StableGeneralLinear.GL F 2 => A.val 0 1) he
      simpa [Units.val_mul, ElementaryMatrix.unit_val, ElementaryMatrix.matrix,
        hMatrix_val, Matrix.mul_apply, Fin.sum_univ_two, Matrix.single, Matrix.one_apply] using hh
    rw [ht, qU_zero, map_one, mul_one]
  · simp only [map_mul, quotientToStableGL_qU, quotientToStableGL_qW] at himage
    rw [← map_mul, ← map_mul] at himage
    have he : ElementaryMatrix.unit (0 : Fin 2) 1 (by decide) t * wMatrix a *
        ElementaryMatrix.unit (0 : Fin 2) 1 (by decide) s = 1 :=
      StableGeneralLinear.of_injective F 2 (himage.trans (map_one _).symm)
    have hh := congrArg (fun A : StableGeneralLinear.GL F 2 => A.val 1 0) he
    simp [Units.val_mul, ElementaryMatrix.unit_val, ElementaryMatrix.matrix,
      wMatrix_val, Matrix.mul_apply, Matrix.single, Matrix.one_apply] at hh

/-- Two-cell Bruhat collection proves generation for the original rank-two stage kernel. -/
theorem stage_two_kernel_mem_defectSubgroup {g : Group F} (hg : g ∈ stage F 2)
    (hk : toElementary F g = 1) : g ∈ defectSubgroup F := by
  apply (QuotientGroup.eq_one_iff g).mp
  apply normal_eq_one_of_image (normal_of_mem_stage_two hg)
  change toStableGeneralLinear F g = 1
  exact congrArg Subtype.val hk

/-- All original defects, and their generated subgroup, lie in the original rank-two stage. -/
lemma defectSubgroup_le_stage_two : defectSubgroup F ≤ stage F 2 := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨a, b, rfl⟩
  exact (stage F 2).mul_mem ((stage F 2).mul_mem (h_mem_stage a) (h_mem_stage b))
    ((stage F 2).inv_mem (h_mem_stage (a * b)))

/-- The ordered defects generate exactly the intersection of the actual kernel with stage two. -/
theorem defectSubgroup_eq_stage_two_inf_kernel :
    defectSubgroup F = stage F 2 ⊓ (toElementary F).ker := by
  apply le_antisymm (le_inf defectSubgroup_le_stage_two (defectSubgroup_le_kernel F))
  intro g hg
  exact stage_two_kernel_mem_defectSubgroup hg.1 hg.2

/-- The remaining all-rank generation problem is exactly containment of the full kernel in
stage two. -/
theorem milnorToKernel_surjective_iff_kernel_le_stage_two :
    Function.Surjective (milnorToKernel F) ↔ (toElementary F).ker ≤ stage F 2 := by
  rw [milnorToKernel_surjective_iff]
  constructor
  · intro hgen
    rw [← hgen]
    exact defectSubgroup_le_stage_two
  · intro hstage
    apply le_antisymm (defectSubgroup_le_kernel F)
    intro g hg
    exact stage_two_kernel_mem_defectSubgroup (hstage hg) hg

end RankTwo
end Quillen.StableSteinberg.KernelGeneration
