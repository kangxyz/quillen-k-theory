module

public import Quillen.Waldhausen.Cofinality.Grading
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.GroupTheory.QuotientGroup.Defs

/-! # Universal algebraic grading of an actual Waldhausen category

Objects generate an abelian group subject to the original chosen-zero,
original weak-arrow and actual cofibration-pushout relations. This constructs
an honest additive grading, rather than assuming a homotopical K-zero
presentation. Its universal property is purely algebraic; the comparison
with the actual S-construction K-zero group is separate.
-/
@[expose] public section

noncomputable section
open CategoryTheory CategoryTheory.Limits
universe u v w
namespace Quillen.Waldhausen.AlgebraicGrothendieck
variable {C : Type u} [Category.{v} C] (W : Structure C)

/-- Only original categorical data generate the additive relations. -/
inductive Relation : FreeAbelianGroup C → Prop
  | zero : Relation (FreeAbelianGroup.of W.zero)
  | weak {A B : C} (f : A ⟶ B) (hf : W.weq f) :
      Relation (FreeAbelianGroup.of A - FreeAbelianGroup.of B)
  | pushout {A B D Q : C} {i : A ⟶ B} {f : A ⟶ D} {g : B ⟶ Q} {j : D ⟶ Q}
      (hi : W.cof i) (hQ : IsPushout i f g j) :
      Relation (FreeAbelianGroup.of Q -
        (FreeAbelianGroup.of B + FreeAbelianGroup.of D - FreeAbelianGroup.of A))

/-- The subgroup generated by precisely the displayed original relations. -/
def relations : AddSubgroup (FreeAbelianGroup C) := AddSubgroup.closure {r | Relation W r}

/-- The universal algebraic group; no homotopy-group identification is used. -/
abbrev Group := FreeAbelianGroup C ⧸ relations W

/-- An original object determines its canonical algebraic class. -/
def objectClass (A : C) : Group W := QuotientAddGroup.mk' (relations W) (FreeAbelianGroup.of A)

/-- Every original generating relation vanishes in the actual quotient. -/
theorem relation_zero {r : FreeAbelianGroup C} (hr : Relation W r) :
    QuotientAddGroup.mk' (relations W) r = 0 :=
  (QuotientAddGroup.eq_zero_iff r).mpr (AddSubgroup.subset_closure hr)

/-- The chosen original zero has zero algebraic class. -/
@[simp] theorem objectClass_zero : objectClass W W.zero = 0 := relation_zero W (Relation.zero (W
    := W))

/-- Original weak arrows determine equal algebraic classes. -/
theorem objectClass_weak {A B : C} (f : A ⟶ B) (hf : W.weq f) :
    objectClass W A = objectClass W B := by
  have h := relation_zero W (Relation.weak f hf)
  change objectClass W A - objectClass W B = 0 at h
  exact sub_eq_zero.mp h

/-- The original displayed cofibration pushout determines the additive class equation. -/
theorem objectClass_pushout {A B D Q : C} {i : A ⟶ B} {f : A ⟶ D} {g : B ⟶ Q} {j : D ⟶ Q}
    (hi : W.cof i) (hQ : IsPushout i f g j) :
    objectClass W Q = objectClass W B + objectClass W D - objectClass W A := by
  have h := relation_zero W (Relation.pushout hi hQ)
  change objectClass W Q - (objectClass W B + objectClass W D - objectClass W A) = 0 at h
  exact sub_eq_zero.mp h

/-- The universal grading is constructed entirely from original Waldhausen relations. -/
def grading : Cofinality.Grading W (Group W) where
  value := objectClass W
  zero := objectClass_zero W
  weak := objectClass_weak W
  pushout := objectClass_pushout W

variable {G : Type w} [AddCommGroup G] (d : Cofinality.Grading W G)

/-- Any original additive grading kills the entire relation subgroup. -/
theorem relations_le_ker : relations W ≤ (FreeAbelianGroup.lift d.value).ker := by
  apply (AddSubgroup.closure_le _).mpr
  intro r hr
  change FreeAbelianGroup.lift d.value r = 0
  cases hr with
  | zero => simpa using d.zero
  | weak f hf => simp [d.weak f hf]
  | pushout hi hQ => simp [d.pushout hi hQ]

/-- The unique algebraic homomorphism extending an original additive grading. -/
def lift : Group W →+ G := QuotientAddGroup.lift (relations W)
  (FreeAbelianGroup.lift d.value) (relations_le_ker W d)

/-- The extension evaluates on the original object, without a chosen representative. -/
@[simp] theorem lift_objectClass (A : C) : lift W d (objectClass W A) = d.value A := by
  simp [lift, objectClass]

/-- Object classes detect every outgoing algebraic homomorphism. -/
@[ext] theorem hom_ext (f g : Group W →+ G)
    (h : ∀ A : C, f (objectClass W A) = g (objectClass W A)) : f = g := by
  have hfg : f.comp (QuotientAddGroup.mk' (relations W)) =
      g.comp (QuotientAddGroup.mk' (relations W)) := FreeAbelianGroup.lift_ext _ _ h
  apply AddMonoidHom.ext
  intro x
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective (relations W) x
  exact DFunLike.congr_fun hfg a

/-- The universal property gives existence and uniqueness without any topological premise. -/
theorem universal : ∃! f : Group W →+ G, ∀ A : C, f (objectClass W A) = d.value A := by
  refine ⟨lift W d, lift_objectClass W d, ?_⟩
  intro f hf
  apply hom_ext W
  intro A
  exact (hf A).trans (lift_objectClass W d A).symm

end Quillen.Waldhausen.AlgebraicGrothendieck
