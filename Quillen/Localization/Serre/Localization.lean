module

public import Aglib.CategoryTheory.ExactCategory.Basic
public import Aglib.CategoryTheory.ExactCategory.Functor
public import Aglib.CategoryTheory.ExactCategory.Abelian
public import Quillen.KTheory.GrothendieckGroup.Map
public import Quillen.KTheory.Map.Basic
public import Mathlib.CategoryTheory.Abelian.SerreClass.Localization
public import Aglib.CategoryTheory.Abelian.SerreClass.Exact

/-!
# Serre quotient functors and their induced maps

The localization of an abelian category at the morphisms whose kernel and
cokernel belong to a Serre class is an actual abelian category. Its localization
functor is exact, and hence induces both a Q-functor and a homomorphism on the
homotopy groups defining Quillen K-theory. Objects in the Serre class become
zero objects, and their algebraic Grothendieck classes map to zero.

This is the exact-functor layer of localization. No homotopy fiber sequence,
long exact K-theory sequence, or identification of algebraic Grothendieck
groups with homotopical K₀ is asserted here.
-/
@[expose] public section

open CategoryTheory.ExactCategory



noncomputable section

universe v₁ v₂ v₃ u₁ u₂ u₃ v u

open CategoryTheory CategoryTheory.Limits

namespace Quillen.SerreLocalization

attribute [local instance] Abelian.hasFiniteBiproducts

section General

variable {C : Type u₁} {D : Type u₂} [Category.{v₁} C] [Category.{v₂} D]
  [Abelian C] [Abelian D] (P : ObjectProperty C) [P.IsSerreClass]
  (L : C ⥤ D) [L.IsLocalization P.isoModSerre] [L.Additive]

/-- The Q-construction map induced by an actual Serre localization. -/
def mapQ :
    Q (abelianExactStructure C).deflation (abelianExactStructure C).inflation ⥤
      Q (abelianExactStructure D).deflation (abelianExactStructure D).inflation :=
  (CategoryTheory.ExactCategory.ExactFunctor.serreLocalization P L).mapQ

@[simp]
lemma mapQ_obj_of (X : C) :
    (mapQ P L).obj
      (Q.of (abelianExactStructure C).deflation (abelianExactStructure C).inflation X) =
    Q.of (abelianExactStructure D).deflation (abelianExactStructure D).inflation
      (L.obj X) := rfl

/-- The Serre class is precisely the class of objects killed by localization. -/
lemma isZero_obj_iff (X : C) : IsZero (L.obj X) ↔ P X :=
  ObjectProperty.SerreClassLocalization.isZero_obj_iff L P X

/-- The algebraic Grothendieck-group map of a Serre localization. -/
def grothendieckMap :
    (abelianExactStructure C).GrothendieckGroup →+
      (abelianExactStructure D).GrothendieckGroup :=
  (CategoryTheory.ExactCategory.ExactFunctor.serreLocalization P L).grothendieckMap

@[simp]
lemma grothendieckMap_class (X : C) :
    grothendieckMap P L ((abelianExactStructure C).grothendieckClass X) =
      (abelianExactStructure D).grothendieckClass (L.obj X) :=
  (CategoryTheory.ExactCategory.ExactFunctor.serreLocalization P L).grothendieckMap_class X

/-- Every object of the Serre class has zero image in the algebraic
Grothendieck group of the quotient. -/
lemma grothendieckMap_class_eq_zero {X : C} (hX : P X) :
    grothendieckMap P L ((abelianExactStructure C).grothendieckClass X) = 0 := by
  rw [grothendieckMap_class]
  exact (abelianExactStructure D).grothendieckClass_of_isZero
    ((isZero_obj_iff P L X).2 hX)

open ZeroObject in
/-- At the level of Q-objects, a Serre-class object becomes isomorphic to the
chosen basepoint of the quotient Q-category. -/
def mapQObjIsoZero {X : C} (hX : P X) :
    (mapQ P L).obj
      (Q.of (abelianExactStructure C).deflation (abelianExactStructure C).inflation X) ≅
    Q.of (abelianExactStructure D).deflation (abelianExactStructure D).inflation
      (0 : D) :=
  (abelianExactStructure D).qIsoOfIso
    (((isZero_obj_iff P L X).2 hX).iso (isZero_zero D))

/-- The subgroup generated by the classes of objects of the Serre class. -/
def serreSubgroup : AddSubgroup (abelianExactStructure C).GrothendieckGroup :=
  AddSubgroup.closure {a | ∃ X : C, P X ∧
    a = (abelianExactStructure C).grothendieckClass X}

/-- Localization kills the entire subgroup generated by Serre-class objects. -/
lemma serreSubgroup_le_ker : serreSubgroup P ≤ (grothendieckMap P L).ker := by
  apply (AddSubgroup.closure_le _).2
  rintro a ⟨X, hX, rfl⟩
  exact grothendieckMap_class_eq_zero P L hX

/-- The localization map factors through the quotient by Serre-class objects.
The reverse kernel inclusion is not asserted by this construction. -/
def grothendieckMapModuloSerre :
    (abelianExactStructure C).GrothendieckGroup ⧸ serreSubgroup P →+
      (abelianExactStructure D).GrothendieckGroup :=
  QuotientAddGroup.lift (serreSubgroup P) (grothendieckMap P L)
    (serreSubgroup_le_ker P L)

@[simp]
lemma grothendieckMapModuloSerre_mk (a : (abelianExactStructure C).GrothendieckGroup) :
    grothendieckMapModuloSerre P L (QuotientAddGroup.mk a) = grothendieckMap P L a := rfl

/-- The algebraic Grothendieck-group map is surjective because the
localization functor is essentially surjective. -/
theorem grothendieckMap_surjective : Function.Surjective (grothendieckMap P L) := by
  have := Localization.essSurj L P.isoModSerre
  intro a
  obtain ⟨z, rfl⟩ :=
    QuotientAddGroup.mk'_surjective (abelianExactStructure D).grothendieckRelations a
  induction z using FreeAbelianGroup.induction_on with
  | zero => exact ⟨0, by simp⟩
  | of Y =>
    refine ⟨(abelianExactStructure C).grothendieckClass (L.objPreimage Y), ?_⟩
    exact (grothendieckMap_class P L _).trans
      ((abelianExactStructure D).grothendieckClass_iso (L.objObjPreimageIso Y))
  | neg Y hY =>
    obtain ⟨x, hx⟩ := hY
    exact ⟨-x, by simp [hx]⟩
  | add x y hx hy =>
    obtain ⟨x', hx'⟩ := hx
    obtain ⟨y', hy'⟩ := hy
    exact ⟨x' + y', by simp [hx', hy']⟩

/-- The factored algebraic map remains surjective. This is not a claim that
its kernel is zero. -/
theorem grothendieckMapModuloSerre_surjective :
    Function.Surjective (grothendieckMapModuloSerre P L) := by
  intro a
  obtain ⟨x, hx⟩ := grothendieckMap_surjective P L a
  exact ⟨QuotientAddGroup.mk x, hx⟩

/-- Any exact functor whose objects lie in the Serre class has zero composite
with localization on algebraic Grothendieck groups. -/
theorem grothendieckMap_comp_eq_zero
    {B : Type u₃} [Category.{v₃} B] [Preadditive B] [HasFiniteBiproducts B]
    {EB : ExactStructure B} (F : ExactFunctor EB (abelianExactStructure C))
    (hF : ∀ X : B, P (F.toFunctor.obj X)) :
    (grothendieckMap P L).comp F.grothendieckMap = 0 := by
  apply EB.grothendieck_hom_ext
  intro X
  simp only [AddMonoidHom.comp_apply,
    CategoryTheory.ExactCategory.ExactFunctor.grothendieckMap_class,
    AddMonoidHom.zero_apply]
  exact grothendieckMap_class_eq_zero P L (hF X)

end General

section Homotopical

variable {C D : Type u} [Category.{v} C] [Category.{v} D]
  [Abelian C] [Abelian D] (P : ObjectProperty C) [P.IsSerreClass]
  (L : C ⥤ D) [L.IsLocalization P.isoModSerre] [L.Additive]

/-- The genuine Quillen K-group homomorphism induced by a Serre localization.
This definition alone does not assert a localization exact sequence. -/
def KMap (n : ℕ) : (abelianExactStructure C).K n →* (abelianExactStructure D).K n :=
  (CategoryTheory.ExactCategory.ExactFunctor.serreLocalization P L).KMap n

end Homotopical

section CanonicalQuotient

variable {C : Type u} [Category.{u} C] [Abelian C]
  (P : ObjectProperty C) [P.IsSerreClass]

@[instance_reducible]
local instance canonicalQuotientAbelian
    {C₀ : Type u} [Category.{u} C₀] [Abelian C₀]
    (P₀ : ObjectProperty C₀) [P₀.IsSerreClass] :
    Abelian P₀.isoModSerre.Localization :=
  ObjectProperty.SerreClassLocalization.abelian P₀.isoModSerre.Q P₀

/-- The Q-functor from the abelian category to its canonical Serre quotient. -/
def quotientMapQ :
    Q (abelianExactStructure C).deflation (abelianExactStructure C).inflation ⥤
      Q ((abelianExactStructure P.isoModSerre.Localization)).deflation ((abelianExactStructure
        P.isoModSerre.Localization)).inflation :=
  ((CategoryTheory.ExactCategory.ExactFunctor.serreLocalization P P.isoModSerre.Q)).mapQ

/-- The induced map to the K-theory of the actual Serre quotient. -/
def quotientKMap (n : ℕ) :
    (abelianExactStructure C).K n →* ((abelianExactStructure P.isoModSerre.Localization)).K n :=
  ((CategoryTheory.ExactCategory.ExactFunctor.serreLocalization P P.isoModSerre.Q)).KMap n

/-- The induced map to the algebraic Grothendieck group of the Serre quotient. -/
def quotientGrothendieckMap :
    (abelianExactStructure C).GrothendieckGroup →+
      ((abelianExactStructure P.isoModSerre.Localization)).GrothendieckGroup :=
  ((CategoryTheory.ExactCategory.ExactFunctor.serreLocalization P P.isoModSerre.Q)).grothendieckMap

/-- The canonical quotient annihilates exactly the objects of the Serre class. -/
lemma quotient_isZero_obj_iff (X : C) : IsZero (P.isoModSerre.Q.obj X) ↔ P X :=
  isZero_obj_iff P P.isoModSerre.Q X

/-- Serre-class object classes vanish under the canonical quotient map. -/
lemma quotientGrothendieckMap_class_eq_zero {X : C} (hX : P X) :
    quotientGrothendieckMap P ((abelianExactStructure C).grothendieckClass X) = 0 :=
  grothendieckMap_class_eq_zero P P.isoModSerre.Q hX

/-- The canonical Serre quotient map is surjective on algebraic
Grothendieck groups. -/
theorem quotientGrothendieckMap_surjective :
    Function.Surjective (quotientGrothendieckMap P) :=
  grothendieckMap_surjective P P.isoModSerre.Q

end CanonicalQuotient

end Quillen.SerreLocalization
