module

public import Quillen.Topology.LocalCoefficients.SourceCapCoboundary

/-!
# Descent of the marked finite integral chain equation

The exact original chain relation is evaluated after the constructed joint
vertex straightening for an injective map. The target boundary vanishes by the
actual tetrahedron cocycle. The source contribution becomes the coboundary of
the actual finite source-edge assignment and vanishes on the given original
source cycle. The marked spherical difference retains its original Pi-two class.
-/

@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
open CategoryTheory Limits Convexity
open scoped Simplicial Topology
universe u

namespace Quillen.LocalCoefficients
open HomotopyFiber
variable {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y]
variable [PathConnectedSpace X] [SimplyConnectedSpace Y]
variable (j : C(X, Y)) (hj : Function.Injective j) (x : X)

/-- Every vertex restriction of an originally based simplex remains based. -/
theorem finiteVertexRestrictionClosure_vertices {Z : Type u} [TopologicalSpace Z]
    {N : ℕ} (z : Z) (s : Finset C(StdSimplex ℝ (Fin (N + 1)), Z))
    (hs : ∀ a ∈ s, SimplexVerticesAt z a) (d : ℕ)
    (a : C(StdSimplex ℝ (Fin (d + 1)), Z))
    (ha : a ∈ finiteVertexRestrictionClosure s d) : SimplexVerticesAt z a := by
  obtain ⟨_, b, hb, α, rfl⟩ := (mem_finiteVertexRestrictionClosure s a).mp ha
  intro i
  change b ((StdSimplex.single i).map α) = z
  rw [StdSimplex.map_single]
  exact hs b hb _

omit [PathConnectedSpace X] [SimplyConnectedSpace Y] in
/-- The full fixed family generated by the marked spherical and constant simplices is based. -/
theorem sphericalStraighteningFixedFamily_vertices (a : SphericalSimplex Y (j x) 2)
    (d : ℕ) (b : C(StdSimplex ℝ (Fin (d + 1)), Y))
    (hb : b ∈ sphericalStraighteningFixedFamily a d) : SimplexVerticesAt (j x) b := by
  classical
  rcases Finset.mem_union.mp hb with hb | hb
  · exact finiteVertexRestrictionClosure_vertices (j x) {a.val}
      (fun c hc ↦ (Finset.mem_singleton.mp hc) ▸ sphericalTriangle_vertex a) d b hb
  · exact finiteVertexRestrictionClosure_vertices (j x) {ContinuousMap.const _ (j x)}
      (fun c hc ↦ (Finset.mem_singleton.mp hc) ▸ fun _ ↦ rfl) d b hb

include hj in
/-- The marked original finite chain equation forces its original connecting class to vanish
in the abelianization of the actual fiber group. -/
theorem connectingAbelianization_zero_of_finite_chain_equation
    (a : SphericalSimplex Y (j x) 2)
    (c : Finset (SingularSimplex X ⦋2⦌)) (v : ∀ _τ, ULift.{u} ℤ)
    (b : Finset (SingularSimplex Y ⦋3⦌)) (w : ∀ _τ, ULift.{u} ℤ)
    (hc : (singularChainComplex (constant X integralCoefficientModule.{u})).d 2 1
      (∑ τ ∈ c, chainInclusion (constant X integralCoefficientModule.{u}) τ (v τ)) = 0)
    (heq : (singularChainComplex (constant Y integralCoefficientModule.{u})).d 3 2
      (∑ τ ∈ b, chainInclusion (constant Y integralCoefficientModule.{u}) τ (w τ)) =
      sphericalTwoChain a -
        (pushforwardChainMap j (constant Y integralCoefficientModule.{u})).f 2
          (∑ τ ∈ c, chainInclusion (constant X integralCoefficientModule.{u}) τ (v τ))) :
    connectingAbelianization j x (Additive.ofMul a.homotopyClassStick) = 0 := by
  classical
  let S := finiteVertexRestrictionClosure c
  let B := finiteVertexRestrictionClosure b
  let F := sphericalStraighteningFixedFamily a
  let hS := finiteVertexRestrictionClosure_faceClosed c
  let hB := finiteVertexRestrictionClosure_faceClosed b
  let hF := sphericalStraighteningFixedFamily_faceClosed a
  obtain ⟨R, P, hRP⟩ := exists_joint_finite_vertex_straightening j hj x S hS B F hB hF
    (sphericalStraighteningFixedFamily_vertices j x a) 4
  let C := ∑ τ ∈ c, chainInclusion (constant X integralCoefficientModule.{u}) τ (v τ)
  let D := ∑ τ ∈ b, chainInclusion (constant Y integralCoefficientModule.{u}) τ (w τ)
  let q := pushforwardChainMap j (constant Y integralCoefficientModule.{u})
  let E := integralChainEvaluation 2 (finiteTwoCapValue P)
  let E₁ := integralChainEvaluation 1 (finiteOneCapValue j x R (by omega))
  have hEnd (τ : {τ // τ ∈ S 2}) :
      P.endpoint 2 (jointTargetSourceIndex j S B F 2 τ) = j.comp (R.endpoint 2 τ) := by
    ext t
    exact congrArg (fun H ↦ H (t, 1)) (hRP 2 (by omega) τ)
  have hvalue (τ : {τ // τ ∈ S 2}) :
      finiteTwoCapValue P (j.comp τ.val) =
      basedTriangleValue (j x) (j.comp (R.endpoint 2 τ))
        (fun i ↦ congrArg j (R.endpoint_vertices 2 (by omega) τ i)) := by
    change finiteTwoCapValue P (jointTargetSourceIndex j S B F 2 τ).val = _
    rw [finiteTwoCapValue, dite_eq_left (jointTargetSourceIndex j S B F 2 τ).property, hEnd]
    exact integralTwoCapValue_based (j x) _ _
  have hpush (τ : SingularSimplex X ⦋2⦌) (r : ULift.{u} ℤ) :
      q.f 2 (chainInclusion (constant X integralCoefficientModule.{u}) τ r) =
        chainInclusion (constant Y integralCoefficientModule.{u}) (j.comp τ) r :=
    ConcreteCategory.congr_hom
      (chainInclusion_pushforwardModuleMap j (constant Y integralCoefficientModule.{u}) τ) r
  have hsource : connectingAbelianization j x (E (q.f 2 C)) = 0 := by
    calc
      _ = E₁ ((singularChainComplex (constant X integralCoefficientModule.{u})).d 2 1 C) := by
        dsimp only [C]
        simp only [map_sum]
        apply Finset.sum_congr rfl
        intro τ hτ
        have hτS : τ ∈ S 2 := mem_finiteVertexRestrictionClosure_self c hτ
        rw [hpush, integralChainEvaluation_inclusion, hvalue ⟨τ, hτS⟩]
        exact finite_sourceTriangle_cap_coboundary j x R (by omega) ⟨τ, hτS⟩ (v τ)
      _ = 0 := by rw [hc, map_zero]
  have htarget : E
      ((singularChainComplex (constant Y integralCoefficientModule.{u})).d 3 2 D) = 0 :=
    finiteTwoCapValue_finite_boundary P (by omega) b w (fun τ hτ ↦
      Finset.mem_union.mpr (Or.inl (mem_finiteVertexRestrictionClosure_self b hτ)))
  have hmarked : E (sphericalTwoChain a) = Additive.ofMul a.homotopyClassStick := by
    have haF : a.val ∈ F 2 := mem_sphericalStraighteningFixedFamily_input a
    have hcF : ContinuousMap.const _ (j x) ∈ F 2 :=
      mem_sphericalStraighteningFixedFamily_const a (by omega)
    have hinc (τ : SingularSimplex Y ⦋2⦌) (hτ : τ ∈ F 2) :
        τ ∈ jointTargetFamily j S B F 2 :=
      Finset.mem_union.mpr (Or.inr (Finset.mem_union.mpr (Or.inr hτ)))
    exact finiteTwoCapValue_sphericalTwoChain P a (hinc _ haF) haF (hinc _ hcF) hcF
  have heval := congrArg E heq
  rw [htarget, map_sub, hmarked] at heval
  have hclass : Additive.ofMul a.homotopyClassStick = E (q.f 2 C) :=
    sub_eq_zero.mp heval.symm
  exact (congrArg (connectingAbelianization j x) hclass).trans hsource

end Quillen.LocalCoefficients
