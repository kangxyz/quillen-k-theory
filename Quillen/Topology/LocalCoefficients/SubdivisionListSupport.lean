module

public import Quillen.Topology.LocalCoefficients.SubdivisionListChains
public import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# Degree and carrier control for the constructed subdivision

The predicates below mean actual finite sums of the indicated ordered simplices.
We prove that boundary, subdivision and its explicit homotopy have the required
degrees, and that the latter two remain in every carrier closed under the chosen
nonempty centers.
-/

@[expose] public section

noncomputable section

namespace Quillen.SubdivisionListChains

universe u v

variable {P : Type u}

/-- Finite integral chains generated by the lists satisfying a predicate. -/
inductive Supported (S : List P → Prop) : Chain P → Prop
  | zero : Supported S 0
  | generator (l : List P) (h : S l) : Supported S (generator l)
  | add {c d : Chain P} : Supported S c → Supported S d → Supported S (c + d)
  | neg {c : Chain P} : Supported S c → Supported S (-c)

/-- The actual additive subgroup spanned by the specified lists. -/
def supportedSubgroup (S : List P → Prop) : AddSubgroup (Chain P) where
  carrier := Supported S
  zero_mem' := Supported.zero
  add_mem' := Supported.add
  neg_mem' := Supported.neg

/-- Signed integer multiples retain the same support constraint. -/
theorem Supported.zsmul {S : List P → Prop} {c : Chain P}
    (hc : Supported S c) (z : ℤ) : Supported S (z • c) :=
  (supportedSubgroup S).zsmul_mem hc z

/-- A finite sum retains its support constraint. -/
theorem Supported.sum {S : List P → Prop} {I : Type v} (s : Finset I) (c : I → Chain P)
    (hc : ∀ i ∈ s, Supported S (c i)) : Supported S (∑ i ∈ s, c i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using (Supported.zero (S := S))
  | @insert i s hi ih =>
    rw [Finset.sum_insert hi]
    exact (hc i (Finset.mem_insert_self i s)).add
      (ih (fun j hj ↦ hc j (Finset.mem_insert_of_mem hj)))

/-- Subtracting chains retains the support constraint. -/
theorem Supported.sub {S : List P → Prop} {c d : Chain P}
    (hc : Supported S c) (hd : Supported S d) : Supported S (c - d) := by
  simpa only [sub_eq_add_neg] using hc.add hd.neg

/-- Extend a checked generator property to actual finite integral sums. -/
theorem Supported.map {Q : Type v} {S : List P → Prop} {T : List Q → Prop}
    (f : Chain P →+ Chain Q) (hf : ∀ l, S l → Supported T (f (SubdivisionListChains.generator l)))
    {c : Chain P} (hc : Supported S c) : Supported T (f c) := by
  induction hc with
  | zero => simpa only [map_zero] using (Supported.zero (S := T))
  | generator l hl => exact hf l hl
  | add hc hd ihc ihd => simpa only [map_add] using ihc.add ihd
  | neg hc ihc => simpa only [map_neg] using ihc.neg

/-- Every summand has exactly `n` vertices; the empty augmentation has degree zero. -/
abbrev Homogeneous (n : ℕ) (c : Chain P) : Prop := Supported (fun l ↦ l.length = n) c

/-- Every vertex of every summand lies in the given carrier. -/
abbrev Carried (S : Set P) (c : Chain P) : Prop := Supported (fun l ↦ ∀ p ∈ l, p ∈ S) c

/-- Coning raises the number of vertices by one. -/
theorem Homogeneous.cone {n : ℕ} {c : Chain P} (hc : Homogeneous n c) (p : P) :
    Homogeneous (n + 1) (cone p c) := by
  apply hc.map (SubdivisionListChains.cone p)
  intro l hl
  rw [cone_generator]
  exact Supported.generator _ (by simpa only [List.length_cons] using congrArg Nat.succ hl)

/-- The boundary of an `n+1`-vertex chain has `n` vertices. -/
theorem Homogeneous.boundary {n : ℕ} {c : Chain P} (hc : Homogeneous (n + 1) c) :
    Homogeneous n (boundary c) := by
  apply hc.map SubdivisionListChains.boundary
  intro l hl
  rw [boundary_generator_eq_sum]
  apply Supported.sum
  intro i _
  apply Supported.zsmul
  apply Supported.generator
  have := List.length_eraseIdx_add_one i.isLt
  omega

/-- Recursive coning subdivision preserves the actual number of vertices. -/
theorem Homogeneous.subdivision (center : List P → P) {n : ℕ} {c : Chain P}
    (hc : Homogeneous n c) : Homogeneous n (SubdivisionListChains.subdivision center c) := by
  apply hc.map (SubdivisionListChains.subdivision center)
  suffices h : ∀ l : List P,
      Homogeneous l.length (SubdivisionListChains.subdivision center (generator l)) by
    intro l hl
    simpa only [hl] using h l
  intro l
  induction hn : l.length using Nat.strong_induction_on generalizing l with
  | h n ih =>
    by_cases hl : l = []
    · subst l
      simpa only [subdivision_generator, subdivisionGenerator_nil] using
        (Supported.generator [] hn)
    · rw [subdivision_generator_nonempty center l hl, boundary_generator_eq_sum, map_sum]
      have hnpos : 0 < n := by simpa only [← hn, List.length_pos_iff] using hl
      obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hnpos)
      apply Homogeneous.cone
      apply Supported.sum
      intro i _
      rw [map_zsmul]
      apply Supported.zsmul
      have hi : (l.eraseIdx i.val).length = m := by
        have := List.length_eraseIdx_add_one i.isLt
        omega
      simpa only [hi] using ih m (by omega) (l.eraseIdx i.val) hi

/-- The recursive homotopy raises the number of vertices by one. -/
theorem Homogeneous.homotopy (center : List P → P) {n : ℕ} {c : Chain P}
    (hc : Homogeneous n c) : Homogeneous (n + 1) (SubdivisionListChains.homotopy center c) := by
  apply hc.map (SubdivisionListChains.homotopy center)
  suffices h : ∀ l : List P,
      Homogeneous (l.length + 1) (SubdivisionListChains.homotopy center (generator l)) by
    intro l hl
    simpa only [hl] using h l
  intro l
  induction hn : l.length using Nat.strong_induction_on generalizing l with
  | h n ih =>
    by_cases hl : l = []
    · subst l
      simp only [homotopy_generator, homotopyGenerator_nil]
      exact Supported.zero
    · rw [homotopy_generator_nonempty center l hl]
      apply Homogeneous.cone
      apply Supported.sub
      · exact (show Homogeneous n (generator l) from Supported.generator l hn).sub
          (Homogeneous.subdivision center (Supported.generator l hn))
      · rw [boundary_generator_eq_sum, map_sum]
        apply Supported.sum
        intro i _
        rw [map_zsmul]
        apply Supported.zsmul
        have hi := List.length_eraseIdx_add_one i.isLt
        simpa only [hi, hn] using ih (l.eraseIdx i.val).length (by omega) (l.eraseIdx i.val) rfl

end Quillen.SubdivisionListChains
