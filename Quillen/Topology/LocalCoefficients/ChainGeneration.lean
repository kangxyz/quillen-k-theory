module

public import Quillen.Topology.LocalCoefficients.Chains

/-!
# Generation of actual twisted singular chains

The original coproduct chain module is generated by its actual coefficient
fibers. This permits finite additive arguments without replacing a local
coefficient system by constant coefficients.
-/

@[expose] public section

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

open CategoryTheory Limits

universe u

namespace Quillen.LocalCoefficients

variable {X : Type u} [TopologicalSpace X]

/-- A submodule containing every actual simplex coefficient summand is the
entire original chain module. -/
theorem chainModule_submodule_eq_top (A : System.{u, u} X) (n : SimplexCategory)
    (P : Submodule ℤ (chainModule A n))
    (hP : ∀ (σ : SingularSimplex X n) (x : simplexFiber A σ), chainInclusion A σ x ∈ P) :
    P = ⊤ := by
  let : Module ℤ P := P.module
  let r : chainModule A n ⟶ ModuleCat.of ℤ P :=
    Sigma.desc fun σ ↦ ModuleCat.ofHom ((chainInclusion A σ).hom.codRestrict P (hP σ))
  have hr : r ≫ ModuleCat.ofHom P.subtype = 𝟙 (chainModule A n) := by
    apply Sigma.hom_ext
    intro σ
    change chainInclusion A σ ≫ _ = chainInclusion A σ ≫ _
    simp only [r, chainInclusion, Sigma.ι_comp_desc_assoc, Category.comp_id]
    rfl
  apply top_unique
  intro x _
  have hx := congrArg (fun f ↦ f x) hr
  change (r x).val = x at hx
  exact hx ▸ (r x).property

end Quillen.LocalCoefficients
