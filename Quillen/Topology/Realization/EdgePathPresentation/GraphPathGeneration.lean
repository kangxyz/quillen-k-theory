module

public import Quillen.Topology.Realization.EdgePathPresentation.GraphAnchors
public import Mathlib.Topology.Connected.TotallyDisconnected

/-!
# Actual graph paths are generated by the original edge morphisms

For a discrete family of geometric intervals attached to a discrete vertex
space, compatibility on the original vertices and whole edges suffices to
represent every continuous path by a morphism of the original groupoid.
The path may traverse infinitely many portions of edges before subdivision;
no edge-path approximation is assumed in the theorem.
-/
@[expose] public section

noncomputable section
universe u v w
open CategoryTheory CategoryTheory.Limits Convexity Topology Set
open scoped Topology unitInterval
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
namespace Quillen.GraphAttachment

variable (X : TopCat.{u}) [DiscreteTopology X] {V D Y : TopCat.{u}}
    [DiscreteTopology V]
    {f : TopCat.of (X × simplexBoundary 1) ⟶ V}
    {g : TopCat.of (X × StdSimplex ℝ (Fin 2)) ⟶ D} {j : V ⟶ D}
    (sq : IsPushout (parameterizedSimplexBoundaryInclusion X 1) f g j)
    (h : C(D, Y)) {A : Type v} [Groupoid.{w} A]
    (F : A ⥤ FundamentalGroupoid Y) (vertex : V → A)
    (ε : ∀ c : V, F.obj (vertex c) ≅ FundamentalGroupoid.mk (h (j c)))
    (edge : ∀ a : X, vertex (f (a, boundaryZero)) ⟶ vertex (f (a, boundaryOne)))
    (hedge : ∀ a : X, spoke X sq h F vertex ε a (StdSimplex.single 1) =
      F.map (edge a) ≫ (vertexIso X sq h F vertex ε a boundaryOne).hom)

omit [DiscreteTopology X] [DiscreteTopology V] in
/-- The path-image subgroupoid obtained by closing an actual graph path with
its two selected vertex anchors. -/
def pathImage (anchor : ∀ z : D, Anchor X sq h F vertex ε z) :
    Subgroupoid (FundamentalGroupoid D) where
  arrows x y := {p | ∃ q : (anchor x.as).obj ⟶ (anchor y.as).obj,
    F.map q = (anchor x.as).hom ≫ (FundamentalGroupoid.map h).map p ≫
      Groupoid.inv (anchor y.as).hom}
  inv := by
    rintro x y p ⟨q, hq⟩
    refine ⟨inv q, ?_⟩
    have hinv : (FundamentalGroupoid.map h).map (Groupoid.inv p) =
        Groupoid.inv ((FundamentalGroupoid.map h).map p) := by
      simpa only [Groupoid.inv_eq_inv] using (FundamentalGroupoid.map h).map_inv p
    rw [hinv]
    simpa [Functor.map_inv, Category.assoc, Groupoid.inv_eq_inv] using
      congrArg Groupoid.inv hq
  mul := by
    rintro x y z p ⟨q, hq⟩ r ⟨s, hs⟩
    refine ⟨q ≫ s, ?_⟩
    rw [F.map_comp, (FundamentalGroupoid.map h).map_comp, hq, hs]
    simp [Category.assoc, Groupoid.inv_eq_inv]

/-- The original groupoid image contains every actual continuous graph path
after transport through the selected vertex anchors. -/
theorem pathImage_eq_top
    (anchor : ∀ z : D, Anchor X sq h F vertex ε z) :
    pathImage X sq h F vertex ε anchor = ⊤ := by
  apply simplexAttachment_subgroupoid_eq_top X 1 sq
  · intro x y p
    have hpconst (t : unitInterval) : p t = x :=
      (PreconnectedSpace.constant inferInstance p.continuous (x := t) (y := 0)).trans p.source
    have hxy : y = x := p.target.symm.trans (hpconst 1)
    subst y
    have hp : p = Path.refl x := by ext t; exact hpconst t
    rw [hp]
    refine ⟨𝟙 _, ?_⟩
    have hrefl : (Path.refl x).map j.hom.continuous = Path.refl (j x) := by ext t; rfl
    rw [hrefl]
    change F.map (𝟙 _) = (anchor (j x)).hom ≫
      (FundamentalGroupoid.map h).map (𝟙 (FundamentalGroupoid.mk (j x))) ≫
        Groupoid.inv (anchor (j x)).hom
    rw [(FundamentalGroupoid.map h).map_id, F.map_id]
    change 𝟙 _ = (anchor (j x)).hom ≫
      𝟙 (FundamentalGroupoid.mk (h (j x))) ≫ Groupoid.inv (anchor (j x)).hom
    rw [Category.id_comp, Groupoid.comp_inv]
  · intro a x y p
    obtain ⟨qx, hqx⟩ := (anchor (g (a, x))).cell a x rfl
    obtain ⟨qy, hqy⟩ := (anchor (g (a, y))).cell a y rfl
    simp only [eqToHom_refl, Category.comp_id] at hqx hqy
    refine ⟨qx ≫ inv qy, ?_⟩
    apply (cancel_mono (anchor (g (a, y))).hom).mp
    simp only [Category.assoc, Groupoid.inv_comp, Category.comp_id]
    rw [hqx, hqy]
    simp only [F.map_comp, F.map_inv, Category.assoc, IsIso.inv_hom_id_assoc]
    change F.map qx ≫ spoke X sq h F vertex ε a y =
      F.map qx ≫ spoke X sq h F vertex ε a x ≫
        (⟦p.map (h.comp (simplexAttachmentCellMap X 1 (g := g) a)).continuous⟧ :
          FundamentalGroupoid.mk (h (g (a, x))) ⟶
            FundamentalGroupoid.mk (h (g (a, y))))
    rw [spoke_comp]

include hedge in
/-- Every genuine path between original graph vertices is represented by an
original groupoid arrow, with the specified original-vertex identifications. -/
theorem path_from_original_edges {c d : V} (p : Path (j c) (j d)) :
    ∃ q : vertex c ⟶ vertex d,
      F.map q = (ε c).hom ≫
        (⟦p.map h.continuous⟧ : FundamentalGroupoid.mk (h (j c)) ⟶
          FundamentalGroupoid.mk (h (j d))) ≫ (ε d).inv := by
  let anchor (z : D) : Anchor X sq h F vertex ε z :=
    Classical.choice (anchor_nonempty X sq h F vertex ε edge hedge z)
  have htop := pathImage_eq_top X sq h F vertex ε anchor
  have hp : (⟦p⟧ : FundamentalGroupoid.mk (j c) ⟶ FundamentalGroupoid.mk (j d)) ∈
      (pathImage X sq h F vertex ε anchor).arrows _ _ := by
    rw [htop]
    trivial
  obtain ⟨q, hq⟩ := hp
  obtain ⟨qc, hqc⟩ := (anchor (j c)).old c rfl
  obtain ⟨qd, hqd⟩ := (anchor (j d)).old d rfl
  simp only [eqToHom_refl, Category.comp_id] at hqc hqd
  refine ⟨inv qc ≫ q ≫ qd, ?_⟩
  rw [F.map_comp, F.map_comp, F.map_inv, hq]
  simp only [hqc, hqd]
  simp [Category.assoc, Groupoid.inv_eq_inv, ← Path.Homotopic.Quotient.mk_map]

end Quillen.GraphAttachment
