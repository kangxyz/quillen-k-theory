module

public import Quillen.Topology.Realization.EdgePathPresentation.SimplicialGraph

/-! # Actual realization paths are generated by original simplicial edges

A groupoid functor which represents every original simplicial edge, using
specified original vertex identifications, represents every actual path class
between those vertices. The statement uses the proved actual skeletal fullness
and graph subdivision, rather than an assumed edge approximation principle.
-/
@[expose] public section

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
open CategoryTheory CategoryTheory.Limits Convexity Topology
open scoped Simplicial Topology unitInterval
universe u v w
namespace Quillen.SimplicialGraph
variable (X : SSet.{u}) {A : Type v} [Groupoid.{w} A]
  (F : A ⥤ FundamentalGroupoid |X|) (vertex : X _⦋0⦌ → A)
  (ε : ∀ x, F.obj (vertex x) ≅ FundamentalGroupoid.mk (realizationPoint x))
  (edge : ∀ {x y : X _⦋0⦌}, X.Edge x y → (vertex x ⟶ vertex y))
  (hedge : ∀ {x y : X _⦋0⦌} (e : X.Edge x y),
    F.map (edge e) = (ε x).hom ≫ ⟦realizationEdgePath e⟧ ≫ (ε y).inv)

/-- The specified original vertex identification at an actual old-stage point. -/
def vertexIdentification (c : Old X) :
    F.obj (vertex (oldVertex X c)) ≅ FundamentalGroupoid.mk (inclusion X (transition X c)) :=
  ε (oldVertex X c) ≪≫ eqToIso (congrArg FundamentalGroupoid.mk (oldVertex_point X c))

/-- The graph boundary identification retains exactly the specified original anchor. -/
theorem vertexIso_hom (a : Index X) (b : simplexBoundary 1) :
    (GraphAttachment.vertexIso (Index X) (pushout X) (inclusion X) F
      (fun c ↦ vertex (oldVertex X c)) (vertexIdentification X F vertex ε) a b).hom =
        (ε (oldVertex X (attaching X (a, b)))).hom ≫
          eqToHom (congrArg FundamentalGroupoid.mk (vertexPoint X a b)) := by
  simp only [GraphAttachment.vertexIso, vertexIdentification, Iso.trans_hom,
    eqToIso.hom, Category.assoc, eqToHom_trans]

include hedge in
/-- Original simplicial edge compatibility gives actual whole-cell spoke compatibility. -/
theorem edge_spoke (a : Index X) :
    GraphAttachment.spoke (Index X) (pushout X) (inclusion X) F
      (fun c ↦ vertex (oldVertex X c)) (vertexIdentification X F vertex ε) a
        (StdSimplex.single 1) =
      F.map (edge (originalEdge X a)) ≫
        (GraphAttachment.vertexIso (Index X) (pushout X) (inclusion X) F
          (fun c ↦ vertex (oldVertex X c)) (vertexIdentification X F vertex ε) a
            boundaryOne).hom := by
  dsimp only [GraphAttachment.spoke]
  rw [vertexIso_hom, vertexIso_hom, hedge]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  apply (cancel_mono (eqToHom
    (congrArg FundamentalGroupoid.mk (vertexPoint X a boundaryOne).symm))).mp
  have hp := congrArg (fun q ↦ (ε (oldVertex X (attaching X (a, boundaryZero)))).hom ≫ q)
    (cell_path_class X a)
  simp only [Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id] at hp ⊢
  exact hp

include hedge in
/-- Every actual continuous path class between original vertices comes from
an original groupoid arrow if each original simplicial edge does. -/
theorem map_surjective_of_edges (x y : X _⦋0⦌) :
    Function.Surjective (F.map : (vertex x ⟶ vertex y) →
      (F.obj (vertex x) ⟶ F.obj (vertex y))) := by
  let : (FundamentalGroupoid.map (inclusion X)).Full :=
    realizedSkeleton_fundamentalGroupoid_full X 2 le_rfl
  obtain ⟨c, rfl⟩ := (oldHomeomorph X).surjective x
  obtain ⟨d, rfl⟩ := (oldHomeomorph X).surjective y
  exact GraphAttachment.map_surjective_of_ambient_full
    (Index X) (pushout X) (inclusion X) F (fun c ↦ vertex (oldVertex X c))
    (vertexIdentification X F vertex ε) (fun a ↦ edge (originalEdge X a))
    (edge_spoke X F vertex ε edge hedge) c d

end Quillen.SimplicialGraph
