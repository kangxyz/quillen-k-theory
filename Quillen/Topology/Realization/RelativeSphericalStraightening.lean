module

public import Quillen.Topology.Realization.FiniteSimplexStraightening
public import Quillen.Topology.Realization.SimplexSkeleton

/-!
# Relative straightening of finite support while fixing a spherical input

The constructed homotopies collapse the genuine barycentric `(n - 1)`-skeleton
of every simplex through degree `n + 1`. The finite family contains the actual
support maps, the selected spherical simplex and all their vertex restrictions.
The selected simplex, every one of its faces, and the constant simplices are
stationary throughout the homotopy. No assumption on Pi n or Pi (n + 1) occurs.
-/

@[expose] public section
noncomputable section

open Convexity
open scoped Topology unitInterval

universe u

namespace Quillen

variable {Z : Type u} [TopologicalSpace Z]

namespace PartialSimplexStraightening

variable {n N : ℕ} {z : Z} {S F : FiniteSimplexFamily Z} {hS : S.FaceClosed}

/-- Every endpoint collapses its entire geometric `(n - 1)`-skeleton. -/
theorem endpoint_skeleton (P : PartialSimplexStraightening n z S F hS N)
    (d : ℕ) (hd : d < N) (s : {s // s ∈ S d})
    (x : StdSimplex ℝ (Fin (d + 1))) (hx : x ∈ simplexSkeleton n d) :
    P.endpoint d s x = z := by
  induction d with
  | zero =>
    by_cases hn : 0 < n
    · exact P.top 0 hd hn s x
    · have hn0 : n = 0 := by omega
      subst n
      simp only [simplexSkeleton_zero, Set.mem_empty_iff_false] at hx
  | succ d ih =>
    by_cases hn : d + 1 < n
    · exact P.top (d + 1) hd hn s x
    · obtain ⟨i, y, hy, rfl⟩ := simplexSkeleton_face_preimage (by omega) x hx
      exact (P.face d hd s i y 1).trans (ih (by omega) (hS.face s i) y hy)

/-- Every endpoint in the cutoff dimension is a genuine spherical simplex. -/
def sphericalEndpoint (P : PartialSimplexStraightening n z S F hS N)
    (hn : n < N) (s : {s // s ∈ S n}) : SphericalSimplex Z z n := by
  refine ⟨P.endpoint n s, ?_⟩
  intro x hx
  cases n with
  | zero =>
    let := isEmpty_simplexBoundary_zero
    exact isEmptyElim (⟨x, hx⟩ : simplexBoundary 0)
  | succ n =>
    obtain ⟨⟨i, y, t⟩, ht⟩ :=
      simplexFaceCylinderCover_surjective n ((⟨x, hx⟩ : simplexBoundary (n + 1)), (1 : I))
    have hxy : y.map i.succAbove = x := congrArg (fun q ↦ q.1.val) ht
    rw [← hxy]
    exact (P.face n hn s i y 1).trans (P.top n (by omega) (by omega) _ y)

/-- A selected endpoint is literally the original map. -/
theorem endpoint_fixed (P : PartialSimplexStraightening n z S F hS N)
    (d : ℕ) (s : {s // s ∈ S d}) (hs : s.val ∈ F d) : P.endpoint d s = s.val := by
  ext x
  exact P.stationary d s hs x 1

end PartialSimplexStraightening

/-- The finite face-closed fixed family generated by one spherical simplex
and the constant top simplex. -/
def sphericalStraighteningFixedFamily {n : ℕ} {z : Z} (f₀ : SphericalSimplex Z z n) :
    FiniteSimplexFamily Z :=
  (finiteVertexRestrictionClosure {f₀.val}).union
    (finiteVertexRestrictionClosure {ContinuousMap.const (StdSimplex ℝ (Fin (n + 2))) z})

/-- The actual finite support and all fixed maps share one face-closed family. -/
def sphericalStraighteningFamily {n : ℕ} {z : Z} (f₀ : SphericalSimplex Z z n)
    (b : Finset C(StdSimplex ℝ (Fin (n + 2)), Z)) : FiniteSimplexFamily Z :=
  (finiteVertexRestrictionClosure b).union (sphericalStraighteningFixedFamily f₀)

/-- All chosen fixed maps are face closed, with actual equal faces identified. -/
theorem sphericalStraighteningFixedFamily_faceClosed {n : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) : (sphericalStraighteningFixedFamily f₀).FaceClosed :=
  FiniteSimplexFamily.faceClosed_union (finiteVertexRestrictionClosure_faceClosed _)
    (finiteVertexRestrictionClosure_faceClosed _)

/-- The full relative support is face closed. -/
theorem sphericalStraighteningFamily_faceClosed {n : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) (b : Finset C(StdSimplex ℝ (Fin (n + 2)), Z)) :
    (sphericalStraighteningFamily f₀ b).FaceClosed :=
  FiniteSimplexFamily.faceClosed_union (finiteVertexRestrictionClosure_faceClosed b)
    (sphericalStraighteningFixedFamily_faceClosed f₀)

/-- Every selected low-dimensional map is constant, derived from genuine
sphericity rather than imposed as a straightening certificate. -/
theorem sphericalStraighteningFixedFamily_eq_const {n d : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) (hd : d < n)
    {τ : C(StdSimplex ℝ (Fin (d + 1)), Z)} (hτ : τ ∈ sphericalStraighteningFixedFamily f₀ d) :
    τ = ContinuousMap.const _ z := by
  classical
  rcases Finset.mem_union.mp hτ with hτ | hτ
  · exact f₀.finiteVertexRestrictionClosure_eq_const hd hτ
  · obtain ⟨_, ρ, hρ, α, rfl⟩ := (mem_finiteVertexRestrictionClosure _ τ).mp hτ
    have hρeq := Finset.mem_singleton.mp hρ
    subst ρ
    rfl

/-- Every original support map is retained literally. -/
theorem mem_sphericalStraighteningFamily_support {n : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) (b : Finset C(StdSimplex ℝ (Fin (n + 2)), Z))
    {τ : C(StdSimplex ℝ (Fin (n + 2)), Z)} (hτ : τ ∈ b) :
    τ ∈ sphericalStraighteningFamily f₀ b (n + 1) := by
  classical
  exact Finset.mem_union.mpr (Or.inl (mem_finiteVertexRestrictionClosure_self b hτ))

/-- The selected spherical input itself belongs to the stationary fixed family. -/
theorem mem_sphericalStraighteningFixedFamily_input {n : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) : f₀.val ∈ sphericalStraighteningFixedFamily f₀ n := by
  classical
  exact Finset.mem_union.mpr
    (Or.inl (mem_finiteVertexRestrictionClosure_self _ (Finset.mem_singleton_self _)))

/-- All constant simplices through the top dimension are explicitly fixed. -/
theorem mem_sphericalStraighteningFixedFamily_const {n d : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) (hd : d ≤ n + 1) :
    ContinuousMap.const (StdSimplex ℝ (Fin (d + 1))) z ∈
      sphericalStraighteningFixedFamily f₀ d := by
  classical
  apply Finset.mem_union.mpr
  apply Or.inr
  rw [mem_finiteVertexRestrictionClosure]
  exact ⟨hd, _, Finset.mem_singleton_self _, fun _ ↦ 0, rfl⟩

/-- The full selected family is contained in the actual family to be straightened. -/
theorem sphericalStraighteningFixedFamily_subset {n : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) (b : Finset C(StdSimplex ℝ (Fin (n + 2)), Z)) (d : ℕ) :
    sphericalStraighteningFixedFamily f₀ d ⊆ sphericalStraighteningFamily f₀ b d := by
  classical
  exact Finset.subset_union_right

/-- The relative family has no maps above degree `n + 1`. -/
theorem sphericalStraighteningFamily_bounded {n : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) (b : Finset C(StdSimplex ℝ (Fin (n + 2)), Z)) :
    (sphericalStraighteningFamily f₀ b).Bounded (n + 1) := by
  apply FiniteSimplexFamily.bounded_union (finiteVertexRestrictionClosure_bounded b)
  apply FiniteSimplexFamily.bounded_union _ (finiteVertexRestrictionClosure_bounded _)
  intro d hd
  exact finiteVertexRestrictionClosure_bounded {f₀.val} d (by omega)

/-- Full finite relative face-compatible straightening through degree `n + 1`,
fixing the input spherical simplex and every one of its faces for all time. -/
theorem exists_relative_spherical_straightening [PathConnectedSpace Z]
    (n : ℕ) (z : Z) (f₀ : SphericalSimplex Z z n)
    (b : Finset C(StdSimplex ℝ (Fin (n + 2)), Z))
    (hs : ∀ x : Z, ∀ k : ℕ, 0 < k → k < n → Subsingleton (HomotopyGroup.Pi k Z x)) :
    Nonempty (PartialSimplexStraightening n z (sphericalStraighteningFamily f₀ b)
      (sphericalStraighteningFixedFamily f₀) (sphericalStraighteningFamily_faceClosed f₀ b)
      (n + 2)) := by
  apply exists_finite_simplex_straightening_of_pathConnected n (n + 2) z _ _
    (sphericalStraighteningFamily_faceClosed f₀ b)
    (sphericalStraighteningFixedFamily_faceClosed f₀) hs
  intro d s hsF hd
  exact sphericalStraighteningFixedFamily_eq_const f₀ hd hsF

end Quillen
