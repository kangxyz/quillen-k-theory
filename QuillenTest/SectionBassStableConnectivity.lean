module

public import Quillen.AlgebraicGeometry.PerfectComplexes.Affine.SectionBassStableConnectivity
public import Quillen.AlgebraicGeometry.PerfectComplexes.Affine.SectionBassSquareExcision
public import Quillen.AlgebraicGeometry.PerfectComplexes.Affine.SectionBassTransition

/-!
# Original finite-stage bottom-degree consumers

The original seed, coefficient maps, polynomial chart inclusions and signed cone boundary keep
their literal values and indices. No transition-stabilization assertion is used.
-/
@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
open CategoryTheory AlgebraicGeometry
open Quillen Quillen.PerfectComplexes Quillen.LoopPrespectrum Quillen.PolynomialBaseChange
universe u
namespace QuillenTest.SectionBassStableConnectivity

open Quillen

/-- The original square-comparison image at each bottom degree is generated by its two charts. -/
theorem original_bottom_chart_image (i : ℕ) (R : CommRingCat.{u})
    (z : stableHomotopyGroup (StrictSquare.span
      ((boundedFlatAffineSectionBassDiagram i).mapArrow.mapArrow.obj (laurentSquare R)))
        (-(i : ℤ))) :
    ∃ x : stableHomotopyGroup
      ((boundedFlatAffineSectionBassDiagram i).obj (.of (Polynomial R))) (-(i : ℤ)),
    ∃ y : stableHomotopyGroup
      ((boundedFlatAffineSectionBassDiagram i).obj (.of (Polynomial R))) (-(i : ℤ)),
      (stableHomotopyFunctor (-(i : ℤ))).map (StrictSquare.comparison
        ((boundedFlatAffineSectionBassDiagram i).mapArrow.mapArrow.obj (laurentSquare R))) z =
      (stableHomotopyFunctor (-(i : ℤ))).map
        ((boundedFlatAffineSectionBassDiagram i).map (CommRingCat.ofHom Polynomial.toLaurent)) x +
      (stableHomotopyFunctor (-(i : ℤ))).map ((boundedFlatAffineSectionBassDiagram i).map
        (CommRingCat.ofHom (LaurentPolynomial.invert.toRingHom.comp Polynomial.toLaurent))) y := by
  obtain ⟨x, y, h⟩ := boundedFlatAffineSectionBassSpan_bottom_generate i R z
  refine ⟨x, y, ?_⟩
  have he := congrArg ((stableHomotopyFunctor (-(i : ℤ))).map (StrictSquare.comparison
    ((boundedFlatAffineSectionBassDiagram i).mapArrow.mapArrow.obj (laurentSquare R)))) h
  have hl : HomotopyPushout.inl
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R)) ≫
      StrictSquare.comparison
        ((boundedFlatAffineSectionBassDiagram i).mapArrow.mapArrow.obj (laurentSquare R)) =
      (boundedFlatAffineSectionBassDiagram i).map
        (CommRingCat.ofHom Polynomial.toLaurent) := by
    apply Hom.ext
    funext n
    ext p
    rfl
  have hr : HomotopyPushout.inr
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R)) ≫
      StrictSquare.comparison
        ((boundedFlatAffineSectionBassDiagram i).mapArrow.mapArrow.obj (laurentSquare R)) =
      (boundedFlatAffineSectionBassDiagram i).map
        (CommRingCat.ofHom (LaurentPolynomial.invert.toRingHom.comp Polynomial.toLaurent)) := by
    apply Hom.ext
    funext n
    ext p
    rfl
  have hls := ConcreteCategory.congr_hom
    (congrArg (fun m => (stableHomotopyFunctor (-(i : ℤ))).map m) hl) x
  have hrs := ConcreteCategory.congr_hom
    (congrArg (fun m => (stableHomotopyFunctor (-(i : ℤ))).map m) hr) y
  simp only [Functor.map_comp, ConcreteCategory.comp_apply] at hls hrs
  exact he.symm.trans ((map_add _ _ _).trans (congrArg₂ (· + ·) hls hrs))

/-- The actual iterated seed has zero image in the newly available successor bottom degree. -/
theorem original_successor_bottom_seed_image_zero (i : ℕ) (R : CommRingCat.{u})
    (x : stableHomotopyGroup ((boundedFlatAffineSectionBassDiagram i).obj R) (-(i : ℤ) - 1)) :
    (stableHomotopyFunctor (-(i : ℤ) - 1)).map
      ((boundedFlatAffineSectionBassTransition i).app R) x = 0 := by
  rw [(boundedFlatAffineSectionBassDiagram_stable_subsingleton_of_lt
    i R (-(i : ℤ) - 1) (by omega)).elim x 0, map_zero]

/-- The genuine original signed cone boundary into the preceding span degree vanishes. -/
theorem original_bottom_cone_boundary_zero (i : ℕ) (R : CommRingCat.{u})
    (z : stableHomotopyGroup (mappingCone (StrictSquare.comparison
      ((boundedFlatAffineSectionBassDiagram i).mapArrow.mapArrow.obj (laurentSquare R))))
        (-(i : ℤ) - 1 + 1)) :
    stableMappingConeConnecting (StrictSquare.comparison
      ((boundedFlatAffineSectionBassDiagram i).mapArrow.mapArrow.obj (laurentSquare R)))
      (boundedFlatAffineSectionBass_square_coneFiber_isStableEquivalence i (laurentSquare R))
      (-(i : ℤ) - 1) z = 0 :=
  (boundedFlatAffineSectionBassSpan_stable_subsingleton_of_lt
    i R (-(i : ℤ) - 1) (by omega)).elim _ _

/-- Original coefficient maps retain the vanished classes below the stage's actual offset. -/
theorem original_coefficient_below_bottom (i : ℕ) {R S : CommRingCat.{u}} (f : R ⟶ S)
    (d : ℤ) (hd : d < -(i : ℤ))
    (x : stableHomotopyGroup ((boundedFlatAffineSectionBassDiagram i).obj R) d) :
    (stableHomotopyFunctor d).map ((boundedFlatAffineSectionBassDiagram i).map f) x = 0 :=
  (boundedFlatAffineSectionBassDiagram_stable_subsingleton_of_lt i S d hd).elim _ _

/-- The actual bottom-degree left chart is preserved by the original right-cone collapse. -/
theorem original_bottom_inclusion_collapse (i : ℕ) (R : CommRingCat.{u})
    (x : stableHomotopyGroup
      ((boundedFlatAffineSectionBassDiagram i).obj (.of (Polynomial R))) (-(i : ℤ))) :
    (stableHomotopyFunctor (-(i : ℤ))).map (HomotopyPushout.rightConeCollapse
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R)))
      ((stableHomotopyFunctor (-(i : ℤ))).map (mappingConeInclusion (HomotopyPushout.inr
        ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))
        ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))))
        ((stableHomotopyFunctor (-(i : ℤ))).map (HomotopyPushout.inl
          ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))
          ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))) x)) =
    (stableHomotopyFunctor (-(i : ℤ))).map (mappingConeInclusion
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))) x := by
  have h := ConcreteCategory.congr_hom
    (congrArg (fun k => (stableHomotopyFunctor (-(i : ℤ))).map k)
    (HomotopyPushout.inl_coneInclusion_rightConeCollapse
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R))
      ((boundedFlatAffineSectionBassDiagram i).map (coefficient R)))) x
  simpa only [Functor.map_comp, ConcreteCategory.comp_apply] using h

/-- The literal signed-stage inclusion sends every below-bound representative to zero. -/
theorem original_stable_stage_inclusion_zero (i : ℕ) (R : CommRingCat.{u})
    (d : ℤ) (hd : d < -(i : ℤ)) (n : ℕ)
    (x : (stableSystem ((boundedFlatAffineSectionBassDiagram i).obj R) d).obj n) :
    stableHomotopyι ((boundedFlatAffineSectionBassDiagram i).obj R) d n x = 0 :=
  (boundedFlatAffineSectionBassDiagram_stable_subsingleton_of_lt i R d hd).elim _ _

end QuillenTest.SectionBassStableConnectivity
