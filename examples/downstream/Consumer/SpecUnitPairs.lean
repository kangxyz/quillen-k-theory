module

public import Quillen.KTheory.LowDegreeScalarAction.SpecUnitPairs
public import Mathlib.RingTheory.Polynomial.Quotient
public import Mathlib.Algebra.Field.ZMod

/-!
# Actual affine-line-origin scheme K2 unit pairs

These clients construct the residue sections over Q, F2 and F3 and retain the
original KToG/affine image of the genuine positive scalar-cube pair.
-/
@[expose] public section

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
universe u
open CategoryTheory CategoryTheory.ExactCategory Polynomial AlgebraicGeometry
open Quillen.LowDegreeScalarAction

namespace DvrProjectiveClients

/-- The literal rational origin used to instantiate the split-residue local endpoint. -/
def origin (F : Type u) [Field F] : IsDedekindDomain.HeightOneSpectrum F[X] where
  asIdeal := Ideal.span {X - C (0 : F)}
  isPrime := Ideal.IsMaximal.isPrime
    (PrincipalIdealRing.isMaximal_of_irreducible (irreducible_X_sub_C 0))
  ne_bot := by simp

/-- The original local-ring residue field is canonically the coefficient field. -/
def originResidueEquiv (F : Type u) [Field F] : F ≃+* (origin F).asIdeal.ResidueField :=
  (quotientSpanXSubCAlgEquiv (0 : F)).toRingEquiv.symm.trans
    (IsLocalization.AtPrime.equivQuotMaximalIdeal (origin F).asIdeal
      (Localization.AtPrime (origin F).asIdeal))

/-- The actual coefficient map supplies a ring section of the original local residue. -/
def originSection (F : Type u) [Field F] :
    (origin F).asIdeal.ResidueField →+* Localization.AtPrime (origin F).asIdeal :=
  (algebraMap F (Localization.AtPrime (origin F).asIdeal)).comp
    (originResidueEquiv F).symm.toRingHom

/-- The genuine original residue map retracts this explicit coefficient section. -/
theorem originSection_splits (F : Type u) [Field F] :
    (IsLocalRing.residue (Localization.AtPrime (origin F).asIdeal)).comp
        (originSection F) = RingHom.id (origin F).asIdeal.ResidueField := by
  apply RingHom.ext
  intro x
  obtain ⟨a, rfl⟩ := (originResidueEquiv F).surjective x
  change IsLocalRing.residue (Localization.AtPrime (origin F).asIdeal)
    (algebraMap F (Localization.AtPrime (origin F).asIdeal)
      ((originResidueEquiv F).symm ((originResidueEquiv F) a))) = originResidueEquiv F a
  rw [RingEquiv.symm_apply_apply]
  rfl


/-- Characteristic-zero original scheme K2 of the origin trait is generated by actual unit pairs. -/
theorem rationalOrigin_unitPairSpan :
    SpecUnitPairs.unitPairSpan
      (CommRingCat.of (Localization.AtPrime (origin ℚ).asIdeal)) = ⊤ :=
  SpecUnitPairs.unitPairSpan_eq_top_of_residueSection ℚ[X] (origin ℚ)
    (originSection ℚ) (originSection_splits ℚ)

/-- The actual K-to-G/affine map retains both literal unit inputs over the rational origin. -/
theorem rationalOrigin_unitPair_value
    (a b : (Localization.AtPrime (origin ℚ).asIdeal)ˣ) :
    SpecUnitPairs.kToLowerG (CommRingCat.of (Localization.AtPrime (origin ℚ).asIdeal)) 2
        (SpecUnitPairs.unitPair (CommRingCat.of (Localization.AtPrime (origin ℚ).asIdeal)) a b) =
      DvrSymbols.loweredUnitProduct (Localization.AtPrime (origin ℚ).asIdeal) a b :=
  SpecUnitPairs.kToLowerG_unitPair.{0}
    (CommRingCat.of (Localization.AtPrime (origin ℚ).asIdeal)) a b

example : SpecUnitPairs.unitPairSpan
    (CommRingCat.of (Localization.AtPrime (origin (ZMod 2)).asIdeal)) = ⊤ :=
  SpecUnitPairs.unitPairSpan_eq_top_of_residueSection (ZMod 2)[X] (origin _)
    (originSection _) (originSection_splits _)

example : SpecUnitPairs.unitPairSpan
    (CommRingCat.of (Localization.AtPrime (origin (ZMod 3)).asIdeal)) = ⊤ :=
  SpecUnitPairs.unitPairSpan_eq_top_of_residueSection (ZMod 3)[X] (origin _)
    (originSection _) (originSection_splits _)

end DvrProjectiveClients
