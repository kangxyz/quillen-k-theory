module

public import Quillen.GTheory.DVR.UnitPairGeneration
public import Mathlib.RingTheory.Polynomial.Quotient
public import Mathlib.Algebra.Field.ZMod

/-!
# The actual affine-line origin and original DVR boundary

The coefficient section is constructed over every field. Rational and smallest-field
consumers retain the original lower G2 unit span and the actual uniform residue.
-/
@[expose] public section

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
universe u
open CategoryTheory CategoryTheory.ExactCategory Polynomial
open Quillen.FiniteModuleLocalization Quillen.LowDegreeScalarAction

namespace Consumer.MilnorDvrBoundary

/-- The literal rational point at zero of the affine line over a field. -/
def origin (F : Type u) [Field F] : IsDedekindDomain.HeightOneSpectrum F[X] where
  asIdeal := Ideal.span {X - C (0 : F)}
  isPrime := Ideal.IsMaximal.isPrime
    (PrincipalIdealRing.isMaximal_of_irreducible (irreducible_X_sub_C 0))
  ne_bot := by simp

/-- The original local-ring residue field is canonically the coefficient field. -/
def originResidueEquiv (F : Type u) [Field F] : F ≃+* (origin F).asIdeal.ResidueField :=
  (quotientSpanXSubCAlgEquiv (0 : F)).toRingEquiv.symm.trans
    (IsLocalization.AtPrime.equivQuotMaximalIdeal (origin F).asIdeal
      (Localization.AtPrime (origin F).asIdeal))

/-- The actual coefficient map supplies a ring section of the original local residue. -/
def originSection (F : Type u) [Field F] :
    (origin F).asIdeal.ResidueField →+* Localization.AtPrime (origin F).asIdeal :=
  (algebraMap F (Localization.AtPrime (origin F).asIdeal)).comp
    (originResidueEquiv F).symm.toRingHom

/-- The genuine original residue map retracts this explicit coefficient section. -/
theorem originSection_splits (F : Type u) [Field F] :
    (IsLocalRing.residue (Localization.AtPrime (origin F).asIdeal)).comp
        (originSection F) = RingHom.id (origin F).asIdeal.ResidueField := by
  apply RingHom.ext
  intro x
  obtain ⟨a, rfl⟩ := (originResidueEquiv F).surjective x
  change IsLocalRing.residue (Localization.AtPrime (origin F).asIdeal)
    (algebraMap F (Localization.AtPrime (origin F).asIdeal)
      ((originResidueEquiv F).symm ((originResidueEquiv F) a))) = originResidueEquiv F a
  rw [RingEquiv.symm_apply_apply]
  rfl

local instance rationalOriginDvr :
    IsDiscreteValuationRing (Localization.AtPrime (origin ℚ).asIdeal) :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ℚ[X]
    (origin ℚ).ne_bot _

/-- The original rational-origin boundary equals the supplied uniform Milnor residue. -/
theorem rationalOrigin_uniformResidue
    (m : MilnorK.K (FractionRing (Localization.AtPrime (origin ℚ).asIdeal)) 2) :
    Additive.ofMul (MilnorDvrBoundary.localBoundaryDet ℚ[X] (origin ℚ)
      (MilnorDvrBoundary.milnorToLowerModuleKTwo
        (FractionRing (Localization.AtPrime (origin ℚ).asIdeal)) m).toMul) =
      MilnorK.oneEquiv (origin ℚ).asIdeal.ResidueField
        (MilnorK.DVR.residue (Localization.AtPrime (origin ℚ).asIdeal)
          (FractionRing (Localization.AtPrime (origin ℚ).asIdeal)) 1 m) := by
  rw [MilnorK.DVR.oneEquiv_residue_one]
  have h := MilnorDvrBoundary.localDvrBoundary_milnor_det ℚ[X] (origin ℚ)
    (IsDiscreteValuationRing.exists_irreducible
      (Localization.AtPrime (origin ℚ).asIdeal)).choose_spec m
  apply Additive.toMul.injective
  rw [toMul_ofMul]
  dsimp only [MilnorK.K2.DVR.chosenData, MilnorK.K2.tameValue] at h ⊢
  rw [h]

/-- Actual lower G2 of the characteristic-zero origin DVR is generated by its unit pairs. -/
theorem rationalOrigin_unitPairSpan :
    Quillen.DvrUnitPairGeneration.unitPairSpan
      (Localization.AtPrime (origin ℚ).asIdeal) = ⊤ :=
  Quillen.DvrUnitPairGeneration.unitPairSpan_eq_top_of_residueSection ℚ[X] (origin ℚ)
    (originSection ℚ) (originSection_splits ℚ)

example : Quillen.DvrUnitPairGeneration.unitPairSpan
    (Localization.AtPrime (origin (ZMod 2)).asIdeal) = ⊤ :=
  Quillen.DvrUnitPairGeneration.unitPairSpan_eq_top_of_residueSection (ZMod 2)[X] (origin _)
    (originSection _) (originSection_splits _)

example : Quillen.DvrUnitPairGeneration.unitPairSpan
    (Localization.AtPrime (origin (ZMod 3)).asIdeal) = ⊤ :=
  Quillen.DvrUnitPairGeneration.unitPairSpan_eq_top_of_residueSection (ZMod 3)[X] (origin _)
    (originSection _) (originSection_splits _)

end Consumer.MilnorDvrBoundary
